@model BidNest.ViewModels.EditProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 mb-4 animate__animated animate__fadeIn">
                <div class="card-header bg-gradient-primary text-white text-center py-4 rounded-top">
                    <i class="fas fa-user-edit fa-3x mb-2"></i>
                    <h2 class="mb-0 fw-bold">Edit Your Profile</h2>
                    <p class="mb-0 text-white-50">Manage your personal information and preferences.</p>
                </div>
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                            <i class="fas fa-check-circle fa-lg me-3"></i>
                            <div>@TempData["SuccessMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                            <i class="fas fa-exclamation-triangle fa-lg me-3"></i>
                            <div>@TempData["ErrorMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="EditProfile" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <h5 class="mb-3 text-primary"><i class="fas fa-id-card me-2"></i>Personal Information</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label">Full Name</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                                    <input asp-for="FullName" class="form-control" placeholder="Your full name" />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Username" class="form-label">Username</label>
                                <div class="input-group">
                                    <span class="input-group-text">@@</span>
                                    <input asp-for="Username" class="form-control bg-light" readonly />
                                </div>
                                <small class="text-muted mt-1 d-block">Username cannot be changed.</small>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Email" type="email" class="form-control" placeholder="your.email@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PhoneNumber" class="form-label">Phone Number (Optional)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-phone-alt"></i></span>
                                <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="+1 (555) 123-4567" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger mt-1 d-block"></span>
                        </div>

                        <h5 class="mb-3 mt-5 text-primary"><i class="fas fa-map-marker-alt me-2"></i>Address Information</h5>
                        <div class="mb-4">
                            <label asp-for="Address" class="form-label">Street Address (Optional)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-road"></i></span>
                                <textarea asp-for="Address" class="form-control" rows="2" placeholder="123 Main St, Apt 4B"></textarea>
                            </div>
                            <span asp-validation-for="Address" class="text-danger mt-1 d-block"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label">City (Optional)</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-city"></i></span>
                                    <input asp-for="City" class="form-control" placeholder="New York" />
                                </div>
                                <span asp-validation-for="City" class="text-danger mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Country" class="form-label">Country (Optional)</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-globe"></i></span>
                                    <input asp-for="Country" class="form-control" placeholder="USA" />
                                </div>
                                <span asp-validation-for="Country" class="text-danger mt-1 d-block"></span>
                            </div>
                        </div>

                        <h5 class="mb-3 mt-5 text-primary"><i class="fas fa-feather-alt me-2"></i>About You</h5>
                        <div class="mb-4">
                            <label asp-for="Bio" class="form-label">Bio (Optional)</label>
                            <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Share a little about yourself, your interests, or what you're looking for..."></textarea>
                            <span asp-validation-for="Bio" class="text-danger mt-1 d-block"></span>
                            <small class="text-muted mt-1 d-block">Maximum 500 characters.</small>
                        </div>

                        <hr class="my-5">

                        <div class="d-flex justify-content-end gap-3">
                            <a href="@Url.Action("Profile", "Account")" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Security Settings Section -->
            <div class="card shadow-lg border-0 mt-5 animate__animated animate__fadeInUp">
                <div class="card-header bg-dark text-white text-center py-4 rounded-top">
                    <i class="fas fa-shield-alt fa-3x mb-2"></i>
                    <h2 class="mb-0 fw-bold">Security Settings</h2>
                    <p class="mb-0 text-white-50">Manage your account's security features.</p>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded h-100 d-flex flex-column justify-content-between">
                                <h6 class="text-primary"><i class="fas fa-key me-2"></i>Password</h6>
                                <p class="text-muted small mb-3">Keep your account secure by regularly updating your password.</p>
                                <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-outline-primary btn-sm rounded-pill mt-auto">
                                    <i class="fas fa-unlock-alt me-2"></i>Change Password
                                </a>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded h-100 d-flex flex-column justify-content-between">
                                <h6 class="text-primary"><i class="fas fa-shield-check me-2"></i>Two-Factor Authentication</h6>
                                <p class="text-muted small mb-3">Add an extra layer of security. (Coming Soon!)</p>
                                <button class="btn btn-outline-secondary btn-sm rounded-pill mt-auto" disabled>
                                    <i class="fas fa-mobile-alt me-2"></i>Enable 2FA
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

             <!-- Delete Account Option (Optional, but good for completeness) -->
            <div class="card shadow-lg border-0 mt-4 bg-light-danger animate__animated animate__fadeInUp">
                <div class="card-body p-4 text-center">
                    <h5 class="text-danger mb-3"><i class="fas fa-exclamation-triangle me-2"></i>Danger Zone</h5>
                    <p class="text-muted">If you no longer wish to use BidNest, you can delete your account. This action is irreversible.</p>
                    <button class="btn btn-danger btn-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
                        <i class="fas fa-trash-alt me-2"></i>Delete Account
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Confirm Delete Account Modal -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="confirmDeleteModalLabel"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Account Deletion</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Are you absolutely sure you want to delete your account? This action cannot be undone. All your bids, watchlist items, and profile data will be permanently removed.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger">Delete My Account</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
}

@section Styles {
    <style>
        body {
            background-color: #f0f2f5; /* Lighter, subtle background */
        }
        .container {
            max-width: 900px;
        }
        .card {
            border-radius: 1rem; /* More rounded corners */
            overflow: hidden;
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.08); /* Stronger shadow */
        }
        .card-header.bg-gradient-primary {
            background: linear-gradient(135deg, #007bff 0%, #0056b3 100%); /* Gradient header */
            color: white;
            padding-top: 2.5rem;
            padding-bottom: 2.5rem;
        }
        .card-header.bg-gradient-primary h2 {
            font-size: 2.2rem;
        }
        .card-header.bg-dark {
            background: linear-gradient(135deg, #343a40 0%, #212529 100%); /* Darker gradient for security */
        }
        .form-label {
            font-weight: 600;
            color: #344767; /* Stronger label color */
            margin-bottom: 0.5rem;
        }
        .input-group-text {
            background-color: #e9ecef;
            border-color: #ced4da;
            color: #495057;
        }
        .form-control:focus {
            border-color: #80bdff;
            box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.25);
        }
        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
            transition: all 0.2s ease;
        }
        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #0056b3;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 123, 255, 0.3);
        }
        .btn-outline-secondary {
            color: #6c757d;
            border-color: #6c757d;
        }
        .btn-outline-secondary:hover {
            background-color: #6c757d;
            color: white;
        }
        .alert-success {
            background-color: #d4edda;
            color: #155724;
            border-color: #c3e6cb;
        }
        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
            border-color: #f5c6cb;
        }
        .alert .btn-close {
            filter: invert(0.5); /* Make close button visible on colored alerts */
        }
        .bg-light-danger { /* For the danger zone card */
            background-color: #fff0f0;
            border: 1px solid #f0cccc;
        }
        .text-danger {
            color: #dc3545 !important;
        }
        hr {
            border-top: 1px dashed #e0e0e0; /* Dashed separator */
        }
        .modal-header.bg-danger {
            background-color: #dc3545 !important;
            border-bottom: none;
        }
        .btn-close-white {
            filter: brightness(0) invert(1);
        }
    </style>
}