@model IEnumerable<BidNest.Models.ContactMessage>
@{
    ViewData["Title"] = "My Messages";
}

<div class="luxury-messages-container py-5">
    <div class="row mb-5">
        <div class="col">
            <div class="luxury-header-content">
                <h2 class="luxury-title mb-2">
                    <i class="fas fa-envelope me-3"></i>My Contact Messages
                </h2>
                <p class="luxury-subtitle mb-0">View your contact history and admin responses</p>
            </div>
        </div>
        <div class="col-auto">
            <a href="@Url.Action("Contact", "Home")" class="luxury-btn luxury-btn-primary">
                <i class="fas fa-plus me-2"></i>New Message
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var message in Model)
            {
                <div class="col-12 mb-4">
                    <div class="luxury-message-card">
                        <div class="luxury-message-header luxury-status-@(message.Status.ToLower())">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h5 class="luxury-message-title mb-0">
                                        <i class="fas fa-tag me-2"></i>@message.Subject
                                    </h5>
                                </div>
                                <div class="col-auto">
                                    <span class="luxury-status-badge luxury-status-@(message.Status.ToLower())">
                                        @message.Status
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="luxury-message-body">
                            <!-- User's Original Message -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h6 class="luxury-message-label">
                                        <i class="fas fa-user me-2"></i>Your Message
                                    </h6>
                                    <small class="luxury-timestamp">
                                        <i class="fas fa-clock me-1"></i>@message.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                    </small>
                                </div>
                                <div class="luxury-user-message">
                                    <p class="mb-0" style="white-space: pre-wrap;">@message.Message</p>
                                </div>
                            </div>

                            <!-- Admin's Reply (if exists) -->
                            @if (!string.IsNullOrEmpty(message.AdminReply))
                            {
                                <div class="mt-4">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <h6 class="luxury-admin-label">
                                            <i class="fas fa-reply me-2"></i>Admin Response
                                        </h6>
                                        @if (message.RepliedAt.HasValue)
                                        {
                                            <small class="luxury-timestamp">
                                                <i class="fas fa-clock me-1"></i>@message.RepliedAt.Value.ToString("MMM dd, yyyy HH:mm")
                                            </small>
                                        }
                                    </div>
                                    <div class="luxury-admin-reply">
                                        <p class="mb-0" style="white-space: pre-wrap;">@message.AdminReply</p>
                                        @if (message.RepliedByUser != null)
                                        {
                                            <small class="luxury-admin-signature mt-2 d-block">
                                                <i class="fas fa-user-shield me-1"></i>Replied by: @message.RepliedByUser.FullName
                                            </small>
                                        }
                                    </div>
                                </div>
                            }
                            else if (message.Status == "Read")
                            {
                                <div class="luxury-alert luxury-alert-info mt-3">
                                    <i class="fas fa-info-circle me-2"></i>Your message has been read by our support team. You will receive a response soon.
                                </div>
                            }
                            else if (message.Status == "New")
                            {
                                <div class="luxury-alert luxury-alert-warning mt-3">
                                    <i class="fas fa-hourglass-half me-2"></i>Your message is pending review by our support team.
                                </div>
                            }
                        </div>
                        <div class="luxury-message-footer">
                            <div class="row align-items-center">
                                <div class="col">
                                    @if (message.NewsletterSubscription)
                                    {
                                        <span class="luxury-newsletter-badge">
                                            <i class="fas fa-newspaper me-1"></i>Newsletter Subscriber
                                        </span>
                                    }
                                </div>
                                <div class="col-auto">
                                    <small class="luxury-message-id">Message ID: #@message.MessageId</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="luxury-empty-state">
            <div class="luxury-empty-icon mb-4">
                <i class="fas fa-inbox fa-4x"></i>
            </div>
            <h4 class="luxury-empty-title mb-3">No Messages Yet</h4>
            <p class="luxury-empty-text mb-4">You haven't sent any contact messages yet. If you need help or have questions, feel free to contact us!</p>
            <a href="@Url.Action("Contact", "Home")" class="luxury-btn luxury-btn-primary luxury-btn-lg">
                <i class="fas fa-envelope me-2"></i>Send Your First Message
            </a>
        </div>
    }
</div>

@section Styles {
    <style>
        /* Luxury Color Palette Variables */
        :root {
            --walnut-brown: #5C4033;
            --golden-oak: #C19A6B;
            --royal-gold: #D4AF37;
            --steel-mist: #A2B0BF;
            --matte-charcoal: #2B2B2B;
            --luxury-black: #000000;
        }

        /* Base Container */
        .luxury-messages-container {
            background: var(--luxury-black);
            color: var(--steel-mist);
            min-height: 100vh;
            padding: 0 15px;
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Header Styles */
        .luxury-header-content {
            position: relative;
        }

        .luxury-title {
            color: var(--royal-gold);
            font-size: 2.5rem;
            font-weight: 700;
            text-shadow: 0 2px 4px rgba(212, 175, 55, 0.3);
            letter-spacing: -0.5px;
        }

        .luxury-subtitle {
            color: var(--golden-oak);
            font-size: 1.1rem;
            font-weight: 400;
            opacity: 0.9;
        }

        /* Message Card Styles */
        .luxury-message-card {
            background: linear-gradient(145deg, var(--matte-charcoal), #1a1a1a);
            border: 1px solid var(--walnut-brown);
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
            position: relative;
            margin-bottom: 1.5rem;
        }

        .luxury-message-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--royal-gold), var(--golden-oak), var(--royal-gold));
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .luxury-message-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 50px rgba(212, 175, 55, 0.2);
            border-color: var(--royal-gold);
        }

        .luxury-message-card:hover::before {
            opacity: 1;
        }

        /* Message Header */
        .luxury-message-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--walnut-brown);
        }

        .luxury-status-replied {
            background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        }

        .luxury-status-new {
            background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
        }

        .luxury-status-read {
            background: linear-gradient(135deg, var(--walnut-brown), var(--matte-charcoal));
        }

        .luxury-message-title {
            color: var(--luxury-black);
            font-weight: 700;
            font-size: 1.2rem;
        }

        .luxury-status-badge {
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .luxury-status-badge.luxury-status-replied {
            background: var(--luxury-black);
            color: var(--royal-gold);
            border: 1px solid var(--royal-gold);
        }

        .luxury-status-badge.luxury-status-new {
            background: var(--luxury-black);
            color: var(--golden-oak);
            border: 1px solid var(--golden-oak);
        }

        .luxury-status-badge.luxury-status-read {
            background: var(--luxury-black);
            color: var(--steel-mist);
            border: 1px solid var(--steel-mist);
        }

        /* Message Body */
        .luxury-message-body {
            padding: 24px;
        }

        .luxury-message-label {
            color: var(--golden-oak);
            font-weight: 600;
            font-size: 1rem;
            margin-bottom: 0;
        }

        .luxury-admin-label {
            color: var(--royal-gold);
            font-weight: 600;
            font-size: 1rem;
            margin-bottom: 0;
        }

        .luxury-timestamp {
            color: var(--steel-mist);
            font-size: 0.9rem;
            opacity: 0.8;
        }

        .luxury-user-message {
            background: linear-gradient(135deg, var(--matte-charcoal), #1a1a1a);
            border: 1px solid var(--walnut-brown);
            border-radius: 12px;
            padding: 20px;
            color: var(--steel-mist);
            line-height: 1.6;
        }

        .luxury-admin-reply {
            background: linear-gradient(135deg, var(--walnut-brown), var(--matte-charcoal));
            border: 2px solid var(--royal-gold);
            border-radius: 12px;
            padding: 20px;
            color: var(--steel-mist);
            line-height: 1.6;
            position: relative;
        }

        .luxury-admin-reply::before {
            content: '';
            position: absolute;
            top: -1px;
            left: -1px;
            right: -1px;
            bottom: -1px;
            background: linear-gradient(45deg, var(--royal-gold), var(--golden-oak));
            border-radius: 12px;
            z-index: -1;
            opacity: 0.3;
        }

        .luxury-admin-signature {
            color: var(--golden-oak);
            font-weight: 500;
        }

        /* Alert Styles */
        .luxury-alert {
            padding: 16px 20px;
            border-radius: 12px;
            font-weight: 500;
            border: 1px solid;
        }

        .luxury-alert-info {
            background: linear-gradient(135deg, rgba(162, 176, 191, 0.1), rgba(162, 176, 191, 0.05));
            color: var(--steel-mist);
            border-color: var(--steel-mist);
        }

        .luxury-alert-warning {
            background: linear-gradient(135deg, rgba(193, 154, 107, 0.1), rgba(193, 154, 107, 0.05));
            color: var(--golden-oak);
            border-color: var(--golden-oak);
        }

        /* Message Footer */
        .luxury-message-footer {
            background: linear-gradient(135deg, #1a1a1a, var(--matte-charcoal));
            padding: 16px 24px;
            border-top: 1px solid var(--walnut-brown);
        }

        .luxury-newsletter-badge {
            background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
            color: var(--luxury-black);
            padding: 4px 12px;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .luxury-message-id {
            color: var(--golden-oak);
            font-weight: 500;
        }

        /* Luxury Buttons */
        .luxury-btn {
            padding: 12px 24px;
            border-radius: 25px;
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: 2px solid;
            display: inline-flex;
            align-items: center;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .luxury-btn-primary {
            background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
            color: var(--luxury-black);
            border-color: var(--royal-gold);
        }

        .luxury-btn-primary:hover {
            background: linear-gradient(135deg, var(--golden-oak), var(--royal-gold));
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
            color: var(--luxury-black);
            text-decoration: none;
        }

        .luxury-btn-lg {
            padding: 16px 32px;
            font-size: 1.1rem;
        }

        /* Empty State */
        .luxury-empty-state {
            text-align: center;
            padding: 80px 20px;
            background: linear-gradient(145deg, var(--matte-charcoal), #1a1a1a);
            border: 1px solid var(--walnut-brown);
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
        }

        .luxury-empty-icon {
            color: var(--walnut-brown);
            opacity: 0.7;
        }

        .luxury-empty-title {
            color: var(--steel-mist);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .luxury-empty-text {
            color: var(--golden-oak);
            font-size: 1.1rem;
            max-width: 500px;
            margin: 0 auto;
            line-height: 1.6;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .luxury-title {
                font-size: 2rem;
            }
            
            .luxury-message-card {
                margin-bottom: 20px;
            }
            
            .luxury-message-body {
                padding: 20px 16px;
            }
            
            .luxury-message-header {
                padding: 16px 20px;
            }
            
            .luxury-message-footer {
                padding: 12px 20px;
            }
            
            .luxury-btn {
                padding: 10px 20px;
                font-size: 0.9rem;
            }
        }

        /* Smooth Animations */
        * {
            transition: color 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
        }
    </style>
}
