@model IEnumerable<BidNest.Models.ContactMessage>
@{
    ViewData["Title"] = "My Messages";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h2>
                <i class="fas fa-envelope me-2"></i>My Contact Messages
            </h2>
            <p class="text-muted">View your contact history and admin responses</p>
        </div>
        <div class="col-auto">
            <a href="@Url.Action("Contact", "Home")" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>New Message
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var message in Model)
            {
                <div class="col-12 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header @(message.Status == "Replied" ? "bg-success text-white" : message.Status == "New" ? "bg-warning" : "bg-primary text-white")">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h5 class="mb-0">
                                        <i class="fas fa-tag me-2"></i>@message.Subject
                                    </h5>
                                </div>
                                <div class="col-auto">
                                    <span class="badge @(message.Status == "Replied" ? "bg-light text-dark" : "bg-dark")">
                                        @message.Status
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- User's Original Message -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="text-muted">
                                        <i class="fas fa-user me-2"></i>Your Message
                                    </h6>
                                    <small class="text-muted">
                                        <i class="fas fa-clock me-1"></i>@message.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                    </small>
                                </div>
                                <div class="border rounded p-3 bg-light">
                                    <p class="mb-0" style="white-space: pre-wrap;">@message.Message</p>
                                </div>
                            </div>

                            <!-- Admin's Reply (if exists) -->
                            @if (!string.IsNullOrEmpty(message.AdminReply))
                            {
                                <div class="mt-4">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="text-success">
                                            <i class="fas fa-reply me-2"></i>Admin Response
                                        </h6>
                                        @if (message.RepliedAt.HasValue)
                                        {
                                            <small class="text-muted">
                                                <i class="fas fa-clock me-1"></i>@message.RepliedAt.Value.ToString("MMM dd, yyyy HH:mm")
                                            </small>
                                        }
                                    </div>
                                    <div class="border border-success rounded p-3 bg-success bg-opacity-10">
                                        <p class="mb-0" style="white-space: pre-wrap;">@message.AdminReply</p>
                                        @if (message.RepliedByUser != null)
                                        {
                                            <small class="text-muted mt-2 d-block">
                                                <i class="fas fa-user-shield me-1"></i>Replied by: @message.RepliedByUser.FullName
                                            </small>
                                        }
                                    </div>
                                </div>
                            }
                            else if (message.Status == "Read")
                            {
                                <div class="alert alert-info mt-3">
                                    <i class="fas fa-info-circle me-2"></i>Your message has been read by our support team. You will receive a response soon.
                                </div>
                            }
                            else if (message.Status == "New")
                            {
                                <div class="alert alert-warning mt-3">
                                    <i class="fas fa-hourglass-half me-2"></i>Your message is pending review by our support team.
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="row">
                                <div class="col">
                                    @if (message.NewsletterSubscription)
                                    {
                                        <span class="badge bg-info">
                                            <i class="fas fa-newspaper me-1"></i>Newsletter Subscriber
                                        </span>
                                    }
                                </div>
                                <div class="col-auto">
                                    <small class="text-muted">Message ID: #@message.MessageId</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4><i class="fas fa-inbox me-2"></i>No Messages Yet</h4>
            <p>You haven't sent any contact messages yet. If you need help or have questions, feel free to contact us!</p>
            <a href="@Url.Action("Contact", "Home")" class="btn btn-primary mt-2">
                <i class="fas fa-envelope me-2"></i>Send Your First Message
            </a>
        </div>
    }
</div>
