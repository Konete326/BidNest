@model BidNest.ViewModels.WatchlistViewModel
@{
    ViewData["Title"] = "My Watchlist";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h2>
                <i class="fas fa-heart text-danger me-2"></i>My Watchlist
            </h2>
            <p class="text-muted">Keep track of items you're interested in</p>
        </div>
        <div class="col-auto">
            <a href="@Url.Action("Active", "Auction")" class="btn btn-primary">
                <i class="fas fa-search me-2"></i>Browse Auctions
            </a>
        </div>
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="row">
            @foreach (var item in Model.Items)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="position-relative">
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="fas fa-image fa-3x text-muted"></i>
                            </div>
                            <button class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 remove-watchlist" 
                                    data-item-id="@item.ItemId" title="Remove from Watchlist">
                                <i class="fas fa-heart-broken"></i>
                            </button>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text text-muted small">
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    @(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                                }
                            </p>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <small class="text-muted">Current Bid</small>
                                    <h6 class="text-success mb-0">$@((item.CurrentBid ?? item.MinimumBid).ToString("N2"))</h6>
                                </div>
                                <div class="text-end">
                                    <small class="text-muted">Min Bid</small>
                                    <h6 class="mb-0">$@item.MinimumBid.ToString("N2")</h6>
                                </div>
                            </div>
                            @if (item.EndDate > DateTime.UtcNow)
                            {
                                <div class="alert alert-info py-1 px-2 mb-2">
                                    <small>
                                        <i class="fas fa-clock me-1"></i>
                                        Ends: @item.EndDate.ToString("MMM dd, yyyy HH:mm")
                                    </small>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-danger py-1 px-2 mb-2">
                                    <small>
                                        <i class="fas fa-times-circle me-1"></i>
                                        Auction Ended
                                    </small>
                                </div>
                            }
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-secondary">@item.CategoryName</span>
                                @if (item.Status == "A")
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else if (item.Status == "S")
                                {
                                    <span class="badge bg-info">Sold</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a href="@Url.Action("Details", "Auction", new { id = item.ItemId })" 
                               class="btn btn-primary btn-sm w-100">
                                <i class="fas fa-eye me-2"></i>View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Watchlist", new { page = Model.CurrentPage - 1 })">
                            Previous
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Watchlist", new { page = i })">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Watchlist", new { page = Model.CurrentPage + 1 })">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="alert alert-info">
            <h4><i class="fas fa-heart me-2"></i>Your Watchlist is Empty</h4>
            <p>You haven't added any items to your watchlist yet. Browse our auctions and click the heart icon to add items you want to track!</p>
            <a href="@Url.Action("Active", "Auction")" class="btn btn-primary mt-2">
                <i class="fas fa-search me-2"></i>Browse Active Auctions
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.remove-watchlist').click(function(e) {
                e.preventDefault();
                var button = $(this);
                var itemId = button.data('item-id');
                var card = button.closest('.col-lg-4');
                
                if (confirm('Are you sure you want to remove this item from your watchlist?')) {
                    $.post('@Url.Action("ToggleWatchlist", "Buyer")', {
                        itemId: itemId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    }).done(function(response) {
                        if (response.success) {
                            card.fadeOut(300, function() {
                                card.remove();
                                // Check if watchlist is now empty
                                if ($('.col-lg-4').length === 0) {
                                    location.reload();
                                }
                            });
                        } else {
                            alert('Error: ' + response.message);
                        }
                    }).fail(function() {
                        alert('An error occurred while removing the item from your watchlist.');
                    });
                }
            });
        });
    </script>
}
