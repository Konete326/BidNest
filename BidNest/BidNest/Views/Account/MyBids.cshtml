@model BidNest.ViewModels.UserBidsViewModel
@{
    ViewData["Title"] = "My Bids";
}

<div class="container py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h2 class="fw-bold mb-1">My Bids</h2>
                <p class="text-muted mb-0">Track all your active and past bidding activity</p>
            </div>
            <div>
                <span class="badge rounded-pill bg-primary px-3 py-2 fs-6">
                    <i class="fas fa-gavel me-1"></i>@Model.TotalBids Total Bids
                </span>
            </div>
        </div>
    </div>

    @if (Model.Bids.Any())
    {
        <!-- Bids Grid -->
        <div class="row g-4">
            @foreach (var bid in Model.Bids)
            {
                <div class="col-lg-6 col-md-12">
                    <div class="card h-100 shadow-sm border-0 bid-card">
                        <!-- Card Header -->
                        <div class="card-header bg-light d-flex justify-content-between align-items-center border-0">
                            <span class="badge @bid.StatusBadgeClass">@bid.StatusDisplay</span>
                            <small class="text-muted">@bid.TimeAgo</small>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body">
                            <div class="d-flex gap-3">
                                <!-- Image -->
                                <div class="flex-shrink-0" style="width: 120px;">
                                    @if (!string.IsNullOrEmpty(bid.ItemImageUrl))
                                    {
                                        <img src="@bid.ItemImageUrl" alt="@bid.ItemTitle"
                                             class="img-fluid rounded" style="height: 120px; object-fit: cover; width: 100%;">
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                             style="height: 120px;">
                                            <i class="fas fa-image fa-2x text-muted"></i>
                                        </div>
                                    }
                                </div>

                                <!-- Info -->
                                <div class="flex-grow-1">
                                    <h5 class="card-title mb-1 text-truncate">@bid.ItemTitle</h5>
                                    <p class="mb-2"><span class="badge bg-info">@bid.CategoryName</span></p>

                                    <div class="d-flex justify-content-between small mb-2">
                                        <div>
                                            <div class="text-muted">My Bid</div>
                                            <div class="fw-bold text-primary">$@bid.MyBidAmount.ToString("N2")</div>
                                        </div>
                                        <div>
                                            <div class="text-muted">Current High</div>
                                            <div class="fw-bold text-success">$@bid.CurrentHighestBid.ToString("N2")</div>
                                        </div>
                                    </div>

                                    <!-- Status -->
                                    <div>
                                        @if (bid.IsWinning && bid.IsItemActive)
                                        {
                                            <div class="alert alert-success py-1 px-2 d-inline-flex align-items-center mb-1">
                                                <i class="fas fa-trophy me-1"></i><strong>You're winning!</strong>
                                            </div>
                                        }
                                        else if (!bid.IsWinning && bid.IsItemActive)
                                        {
                                            <div class="alert alert-warning py-1 px-2 d-inline-flex align-items-center mb-1">
                                                <i class="fas fa-exclamation-triangle me-1"></i><strong>Outbid</strong>
                                            </div>
                                        }
                                        else if (bid.ItemStatus == "S" && bid.IsWinning)
                                        {
                                            <div class="alert alert-primary py-1 px-2 d-inline-flex align-items-center mb-1">
                                                <i class="fas fa-check-circle me-1"></i><strong>You won!</strong>
                                            </div>
                                        }
                                        else if (bid.ItemStatus == "S" && !bid.IsWinning)
                                        {
                                            <div class="alert alert-secondary py-1 px-2 d-inline-flex align-items-center mb-1">
                                                <i class="fas fa-times-circle me-1"></i><strong>Auction ended</strong>
                                            </div>
                                        }

                                        @if (bid.IsItemActive)
                                        {
                                            <div class="text-muted small">
                                                <i class="fas fa-clock me-1"></i>
                                                <span id="timer-@bid.ItemId">@bid.TimeRemaining</span> remaining
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card Footer -->
                        <div class="card-footer bg-transparent border-0 pt-0">
                            <div class="d-flex justify-content-between align-items-center small">
                                <span class="text-muted">
                                    <i class="far fa-calendar-alt me-1"></i>
                                    @bid.BidTime.ToString("MMM dd, yyyy h:mm tt")
                                </span>
                                <div class="d-flex gap-2">
                                    <a href="@Url.Action("Details", "Auction", new { id = bid.ItemId })"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye me-1"></i> View
                                    </a>
                                    @if (bid.IsItemActive && !bid.IsWinning)
                                    {
                                        <a href="@Url.Action("Details", "Auction", new { id = bid.ItemId })"
                                           class="btn btn-sm btn-primary">
                                            <i class="fas fa-gavel me-1"></i> Bid Again
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4" aria-label="Bids pagination">
                <ul class="pagination justify-content-center">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("MyBids", new { page = Model.CurrentPage - 1 })" aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                    }

                    @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("MyBids", new { page = i })">@i</a>
                        </li>
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("MyBids", new { page = Model.CurrentPage + 1 })" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5">
            <i class="fas fa-gavel fa-4x text-muted mb-3"></i>
            <h4 class="fw-bold text-muted">No Bids Yet</h4>
            <p class="text-muted mb-4">
                You haven't placed any bids yet. Start exploring auctions to find items you're interested in!
            </p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg">
                <i class="fas fa-search me-1"></i> Browse Auctions
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateTimers() {
            @foreach (var bid in Model.Bids.Where(b => b.IsItemActive))
            {
                <text>
                var endTime_@(bid.ItemId) = new Date('@bid.ItemEndDate.ToString("yyyy-MM-ddTHH:mm:ssZ")');
                var now = new Date();
                var timeLeft = endTime_@(bid.ItemId) - now;

                var timerElement = document.getElementById('timer-@bid.ItemId');
                if (timerElement) {
                    if (timeLeft <= 0) {
                        timerElement.textContent = 'Ended';
                        timerElement.className = 'text-danger fw-bold';
                        setTimeout(() => location.reload(), 2000);
                    } else {
                        var days = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
                        var hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        var minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                        var seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

                        var display = '';
                        if (days > 0) display += days + 'd ';
                        if (hours > 0) display += hours + 'h ';
                        display += minutes + 'm ' + seconds + 's';
                        timerElement.textContent = display;
                    }
                }
                </text>
            }
        }

        updateTimers();
        setInterval(updateTimers, 1000);
    </script>
}

@section Styles {
    <style>
        .bid-card {
            transition: all 0.2s ease-in-out;
            border-radius: 0.75rem;
        }

        .bid-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
        }

        .alert {
            font-size: 0.8rem;
            border-radius: 0.375rem;
        }

        .card-title {
            font-size: 1rem;
            font-weight: 600;
        }
    </style>
}
