@model BidNest.ViewModels.UserBidsViewModel
@{
    ViewData["Title"] = "My Bids";
}

<div class="luxury-container py-5">
    <!-- Page Header -->
    <div class="row mb-5">
        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="luxury-header-content">
                <h2 class="luxury-title mb-2">My Bids</h2>
                <p class="luxury-subtitle mb-0">Track all your active and past bidding activity</p>
            </div>
            <div>
                <span class="luxury-badge">
                    <i class="fas fa-gavel me-2"></i>@Model.TotalBids Total Bids
                </span>
            </div>
        </div>
    </div>

    @if (Model.Bids.Any())
    {
        <!-- Bids Grid -->
        <div class="row g-4">
            @foreach (var bid in Model.Bids)
            {
                <div class="col-lg-6 col-md-12">
                    <div class="luxury-bid-card h-100">
                        <!-- Card Header -->
                        <div class="luxury-card-header d-flex justify-content-between align-items-center">
                            <span class="luxury-status-badge @bid.StatusBadgeClass">@bid.StatusDisplay</span>
                            <small class="luxury-time-ago">@bid.TimeAgo</small>
                        </div>

                        <!-- Card Body -->
                        <div class="luxury-card-body">
                            <div class="d-flex gap-3">
                                <!-- Image -->
                                <div class="flex-shrink-0 luxury-image-container">
                                    @if (!string.IsNullOrEmpty(bid.ItemImageUrl))
                                    {
                                        <img src="@bid.ItemImageUrl" alt="@bid.ItemTitle"
                                             class="luxury-item-image">
                                    }
                                    else
                                    {
                                        <div class="luxury-placeholder-image d-flex align-items-center justify-content-center">
                                            <i class="fas fa-image fa-2x"></i>
                                        </div>
                                    }
                                </div>

                                <!-- Info -->
                                <div class="flex-grow-1">
                                    <h5 class="luxury-item-title mb-2 text-truncate">@bid.ItemTitle</h5>
                                    <p class="mb-3"><span class="luxury-category-badge">@bid.CategoryName</span></p>

                                    <div class="d-flex justify-content-between mb-3">
                                        <div class="luxury-bid-info">
                                            <div class="luxury-bid-label">My Bid</div>
                                            <div class="luxury-bid-amount luxury-my-bid">$@bid.MyBidAmount.ToString("N2")</div>
                                        </div>
                                        <div class="luxury-bid-info">
                                            <div class="luxury-bid-label">Current High</div>
                                            <div class="luxury-bid-amount luxury-high-bid">$@bid.CurrentHighestBid.ToString("N2")</div>
                                        </div>
                                    </div>

                                    <!-- Status -->
                                    <div>
                                        @if (bid.IsWinning && bid.IsItemActive)
                                        {
                                            <div class="luxury-status-alert luxury-winning mb-2">
                                                <i class="fas fa-trophy me-2"></i><strong>You're winning!</strong>
                                            </div>
                                        }
                                        else if (!bid.IsWinning && bid.IsItemActive)
                                        {
                                            <div class="luxury-status-alert luxury-outbid mb-2">
                                                <i class="fas fa-exclamation-triangle me-2"></i><strong>Outbid</strong>
                                            </div>
                                        }
                                        else if (bid.ItemStatus == "S" && bid.IsWinning)
                                        {
                                            <div class="luxury-status-alert luxury-won mb-2">
                                                <i class="fas fa-check-circle me-2"></i><strong>You won!</strong>
                                            </div>
                                        }
                                        else if (bid.ItemStatus == "S" && !bid.IsWinning)
                                        {
                                            <div class="luxury-status-alert luxury-ended mb-2">
                                                <i class="fas fa-times-circle me-2"></i><strong>Auction ended</strong>
                                            </div>
                                        }

                                        @if (bid.IsItemActive)
                                        {
                                            <div class="luxury-timer">
                                                <i class="fas fa-clock me-2"></i>
                                                <span id="timer-@bid.ItemId">@bid.TimeRemaining</span> remaining
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card Footer -->
                        <div class="luxury-card-footer">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="luxury-bid-date">
                                    <i class="far fa-calendar-alt me-2"></i>
                                    @bid.BidTime.ToString("MMM dd, yyyy h:mm tt")
                                </span>
                                <div class="d-flex gap-2">
                                    <a href="@Url.Action("Details", "Auction", new { id = bid.ItemId })"
                                       class="luxury-btn luxury-btn-outline">
                                        <i class="fas fa-eye me-1"></i> View
                                    </a>
                                    @if (bid.IsItemActive && !bid.IsWinning)
                                    {
                                        <a href="@Url.Action("Details", "Auction", new { id = bid.ItemId })"
                                           class="luxury-btn luxury-btn-primary">
                                            <i class="fas fa-gavel me-1"></i> Bid Again
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-5" aria-label="Bids pagination">
                <ul class="luxury-pagination justify-content-center">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="luxury-page-item">
                            <a class="luxury-page-link" href="@Url.Action("MyBids", new { page = Model.CurrentPage - 1 })" aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                    }

                    @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                    {
                        <li class="luxury-page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="luxury-page-link" href="@Url.Action("MyBids", new { page = i })">@i</a>
                        </li>
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="luxury-page-item">
                            <a class="luxury-page-link" href="@Url.Action("MyBids", new { page = Model.CurrentPage + 1 })" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="luxury-empty-state text-center py-5">
            <div class="luxury-empty-icon mb-4">
                <i class="fas fa-gavel fa-4x"></i>
            </div>
            <h4 class="luxury-empty-title mb-3">No Bids Yet</h4>
            <p class="luxury-empty-text mb-4">
                You haven't placed any bids yet. Start exploring auctions to find items you're interested in!
            </p>
            <a href="@Url.Action("Index", "Home")" class="luxury-btn luxury-btn-primary luxury-btn-lg">
                <i class="fas fa-search me-2"></i> Browse Auctions
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateTimers() {
            @foreach (var bid in Model.Bids.Where(b => b.IsItemActive))
            {
                <text>
                var endTime_@(bid.ItemId) = new Date('@bid.ItemEndDate.ToString("yyyy-MM-ddTHH:mm:ssZ")');
                var now = new Date();
                var timeLeft = endTime_@(bid.ItemId) - now;

                var timerElement = document.getElementById('timer-@bid.ItemId');
                if (timerElement) {
                    if (timeLeft <= 0) {
                        timerElement.textContent = 'Ended';
                        timerElement.className = 'text-danger fw-bold';
                        setTimeout(() => location.reload(), 2000);
                    } else {
                        var days = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
                        var hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        var minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                        var seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

                        var display = '';
                        if (days > 0) display += days + 'd ';
                        if (hours > 0) display += hours + 'h ';
                        display += minutes + 'm ' + seconds + 's';
                        timerElement.textContent = display;
                    }
                }
                </text>
            }
        }

        updateTimers();
        setInterval(updateTimers, 1000);
    </script>
}

@section Styles {
    <style>
        /* Luxury Color Palette Variables */
        :root {
            --walnut-brown: #5C4033;
            --golden-oak: #C19A6B;
            --royal-gold: #D4AF37;
            --steel-mist: #A2B0BF;
            --matte-charcoal: #2B2B2B;
            --luxury-black: #000000;
        }

        /* Base Container */
        .luxury-container {
            background: var(--luxury-black);
            color: var(--steel-mist);
            min-height: 100vh;
            padding: 0 15px;
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Header Styles */
        .luxury-header-content {
            position: relative;
        }

        .luxury-title {
            color: var(--royal-gold);
            font-size: 2.5rem;
            font-weight: 700;
            text-shadow: 0 2px 4px rgba(212, 175, 55, 0.3);
            letter-spacing: -0.5px;
        }

        .luxury-subtitle {
            color: var(--golden-oak);
            font-size: 1.1rem;
            font-weight: 400;
            opacity: 0.9;
        }

        .luxury-badge {
            background: linear-gradient(135deg, var(--walnut-brown), var(--golden-oak));
            color: var(--luxury-black);
            padding: 12px 24px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1rem;
            box-shadow: 0 4px 15px rgba(193, 154, 107, 0.3);
            border: 1px solid var(--royal-gold);
            transition: all 0.3s ease;
        }

        .luxury-badge:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(193, 154, 107, 0.4);
        }

        /* Bid Card Styles */
        .luxury-bid-card {
            background: linear-gradient(145deg, var(--matte-charcoal), #1a1a1a);
            border: 1px solid var(--walnut-brown);
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
            position: relative;
        }

        .luxury-bid-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--royal-gold), var(--golden-oak), var(--royal-gold));
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .luxury-bid-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 20px 60px rgba(212, 175, 55, 0.2);
            border-color: var(--royal-gold);
        }

        .luxury-bid-card:hover::before {
            opacity: 1;
        }

        /* Card Header */
        .luxury-card-header {
            background: linear-gradient(135deg, var(--walnut-brown), #4a3529);
            padding: 16px 20px;
            border-bottom: 1px solid var(--golden-oak);
        }

        .luxury-status-badge {
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border: 1px solid var(--royal-gold);
            background: var(--royal-gold);
            color: var(--luxury-black);
        }

        .luxury-time-ago {
            color: var(--golden-oak);
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* Card Body */
        .luxury-card-body {
            padding: 24px 20px;
        }

        .luxury-image-container {
            width: 120px;
        }

        .luxury-item-image {
            width: 100%;
            height: 120px;
            object-fit: cover;
            border-radius: 12px;
            border: 2px solid var(--walnut-brown);
            transition: all 0.3s ease;
        }

        .luxury-item-image:hover {
            border-color: var(--royal-gold);
            transform: scale(1.05);
        }

        .luxury-placeholder-image {
            width: 100%;
            height: 120px;
            background: linear-gradient(135deg, var(--walnut-brown), var(--matte-charcoal));
            border-radius: 12px;
            color: var(--golden-oak);
            border: 2px solid var(--walnut-brown);
        }

        .luxury-item-title {
            color: var(--steel-mist);
            font-size: 1.2rem;
            font-weight: 700;
            line-height: 1.3;
        }

        .luxury-category-badge {
            background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
            color: var(--luxury-black);
            padding: 4px 12px;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Bid Information */
        .luxury-bid-info {
            text-align: center;
        }

        .luxury-bid-label {
            color: var(--golden-oak);
            font-size: 0.85rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .luxury-bid-amount {
            font-size: 1.1rem;
            font-weight: 700;
            font-family: 'Courier New', monospace;
        }

        .luxury-my-bid {
            color: var(--royal-gold);
        }

        .luxury-high-bid {
            color: var(--steel-mist);
        }

        /* Status Alerts */
        .luxury-status-alert {
            padding: 8px 16px;
            border-radius: 25px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            border: 1px solid;
            transition: all 0.3s ease;
        }

        .luxury-winning {
            background: linear-gradient(135deg, var(--royal-gold), #f4d03f);
            color: var(--luxury-black);
            border-color: var(--royal-gold);
        }

        .luxury-outbid {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            color: white;
            border-color: #e74c3c;
        }

        .luxury-won {
            background: linear-gradient(135deg, var(--golden-oak), var(--royal-gold));
            color: var(--luxury-black);
            border-color: var(--royal-gold);
        }

        .luxury-ended {
            background: linear-gradient(135deg, var(--steel-mist), #95a5a6);
            color: var(--luxury-black);
            border-color: var(--steel-mist);
        }

        .luxury-timer {
            color: var(--golden-oak);
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* Card Footer */
        .luxury-card-footer {
            background: linear-gradient(135deg, #1a1a1a, var(--matte-charcoal));
            padding: 16px 20px;
            border-top: 1px solid var(--walnut-brown);
        }

        .luxury-bid-date {
            color: var(--golden-oak);
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* Luxury Buttons */
        .luxury-btn {
            padding: 8px 20px;
            border-radius: 25px;
            font-weight: 600;
            font-size: 0.9rem;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: 2px solid;
            display: inline-flex;
            align-items: center;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .luxury-btn-outline {
            background: transparent;
            color: var(--golden-oak);
            border-color: var(--golden-oak);
        }

        .luxury-btn-outline:hover {
            background: var(--golden-oak);
            color: var(--luxury-black);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(193, 154, 107, 0.4);
        }

        .luxury-btn-primary {
            background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
            color: var(--luxury-black);
            border-color: var(--royal-gold);
        }

        .luxury-btn-primary:hover {
            background: linear-gradient(135deg, var(--golden-oak), var(--royal-gold));
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.4);
        }

        .luxury-btn-lg {
            padding: 12px 32px;
            font-size: 1.1rem;
        }

        /* Pagination */
        .luxury-pagination {
            display: flex;
            list-style: none;
            padding: 0;
            margin: 0;
            gap: 8px;
        }

        .luxury-page-item {
            display: block;
        }

        .luxury-page-link {
            display: block;
            padding: 12px 16px;
            color: var(--golden-oak);
            background: var(--matte-charcoal);
            border: 2px solid var(--walnut-brown);
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            min-width: 48px;
            text-align: center;
        }

        .luxury-page-link:hover {
            background: var(--walnut-brown);
            border-color: var(--royal-gold);
            color: var(--royal-gold);
            transform: translateY(-2px);
        }

        .luxury-page-item.active .luxury-page-link {
            background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
            border-color: var(--royal-gold);
            color: var(--luxury-black);
        }

        /* Empty State */
        .luxury-empty-state {
            padding: 80px 20px;
        }

        .luxury-empty-icon {
            color: var(--walnut-brown);
            opacity: 0.7;
        }

        .luxury-empty-title {
            color: var(--steel-mist);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .luxury-empty-text {
            color: var(--golden-oak);
            font-size: 1.1rem;
            max-width: 500px;
            margin: 0 auto;
            line-height: 1.6;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .luxury-title {
                font-size: 2rem;
            }
            
            .luxury-bid-card {
                margin-bottom: 20px;
            }
            
            .luxury-card-body {
                padding: 20px 16px;
            }
            
            .luxury-image-container {
                width: 100px;
            }
            
            .luxury-item-image,
            .luxury-placeholder-image {
                height: 100px;
            }
            
            .luxury-btn {
                padding: 6px 16px;
                font-size: 0.8rem;
            }
        }

        /* Smooth Animations */
        * {
            transition: color 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
        }
    </style>
}
