@model BidNest.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        /* Animated gradient background */
        .login-hero { /* Renamed from 'register-hero' for consistency with login */
            background: linear-gradient(45deg, #007bff, #6610f2, #007bff);
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            color: #fff;
        }

        /* Floating bubble overlay */
        .login-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('data:image/svg+xml;utf8,<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="10" fill="%23ffffff" opacity="0.1"/><circle cx="80" cy="40" r="15" fill="%23ffffff" opacity="0.1"/><circle cx="50" cy="80" r="12" fill="%23ffffff" opacity="0.1"/><circle cx="30" cy="70" r="8" fill="%23ffffff" opacity="0.1"/><circle cx="70" cy="10" r="11" fill="%23ffffff" opacity="0.1"/></svg>') repeat;
            background-size: 150px;
            opacity: 0.3;
            animation: moveBubbles 30s linear infinite;
            z-index: 0;
        }

        /* Card styling - Modernized (matches login-card) */
        .register-card { /* Using a distinct class for register to avoid conflicts, but styling is identical */
            background: rgba(255, 255, 255, 0.98);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            backdrop-filter: blur(5px);
            z-index: 1;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: none;
        }

        .register-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.2);
        }

        .register-card .card-header {
            background: linear-gradient(90deg, #007bff, #6610f2);
            color: #fff;
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
            padding: 2rem 1.5rem;
            font-size: 1.25rem;
            position: relative;
            overflow: hidden;
        }
        
        /* Subtle wave effect for header */
        .register-card .card-header::before {
            content: '';
            position: absolute;
            bottom: -30px;
            left: -10%;
            width: 120%;
            height: 60px;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
            transform: rotate(-5deg);
        }

        /* Floating labels style - Enhanced (matches login) */
        .form-floating label {
            color: #6c757d;
            transition: all 0.2s ease;
        }
        .form-control {
            border-radius: 10px;
            border: 1px solid #ced4da;
            padding: 1rem 0.75rem; /* Adjust padding for better look with floating labels */
        }
        .form-control:focus {
            border-color: #6610f2;
            box-shadow: 0 0 0 0.25rem rgba(102, 16, 242, 0.2);
            border-width: 2px;
        }
        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label,
        .form-floating > .form-select ~ label {
            transform: scale(0.85) translateY(-0.5rem) translateX(0.15rem);
            color: #6610f2;
        }

        /* Register Button - Gradient and Hover Effect (matches login button) */
        .btn-primary-gradient { /* New class for gradient button */
            background: linear-gradient(45deg, #007bff, #6610f2);
            border: none;
            border-radius: 10px;
            padding: 0.75rem 1.5rem;
            font-size: 1.1rem;
            font-weight: 600;
            transition: all 0.3s ease;
            background-size: 200% auto;
            color: #fff; /* Ensure text is white */
        }
        .btn-primary-gradient:hover {
            background-position: right center;
            box-shadow: 0 8px 25px rgba(0, 123, 255, 0.4);
            transform: translateY(-2px);
        }
        .btn-primary-gradient:active {
            transform: translateY(0);
            box-shadow: none;
        }

        /* General text and links */
        .text-primary { /* Ensure text-primary styles are defined */
            color: #007bff !important;
        }
        .text-primary:hover {
            color: #0056b3 !important;
        }
        a.fw-bold { /* Adjusting link style for consistency */
            text-decoration: none;
            transition: color 0.2s ease;
        }

        /* Gradient animation */
        @@keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Bubble movement */
        @@keyframes moveBubbles {
            from { background-position: 0 0; }
            to { background-position: 100% 100%; }
        }
    </style>
}

<div class="login-hero"> <!-- Using the same hero background as login -->
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7"> <!-- Slightly wider card for more fields -->
                <div class="card register-card shadow-lg">
                    <div class="card-header text-center">
                        <h3 class="mb-1 fw-bold">Create Your BidNest Account ✨</h3>
                        <p class="mb-0 small opacity-75">Join us and start bidding today!</p>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="Register" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="FullName" class="form-control" id="fullNameInput" placeholder="Enter your full name" autocomplete="name" />
                                        <label for="fullNameInput">Full Name</label>
                                        <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Username" class="form-control" id="usernameInput" placeholder="Choose a username" autocomplete="username" />
                                        <label for="usernameInput">Username</label>
                                        <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Email" class="form-control" id="emailInput" placeholder="Enter your email address" autocomplete="email" />
                                <label for="emailInput">Email Address</label>
                                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Password" class="form-control" id="passwordInput" placeholder="Create a password" type="password" autocomplete="new-password" />
                                        <label for="passwordInput">Password</label>
                                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                                        <div class="form-text text-muted small ms-1 mt-2">Password must be at least 6 characters long.</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="ConfirmPassword" class="form-control" id="confirmPasswordInput" placeholder="Confirm your password" type="password" autocomplete="new-password" />
                                        <label for="confirmPasswordInput">Confirm Password</label>
                                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="d-grid gap-2 mt-4">
                                <button type="submit" class="btn btn-primary-gradient btn-lg">Create Account</button>
                            </div>
                        </form>
                    </div>
                    <div class="card-footer text-center py-3 bg-light border-0" style="border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
                        <p class="mb-0 small text-muted">
                            Already have an account? 
                            <a href="@Url.Action("Login")" class="fw-bold text-primary">Login here</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}