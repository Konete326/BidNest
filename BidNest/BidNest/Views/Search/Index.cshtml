@model BidNest.ViewModels.SearchViewModel
@{
    ViewData["Title"] = "Search Results";
    var hasResults = Model.Results.Any();
    var categoryName = ViewBag.CategoryName as string;
}

<div class="container my-4">
    <!-- Search Header -->
    <div class="row mb-4 animate__animated animate__fadeIn"> @* Changed to general fadeIn *@
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-1 title-gradient"> @* Added title-gradient class *@
                        @if (!string.IsNullOrEmpty(categoryName))
                        {
                            <span>@categoryName</span>
                        }
                        else
                        {
                            <span>Search Results</span>
                        }
                    </h2>
                    <p class="text-muted mb-0">
                        @if (Model.TotalResults > 0)
                        {
                            <span>@Model.TotalResults.ToString("N0") items found</span>
                            @if (Model.HasFilters)
                            {
                                <span> for "<strong class="text-dark">@Model.SearchSummary</strong>"</span> @* Highlighted search summary *@
                            }
                        }
                        else
                        {
                            <span>No items found</span>
                            @if (Model.HasFilters)
                            {
                                <span> matching your criteria</span>
                            }
                        }
                    </p>
                </div>
                <div>
                    <a href="@Url.Action("Advanced")" class="btn btn-primary btn-hover-scale"> @* Added btn-hover-scale class *@
                        <i class="fas fa-sliders-h me-2"></i> Advanced Search
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Filters Sidebar -->
        <div class="col-lg-3 mb-4">
            <div class="card shadow-sm animate__animated animate__fadeInUp"> @* Changed to fadeInUp *@
                <div class="card-header bg-primary text-white"> @* Changed header style *@
                    <h5 class="mb-0">
                        <i class="fas fa-filter me-2"></i>Filters
                    </h5>
                </div>
                <div class="card-body">
                    <form method="get" id="search-form">
                        <!-- Keyword Search -->
                        <div class="mb-3 form-group-animated"> @* Added form-group-animated class *@
                            <label class="form-label fw-bold">Keywords</label>
                            <input type="text" name="Query" class="form-control" value="@Model.Query" 
                                   placeholder="Search items...">
                        </div>

                        <!-- Category Filter -->
                        <div class="mb-3 form-group-animated"> @* Added form-group-animated class *@
                            <label class="form-label fw-bold">Category</label>
                            <select name="CategoryId" class="form-select">
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Value" selected="@category.Selected">@category.Text</option>
                                }
                            </select>
                        </div>

                        <!-- Price Range -->
                        <div class="mb-3 form-group-animated"> @* Added form-group-animated class *@
                            <label class="form-label fw-bold">Price Range</label>
                            <div class="row">
                                <div class="col-6">
                                    <input type="number" name="MinPrice" class="form-control" 
                                           value="@Model.MinPrice" placeholder="Min $" step="0.01">
                                </div>
                                <div class="col-6">
                                    <input type="number" name="MaxPrice" class="form-control" 
                                           value="@Model.MaxPrice" placeholder="Max $" step="0.01">
                                </div>
                            </div>
                        </div>

                        <!-- Status Filter -->
                        <div class="mb-3 form-group-animated"> @* Added form-group-animated class *@
                            <label class="form-label fw-bold">Status</label>
                            <select name="Status" class="form-select">
                                @foreach (var status in Model.StatusOptions)
                                {
                                    <option value="@status.Value" selected="@status.Selected">@status.Text</option>
                                }
                            </select>
                        </div>

                        <!-- Has Bids Filter -->
                        <div class="mb-3 form-group-animated"> @* Added form-group-animated class *@
                            <div class="form-check">
                                <input type="checkbox" name="HasBids" value="true" class="form-check-input" 
                                       @(Model.HasBids == true ? "checked" : "")>
                                <label class="form-check-label">Items with bids only</label>
                            </div>
                        </div>

                        <!-- Hidden fields for pagination -->
                        <input type="hidden" name="Page" value="1">
                        <input type="hidden" name="SortBy" value="@Model.SortBy">
                        <input type="hidden" name="SortOrder" value="@Model.SortOrder">

                        <div class="d-grid gap-2 mt-4"> @* Added mt-4 for spacing *@
                            <button type="submit" class="btn btn-primary btn-animated"> @* Added btn-animated class *@
                                <i class="fas fa-search me-2"></i> Search
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-animated"> @* Added btn-animated class *@
                                <i class="fas fa-times me-2"></i> Clear All
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Search Statistics -->
            @if (hasResults)
            {
                <div class="card mt-3 shadow-sm animate__animated animate__fadeInUp animate__delay-1s"> @* Changed to fadeInUp, with delay *@
                    <div class="card-header bg-info text-white"> @* Changed header style *@
                        <h6 class="mb-0">Search Statistics</h6>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6 mb-2 stat-item"> @* Added stat-item class *@
                                <div class="fw-bold text-primary display-6">@Model.Stats.ActiveAuctions</div> @* Larger text *@
                                <small class="text-muted">Active Auctions</small> @* More descriptive text *@
                            </div>
                            <div class="col-6 mb-2 stat-item"> @* Added stat-item class *@
                                <div class="fw-bold text-warning display-6">@Model.Stats.EndingSoon</div> @* Larger text *@
                                <small class="text-muted">Ending Soon</small>
                            </div>
                            @if (Model.Stats.TotalBids > 0)
                            {
                                <div class="col-6 stat-item"> @* Added stat-item class *@
                                    <div class="fw-bold text-success display-6">$@Model.Stats.AverageBid.ToString("N0")</div> @* Larger text *@
                                    <small class="text-muted">Avg Bid</small>
                                </div>
                                <div class="col-6 stat-item"> @* Added stat-item class *@
                                    <div class="fw-bold text-info display-6">@Model.Stats.TotalBids</div> @* Larger text *@
                                    <small class="text-muted">Total Bids</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Search Results -->
        <div class="col-lg-9">
            @if (hasResults)
            {
                <!-- Sort and View Options -->
                <div class="d-flex justify-content-between align-items-center mb-3 animate__animated animate__fadeIn"> @* Changed to general fadeIn *@
                    <div class="d-flex align-items-center">
                        <span class="me-3 text-dark fw-bold">Sort by:</span> @* Highlighted text *@
                        <form method="get" class="d-flex align-items-center" id="sort-form">
                            <!-- Preserve all current search parameters -->
                            <input type="hidden" name="Query" value="@Model.Query">
                            <input type="hidden" name="CategoryId" value="@Model.CategoryId">
                            <input type="hidden" name="MinPrice" value="@Model.MinPrice">
                            <input type="hidden" name="MaxPrice" value="@Model.MaxPrice">
                            <input type="hidden" name="Status" value="@Model.Status">
                            <input type="hidden" name="HasBids" value="@Model.HasBids">
                            <input type="hidden" name="Page" value="1">

                            <select name="SortBy" class="form-select form-select-sm me-2 hover-shadow-sm" style="width: auto;" onchange="this.form.submit()"> @* Added hover-shadow-sm *@
                                @foreach (var sort in Model.SortOptions)
                                {
                                    <option value="@sort.Value" selected="@sort.Selected">@sort.Text</option>
                                }
                            </select>
                            <select name="SortOrder" class="form-select form-select-sm hover-shadow-sm" style="width: auto;" onchange="this.form.submit()"> @* Added hover-shadow-sm *@
                                <option value="asc" selected="@(Model.SortOrder == "asc")">Ascending</option>
                                <option value="desc" selected="@(Model.SortOrder == "desc")">Descending</option>
                            </select>
                        </form>
                    </div>
                    <div class="text-muted small"> @* Adjusted size *@
                        Showing <span class="fw-bold text-dark">@((Model.Page - 1) * Model.PageSize + 1) - @Math.Min(Model.Page * Model.PageSize, Model.TotalResults)</span> 
                        of <span class="fw-bold text-dark">@Model.TotalResults</span> results
                    </div>
                </div>

                <!-- Results Grid -->
                <div class="row">
                    @foreach (var item in Model.Results)
                    {
                        <div class="col-md-6 col-xl-4 mb-4">
                            <div class="card h-100 auction-card fade-in-section"> @* Added fade-in-section class for scroll animation *@
                                <div class="position-relative overflow-hidden"> @* Added overflow-hidden for image zoom *@
                                    @if (!string.IsNullOrEmpty(item.PrimaryImageUrl))
                                    {
                                        <img src="@item.PrimaryImageUrl" class="card-img-top auction-image" alt="@item.Title"> @* Added auction-image class *@
                                    }
                                    else
                                    {
                                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                            <i class="fas fa-image fa-4x text-muted icon-pulse"></i> @* Larger icon, added pulse effect *@
                                        </div>
                                    }
                                    
                                    <!-- Status Badge -->
                                    <span class="badge @item.StatusBadgeClass position-absolute top-0 end-0 m-2 badge-animated"> @* Added badge-animated *@
                                        @item.StatusDisplay
                                    </span>
                                    
                                    <!-- Category Badge -->
                                    @if (!string.IsNullOrEmpty(item.CategoryName))
                                    {
                                        <span class="badge bg-secondary position-absolute top-0 start-0 m-2 badge-animated"> @* Added badge-animated *@
                                            @item.CategoryName
                                        </span>
                                    }
                                </div>
                                
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title mb-2"> @* Changed to h5, added mb-2 *@
                                        <a href="@Url.Action("Details", "Auction", new { id = item.ItemId })" 
                                           class="text-decoration-none text-dark hover-underline"> @* Added hover-underline *@
                                            @item.Title
                                        </a>
                                    </h5>
                                    
                                    <p class="card-text text-muted small flex-grow-1 auction-description"> @* Added auction-description class *@
                                        @(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                                    </p>
                                    
                                    <div class="mt-auto pt-3 border-top"> @* Added pt-3 and border-top *@
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div>
                                                <div class="fw-bold text-primary fs-4 price-highlight">$@item.CurrentPrice.ToString("N2")</div> @* Larger price, added price-highlight *@
                                                <small class="text-muted">@item.BidCount bid(s)</small>
                                            </div>
                                            <div class="text-end">
                                                <div class="fw-bold @(item.IsEnding ? "text-danger animate__animated animate__pulse animate__infinite" : "text-success") fs-5"> @* Changed to text-danger for ending, added pulse animation *@
                                                    @item.TimeRemainingDisplay
                                                </div>
                                                <small class="text-muted">remaining</small>
                                            </div>
                                        </div>
                                        
                                        <div class="d-grid">
                                            @if (item.IsActive)
                                            {
                                                <a href="@Url.Action("Details", "Auction", new { id = item.ItemId })" 
                                                   class="btn btn-primary btn-sm btn-bid-animated"> @* Added btn-bid-animated *@
                                                    <i class="fas fa-gavel me-2"></i> Bid Now
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@Url.Action("Details", "Auction", new { id = item.ItemId })" 
                                                   class="btn btn-outline-secondary btn-sm btn-view-animated"> @* Added btn-view-animated *@
                                                    <i class="fas fa-eye me-2"></i> View Details
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Search results pagination" class="mt-4 animate__animated animate__fadeInUp"> @* Changed to fadeInUp *@
                        <ul class="pagination justify-content-center pagination-animated"> @* Added pagination-animated *@
                            @if (Model.Page > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link page-link-animated" href="@Url.Action("Index", new { 
                                        Query = Model.Query, CategoryId = Model.CategoryId, MinPrice = Model.MinPrice, 
                                        MaxPrice = Model.MaxPrice, Status = Model.Status, HasBids = Model.HasBids,
                                        SortBy = Model.SortBy, SortOrder = Model.SortOrder, Page = Model.Page - 1 })">
                                        Previous
                                    </a>
                                </li>
                            }

                            @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link page-link-animated" href="@Url.Action("Index", new { 
                                        Query = Model.Query, CategoryId = Model.CategoryId, MinPrice = Model.MinPrice, 
                                        MaxPrice = Model.MaxPrice, Status = Model.Status, HasBids = Model.HasBids,
                                        SortBy = Model.SortBy, SortOrder = Model.SortOrder, Page = i })">
                                        @i
                                    </a>
                                </li>
                            }

                            @if (Model.Page < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link page-link-animated" href="@Url.Action("Index", new { 
                                        Query = Model.Query, CategoryId = Model.CategoryId, MinPrice = Model.MinPrice, 
                                        MaxPrice = Model.MaxPrice, Status = Model.Status, HasBids = Model.HasBids,
                                        SortBy = Model.SortBy, SortOrder = Model.SortOrder, Page = Model.Page + 1 })">
                                        Next
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <!-- No Results -->
                <div class="text-center py-5 no-results-animated"> @* Added no-results-animated *@
                    <i class="fas fa-search fa-5x text-muted mb-3 icon-bounce"></i> @* Larger icon, added bounce effect *@
                    <h4 class="text-muted display-6">No items found</h4> @* Larger text *@
                    @if (Model.HasFilters)
                    {
                        <p class="text-muted mb-4 fs-5">Try adjusting your search criteria or browse all categories.</p> @* Larger text *@
                        <div class="d-flex justify-content-center gap-2"> @* Used gap for spacing *@
                            <a href="@Url.Action("Index")" class="btn btn-primary btn-lg btn-animated"> @* Larger button, added btn-animated *@
                                <i class="fas fa-times me-2"></i> Clear Filters
                            </a>
                            <a href="@Url.Action("Categories")" class="btn btn-outline-primary btn-lg btn-animated"> @* Larger button, added btn-animated *@
                                <i class="fas fa-th-large me-2"></i> Browse Categories
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-4 fs-5">There are currently no active auctions.</p> @* Larger text *@
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg btn-animated"> @* Larger button, added btn-animated *@
                            <i class="fas fa-home me-2"></i> Go Home
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.js"></script> @* Animate.css for entrance animations *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Function to check if an element is in viewport
            function isInViewport(element) {
                const rect = element.getBoundingClientRect();
                return (
                    rect.top >= 0 &&
                    rect.left >= 0 &&
                    rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&
                    rect.right <= (window.innerWidth || document.documentElement.clientWidth)
                );
            }

            // Apply fade-in effect on scroll
            const fadeSections = document.querySelectorAll('.fade-in-section');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        observer.unobserve(entry.target); // Stop observing once animated
                    }
                });
            }, {
                threshold: 0.1 // Trigger when 10% of the item is visible
            });

            fadeSections.forEach(section => {
                observer.observe(section);
            });

            // Add simple click feedback for buttons (optional)
            document.querySelectorAll('.btn-animated').forEach(button => {
                button.addEventListener('click', function() {
                    this.classList.add('animate__animated', 'animate__pulse');
                    this.addEventListener('animationend', () => {
                        this.classList.remove('animate__animated', 'animate__pulse');
                    }, { once: true });
                });
            });

             // Category and Sort selects change handler
            document.querySelectorAll('.form-select').forEach(select => {
                select.addEventListener('change', function() {
                    if (this.name === 'SortBy' || this.name === 'SortOrder') {
                        document.getElementById('sort-form').submit();
                    } else if (this.name === 'CategoryId' || this.name === 'Status') {
                         // Reset page to 1 when changing category or status
                        document.querySelector('#search-form input[name="Page"]').value = 1;
                        document.getElementById('search-form').submit();
                    }
                });
            });

            // Keyword input debounce for better UX
            let typingTimer;
            const searchInput = document.querySelector('input[name="Query"]');
            if (searchInput) {
                searchInput.addEventListener('keyup', () => {
                    clearTimeout(typingTimer);
                    typingTimer = setTimeout(() => {
                        // Reset page to 1 when typing new query
                        document.querySelector('#search-form input[name="Page"]').value = 1;
                        document.getElementById('search-form').submit();
                    }, 800); // 800ms debounce
                });

                // Prevent form submission on Enter key in search input if it's not ready
                searchInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault(); // Prevent immediate submission
                        clearTimeout(typingTimer); // Clear any pending debounce
                        // Reset page to 1 and submit immediately
                        document.querySelector('#search-form input[name="Page"]').value = 1;
                        document.getElementById('search-form').submit();
                    }
                });
            }

            // Price inputs change handler with debounce
            document.querySelectorAll('input[name="MinPrice"], input[name="MaxPrice"]').forEach(input => {
                let priceTypingTimer;
                input.addEventListener('keyup', () => {
                    clearTimeout(priceTypingTimer);
                    priceTypingTimer = setTimeout(() => {
                        document.querySelector('#search-form input[name="Page"]').value = 1;
                        document.getElementById('search-form').submit();
                    }, 800);
                });
                input.addEventListener('change', () => { // Also submit on change (e.g., blur)
                    clearTimeout(priceTypingTimer);
                    document.querySelector('#search-form input[name="Page"]').value = 1;
                    document.getElementById('search-form').submit();
                });
            });

            // HasBids checkbox change handler
            document.querySelector('input[name="HasBids"]').addEventListener('change', function() {
                document.querySelector('#search-form input[name="Page"]').value = 1;
                document.getElementById('search-form').submit();
            });
        });
    </script>
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
 
<style>
    :root {
        --walnut-brown: #5C4033;
        --golden-oak: #C19A6B;
        --royal-gold: #D4AF37;
        --steel-mist: #A2B0BF;
        --matte-charcoal: #2B2B2B;
        --text-light: #f8f9fa;
        --text-muted: #A2B0BF;
        --bg-dark: #000000;
        --card-bg: #1a1a1a;
        --border-color: rgba(196, 154, 107, 0.2);
        --shadow-luxury: 0 15px 45px rgba(0, 0, 0, 0.5);
        --shadow-hover: 0 20px 60px rgba(212, 175, 55, 0.15);
    }

    /* Global Styling */
    body {
        background-color: var(--bg-dark) !important;
        color: var(--text-light);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        line-height: 1.6;
    }

    .container {
        background-color: var(--bg-dark);
        min-height: 100vh;
        padding-top: 2rem;
        padding-bottom: 2rem;
    }

    /* Header Styling */
    .title-gradient {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: 700;
        font-size: 2.5rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        animation: fadeInDown 0.8s ease-out;
    }

    .text-muted {
        color: var(--steel-mist) !important;
    }

    .text-dark {
        color: var(--royal-gold) !important;
        font-weight: 600;
    }

    /* Button Styling */
    .btn-primary {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        color: var(--matte-charcoal);
        border: none;
        border-radius: 25px;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    }

    .btn-primary::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.5s;
    }

    .btn-primary:hover::before {
        left: 100%;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
        color: var(--text-light);
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
    }

    .btn-hover-scale:hover {
        transform: translateY(-3px) scale(1.05);
    }

    .btn-outline-secondary {
        background: transparent;
        color: var(--steel-mist);
        border: 2px solid var(--steel-mist);
        border-radius: 25px;
    }

    .btn-outline-secondary:hover {
        background: linear-gradient(135deg, var(--steel-mist), var(--golden-oak));
        color: var(--matte-charcoal);
        border-color: var(--golden-oak);
        transform: translateY(-3px);
    }

    /* Card Styling */
    .card {
        background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: var(--shadow-luxury);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        position: relative;
    }

    .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, var(--royal-gold), var(--golden-oak), var(--walnut-brown));
        z-index: 1;
    }

    .card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-hover);
        border-color: var(--golden-oak);
    }

    .card-header {
        background: linear-gradient(135deg, var(--walnut-brown) 0%, var(--matte-charcoal) 35%, var(--golden-oak) 70%, var(--royal-gold) 100%);
        background-size: 400% 400%;
        animation: luxuryGradientShift 20s ease infinite;
        border: none;
        border-radius: 20px 20px 0 0 !important;
        padding: 1.5rem 2rem;
        position: relative;
        overflow: hidden;
    }

    .card-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
