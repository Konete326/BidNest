@model BidNest.ViewModels.SellerItemsViewModel
@{
    ViewData["Title"] = "My Items";
}

<style>
    :root {
        --walnut-brown: #5C4033;
        --golden-oak: #C19A6B;
        --royal-gold: #D4AF37;
        --steel-mist: #A2B0BF;
        --matte-charcoal: #2B2B2B;
        --text-light: #f8f9fa;
        --text-muted: #A2B0BF;
        --bg-dark: #000000;
        --card-bg: #1a1a1a;
        --border-color: rgba(196, 154, 107, 0.2);
    }

    /* Global Styling */
    body {
        background-color: var(--bg-dark) !important;
        color: var(--text-light);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .luxury-container {
        width: 100%;
        max-width: 1400px;
        padding: 2rem 15px;
        margin: 0 auto;
        background-color: var(--bg-dark);
        min-height: 100vh;
    }

    /* Header Styling */
    .luxury-header {
        background: linear-gradient(135deg, var(--walnut-brown) 0%, var(--matte-charcoal) 35%, var(--golden-oak) 70%, var(--royal-gold) 100%);
        background-size: 400% 400%;
        animation: luxuryGradientShift 20s ease infinite;
        border-radius: 15px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.5);
        border: 1px solid var(--border-color);
        position: relative;
        overflow: hidden;
        padding: 2rem;
        margin-bottom: 2rem;
    }

    @@keyframes luxuryGradientShift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .luxury-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: url('data:image/svg+xml;utf8,<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="8" fill="%23D4AF37" opacity="0.1"/><circle cx="80" cy="40" r="12" fill="%23C19A6B" opacity="0.1"/><circle cx="50" cy="80" r="10" fill="%23D4AF37" opacity="0.1"/></svg>') repeat;
        background-size: 150px;
        opacity: 0.6;
        animation: moveBubbles 30s linear infinite;
        z-index: 0;
    }

    @@keyframes moveBubbles {
        from { background-position: 0 0; }
        to { background-position: 100% 100%; }
    }

    .luxury-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        z-index: 1;
    }

    .luxury-header h2 {
        font-weight: 700;
        font-size: 2.5rem;
        letter-spacing: -0.02rem;
        color: var(--text-light);
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        margin-bottom: 0.5rem;
    }

    .luxury-header p {
        font-size: 1.1rem;
        opacity: 0.9;
        color: var(--text-light);
        margin-bottom: 0;
    }

    /* Button Styling */
    .luxury-btn {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        border-radius: 25px;
        text-decoration: none;
        text-align: center;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: none;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.5px;
        position: relative;
        overflow: hidden;
        margin: 0.25rem;
    }

    .luxury-btn-primary {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        color: var(--matte-charcoal);
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    }

    .luxury-btn-primary::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.5s;
    }

    .luxury-btn-primary:hover::before {
        left: 100%;
    }

    .luxury-btn-primary:hover {
        background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
        color: var(--text-light);
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
        text-decoration: none;
    }

    .luxury-btn-lg {
        padding: 1rem 2rem;
        font-size: 1.1rem;
    }

    /* Filter Card */
    .luxury-filter-card {
        background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
        border: 1px solid var(--border-color);
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
        margin-bottom: 2rem;
        padding: 1.5rem;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .luxury-filter-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(212, 175, 55, 0.15);
        border-color: var(--golden-oak);
    }

    /* Filter Buttons */
    .luxury-filter-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .luxury-filter-btn {
        padding: 0.5rem 1.25rem;
        border-radius: 25px;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        border: 2px solid transparent;
        position: relative;
        overflow: hidden;
    }

    .luxury-filter-btn-outline {
        background: transparent;
        color: var(--royal-gold);
        border-color: var(--royal-gold);
    }

    .luxury-filter-btn-outline:hover {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        color: var(--matte-charcoal);
        text-decoration: none;
        transform: translateY(-1px);
    }

    .luxury-filter-btn-active {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        color: var(--matte-charcoal);
        border-color: var(--golden-oak);
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    }

    .luxury-badge-count {
        background: rgba(43, 43, 43, 0.9);
        color: var(--royal-gold);
        padding: 0.2rem 0.5rem;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-left: 0.5rem;
    }

    /* Form Select */
    .luxury-form-select {
        background-color: var(--matte-charcoal);
        border: 2px solid var(--border-color);
        border-radius: 8px;
        color: var(--text-light);
        padding: 0.5rem 2.5rem 0.5rem 1rem;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23C19A6B' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 0.75rem center;
        background-size: 16px 12px;
    }

    .luxury-form-select:focus {
        background-color: var(--matte-charcoal);
        border-color: var(--royal-gold);
        box-shadow: 0 0 0 0.2rem rgba(212, 175, 55, 0.25);
        color: var(--text-light);
        outline: none;
    }

    .luxury-form-label {
        color: var(--golden-oak);
        font-weight: 600;
        margin-right: 0.5rem;
        font-size: 0.9rem;
    }

    /* Empty State */
    .luxury-empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
        border: 2px dashed var(--border-color);
        margin-top: 2rem;
    }

    .luxury-empty-icon {
        font-size: 4rem;
        color: var(--steel-mist);
        opacity: 0.6;
        margin-bottom: 1.5rem;
    }

    .luxury-empty-title {
        color: var(--text-light);
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .luxury-empty-text {
        color: var(--steel-mist);
        font-size: 1.1rem;
        margin-bottom: 2rem;
    }

    /* Item Card Styling */
    .luxury-item-card {
        background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
        border: 1px solid var(--border-color);
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .luxury-item-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(212, 175, 55, 0.2);
        border-color: var(--golden-oak);
    }

    .luxury-item-image {
        position: relative;
        height: 200px;
        overflow: hidden;
    }

    .luxury-item-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .luxury-item-card:hover .luxury-item-img {
        transform: scale(1.05);
    }

    .luxury-no-image {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        background: var(--matte-charcoal);
        color: var(--steel-mist);
        font-size: 1.2rem;
    }

    .luxury-no-image i {
        font-size: 2rem;
        margin-bottom: 0.5rem;
        opacity: 0.5;
    }

    .luxury-item-status {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 2;
    }

    .luxury-item-content {
        padding: 1.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .luxury-item-title {
        color: var(--text-light);
        font-weight: 600;
        font-size: 1.2rem;
        margin-bottom: 0.75rem;
        line-height: 1.3;
    }

    .luxury-item-description {
        color: var(--steel-mist);
        font-size: 0.9rem;
        margin-bottom: 1rem;
        line-height: 1.4;
        flex-grow: 1;
    }

    .luxury-item-details {
        margin-bottom: 1.5rem;
    }

    .luxury-item-price {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .luxury-price-label {
        color: var(--steel-mist);
        font-size: 0.85rem;
    }

    .luxury-price-value {
        color: var(--royal-gold);
        font-weight: 600;
        font-size: 1rem;
    }

    .luxury-current-bid {
        color: var(--golden-oak);
        font-size: 1.1rem;
    }

    .luxury-item-bids, .luxury-item-timer {
        color: var(--steel-mist);
        font-size: 0.85rem;
        margin-bottom: 0.25rem;
    }

    .luxury-item-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: auto;
    }

    .luxury-btn-sm {
        padding: 0.4rem 0.8rem;
        font-size: 0.8rem;
        border-radius: 20px;
    }

    .luxury-btn-outline {
        background: transparent;
        color: var(--royal-gold);
        border: 1px solid var(--royal-gold);
    }

    .luxury-btn-outline:hover {
        background: var(--royal-gold);
        color: var(--matte-charcoal);
        text-decoration: none;
    }

    .luxury-btn-danger {
        background: #dc3545;
        color: white;
        border: 1px solid #dc3545;
    }

    .luxury-btn-danger:hover {
        background: #c82333;
        border-color: #c82333;
    }

    /* Pagination Styling */
    .luxury-pagination .page-link {
        background-color: var(--matte-charcoal);
        border-color: var(--border-color);
        color: var(--royal-gold);
        padding: 0.5rem 0.75rem;
        margin: 0 0.125rem;
        border-radius: 8px;
    }

    .luxury-pagination .page-link:hover {
        background-color: var(--royal-gold);
        border-color: var(--royal-gold);
        color: var(--matte-charcoal);
    }

    .luxury-pagination .page-item.active .page-link {
        background-color: var(--royal-gold);
        border-color: var(--royal-gold);
        color: var(--matte-charcoal);
    }

    /* Modal Styling */
    .luxury-modal .modal-content {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 15px;
    }

    .luxury-modal .modal-header {
        border-bottom: 1px solid var(--border-color);
        background: linear-gradient(135deg, var(--walnut-brown), var(--matte-charcoal));
    }

    .luxury-modal .modal-title {
        color: var(--text-light);
    }

    .luxury-modal .modal-body {
        color: var(--text-light);
    }

    .luxury-modal .modal-footer {
        border-top: 1px solid var(--border-color);
        background-color: var(--matte-charcoal);
    }

    /* Utility Classes */
    .luxury-d-flex { display: flex; }
    .luxury-justify-between { justify-content: space-between; }
    .luxury-justify-center { justify-content: center; }
    .luxury-align-center { align-items: center; }
    .luxury-flex-wrap { flex-wrap: wrap; }
    .luxury-text-center { text-align: center; }
    .luxury-mb-0 { margin-bottom: 0; }
    .luxury-mb-2 { margin-bottom: 0.5rem; }
    .luxury-me-2 { margin-right: 0.5rem; }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .luxury-header-content {
            flex-direction: column;
            text-align: center;
        }
        
        .luxury-header h2 {
            font-size: 2rem;
            margin-bottom: 1rem;
        }
        
        .luxury-btn {
            width: 100%;
            margin-bottom: 0.5rem;
        }
        
        .luxury-filter-card {
            padding: 1rem;
        }
        
        .luxury-filter-group {
            justify-content: center;
        }
    }

    @@media (max-width: 576px) {
        .luxury-container {
            padding: 1rem 10px;
        }
        
        .luxury-header {
            padding: 1.5rem 1rem;
        }
        
        .luxury-header h2 {
            font-size: 1.75rem;
        }
        
        .luxury-btn {
            font-size: 0.85rem;
            padding: 0.6rem 1rem;
        }
        
        .luxury-filter-btn {
            font-size: 0.8rem;
            padding: 0.4rem 1rem;
        }
    }
</style>

<div class="luxury-container">
    <!-- Header -->
    <div class="luxury-header">
        <div class="luxury-header-content">
            <div>
                <h2 class="luxury-mb-2">My Items</h2>
                <p class="luxury-mb-0">Manage your auction listings and track their performance</p>
            </div>
            <div>
                <a href="@Url.Action("Create")" class="luxury-btn luxury-btn-primary luxury-btn-lg">
                    <i class="fas fa-plus luxury-me-2"></i>Add New Item
                </a>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="luxury-filter-card">
        <div class="luxury-d-flex luxury-justify-between luxury-align-center luxury-flex-wrap">
            <div class="luxury-filter-group">
                <a href="@Url.Action("MyItems", new { status = "all" })" 
                   class="luxury-filter-btn @(Model.StatusFilter == "all" ? "luxury-filter-btn-active" : "luxury-filter-btn-outline")">
                    All Items <span class="luxury-badge-count">@Model.TotalItems</span>
                </a>
                <a href="@Url.Action("MyItems", new { status = "active" })" 
                   class="luxury-filter-btn @(Model.StatusFilter == "active" ? "luxury-filter-btn-active" : "luxury-filter-btn-outline")">
                    Active
                </a>
                <a href="@Url.Action("MyItems", new { status = "pending" })" 
                   class="luxury-filter-btn @(Model.StatusFilter == "pending" ? "luxury-filter-btn-active" : "luxury-filter-btn-outline")">
                    Pending
                </a>
                <a href="@Url.Action("MyItems", new { status = "sold" })" 
                   class="luxury-filter-btn @(Model.StatusFilter == "sold" ? "luxury-filter-btn-active" : "luxury-filter-btn-outline")">
                    Sold
                </a>
                <a href="@Url.Action("MyItems", new { status = "expired" })" 
                   class="luxury-filter-btn @(Model.StatusFilter == "expired" ? "luxury-filter-btn-active" : "luxury-filter-btn-outline")">
                    Expired
                </a>
            </div>
            <div class="luxury-d-flex luxury-align-center luxury-flex-wrap">
                <label for="sortSelect" class="luxury-form-label">Sort by:</label>
                <select id="sortSelect" class="luxury-form-select" onchange="location = this.value;">
                    <option value="@Url.Action("MyItems", new { status = Model.StatusFilter, sort = "newest" })">Newest First</option>
                    <option value="@Url.Action("MyItems", new { status = Model.StatusFilter, sort = "oldest" })">Oldest First</option>
                    <option value="@Url.Action("MyItems", new { status = Model.StatusFilter, sort = "price-high" })">Highest Price</option>
                    <option value="@Url.Action("MyItems", new { status = Model.StatusFilter, sort = "price-low" })">Lowest Price</option>
                    <option value="@Url.Action("MyItems", new { status = Model.StatusFilter, sort = "ending" })">Ending Soon</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Items Grid or Empty State -->
    @if (!Model.Items.Any())
    {
        <!-- Empty State -->
        <div class="luxury-empty-state">
            <i class="fas fa-box-open luxury-empty-icon"></i>
            <h4 class="luxury-empty-title">No Items Found</h4>
            @if (Model.StatusFilter == "all")
            {
                <p class="luxury-empty-text">You haven't created any listings yet. Let's get started!</p>
                <a href="@Url.Action("Create")" class="luxury-btn luxury-btn-primary luxury-btn-lg">
                    <i class="fas fa-plus luxury-me-2"></i>Create Your First Listing
                </a>
            }
            else
            {
                <p class="luxury-empty-text">No items found with status: <span style="color: var(--royal-gold); font-weight: 600;">@GetStatusText(Model.StatusFilter)</span></p>
                <a href="@Url.Action("MyItems", new { status = "all" })" class="luxury-btn luxury-btn-primary luxury-btn-lg">
                    <i class="fas fa-boxes luxury-me-2"></i>View All Items
                </a>
            }
        </div>
    }
    else
    {
        <!-- Items Grid -->
        <div class="row">
            @foreach (var item in Model.Items)
            {
                <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                    <div class="luxury-item-card">
                        <div class="luxury-item-image">
                            @if (item.Images.Any())
                            {
                                <img src="@item.Images.First().ImagePath" alt="@item.Name" class="luxury-item-img">
                            }
                            else
                            {
                                <div class="luxury-no-image">
                                    <i class="fas fa-image"></i>
                                    <span>No Image</span>
                                </div>
                            }
                            <div class="luxury-item-status">
                                <span class="badge @GetStatusBadgeClass(item.Status)">@GetStatusText(item.Status)</span>
                            </div>
                        </div>
                        <div class="luxury-item-content">
                            <h5 class="luxury-item-title">@item.Name</h5>
                            <p class="luxury-item-description">@(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)</p>
                            
                            <div class="luxury-item-details">
                                <div class="luxury-item-price">
                                    <span class="luxury-price-label">Starting Bid:</span>
                                    <span class="luxury-price-value">$@item.MinimumBid.ToString("N2")</span>
                                </div>
                                @if (item.CurrentBid.HasValue)
                                {
                                    <div class="luxury-item-price">
                                        <span class="luxury-price-label">Current Bid:</span>
                                        <span class="luxury-price-value luxury-current-bid">$@item.CurrentBid.Value.ToString("N2")</span>
                                    </div>
                                }
                                <div class="luxury-item-bids">
                                    <i class="fas fa-gavel luxury-me-2"></i>@item.BidCount Bid@(item.BidCount != 1 ? "s" : "")
                                </div>
                                @if (item.Status == "A")
                                {
                                    <div class="luxury-item-timer">
                                        <i class="fas fa-clock luxury-me-2"></i>
                                        <span id="timer-@item.ItemId" class="text-warning">Calculating...</span>
                                    </div>
                                }
                            </div>
                            
                            <div class="luxury-item-actions">
                                <a href="@Url.Action("Details", "Auction", new { id = item.ItemId })" class="luxury-btn luxury-btn-outline luxury-btn-sm">
                                    <i class="fas fa-eye luxury-me-2"></i>View
                                </a>
                                @if (item.Status == "P")
                                {
                                    <a href="@Url.Action("Edit", new { id = item.ItemId })" class="luxury-btn luxury-btn-outline luxury-btn-sm">
                                        <i class="fas fa-edit luxury-me-2"></i>Edit
                                    </a>
                                }
                                @if (item.Status == "A")
                                {
                                    <button type="button" class="luxury-btn luxury-btn-outline luxury-btn-sm" onclick="expireAuction(@item.ItemId, '@item.Name')">
                                        <i class="fas fa-stop luxury-me-2"></i>End Now
                                    </button>
                                }
                                @if (item.Status == "P" || (item.Status == "A" && item.BidCount == 0))
                                {
                                    <button type="button" class="luxury-btn luxury-btn-danger luxury-btn-sm" onclick="deleteItem(@item.ItemId, '@item.Name')">
                                        <i class="fas fa-trash luxury-me-2"></i>Delete
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Items pagination" class="mt-4">
                <ul class="pagination justify-content-center luxury-pagination">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link luxury-page-link" href="@Url.Action("MyItems", new { status = Model.StatusFilter, page = Model.CurrentPage - 1 })">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                    }
                    
                    @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link luxury-page-link" href="@Url.Action("MyItems", new { status = Model.StatusFilter, page = i })">@i</a>
                        </li>
                    }
                    
                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link luxury-page-link" href="@Url.Action("MyItems", new { status = Model.StatusFilter, page = Model.CurrentPage + 1 })">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content luxury-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete "<span id="deleteItemName"></span>"?</p>
                    <p class="text-warning"><i class="fas fa-exclamation-triangle"></i> This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form id="deleteForm" method="post" style="display: inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Delete Item</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Expire Auction Modal -->
    <div class="modal fade" id="expireModal" tabindex="-1" aria-labelledby="expireModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content luxury-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="expireModalLabel">End Auction Early</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to end "<span id="expireItemName"></span>" auction early?</p>
                    <p class="text-info"><i class="fas fa-info-circle"></i> This will immediately process the auction and determine the winner if there are bids.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form id="expireForm" method="post" style="display: inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning">End Auction</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "A" => "bg-success",
            "P" => "bg-warning text-dark",
            "S" => "bg-info",
            "E" => "bg-secondary",
            _ => "bg-dark"
        };
    }

    private string GetStatusText(string status)
    {
        return status switch
        {
            "A" => "Active",
            "P" => "Pending",
            "S" => "Sold",
            "E" => "Expired",
            _ => "Unknown"
        };
    }
}

@section Scripts {
    <script>
        // Timer functionality for active items
        var activeItems = [
            @foreach (var item in Model.Items.Where(i => i.Status == "A"))
            {
                <text>{
                    itemId: '@item.ItemId',
                    endDate: '@item.EndDate.ToString("yyyy-MM-ddTHH:mm:ssZ")'
                }@(Model.Items.Where(i => i.Status == "A").Last() != item ? "," : "")</text>
            }
        ];

        function updateTimers() {
            activeItems.forEach(function(item) {
                var endTime = new Date(item.endDate);
                var now = new Date();
                var timeLeft = endTime - now;
                
                var timerElement = document.getElementById('timer-' + item.itemId);
                if (timerElement) {
                    if (timeLeft <= 0) {
                        timerElement.textContent = 'Ended';
                        timerElement.classList.remove('text-warning');
                        timerElement.classList.add('text-danger');
                    } else {
                        var days = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
                        var hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        var minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                        
                        var display = '';
                        if (days > 0) display += days + 'd ';
                        if (hours > 0) display += hours + 'h ';
                        display += minutes + 'm left';
                        
                        timerElement.textContent = display.trim();
                    }
                }
            });
        }

        // Delete item functionality
        function deleteItem(itemId, itemName) {
            document.getElementById('deleteItemName').textContent = itemName;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + itemId;
            
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModal.show();
        }

        // Expire auction functionality
        function expireAuction(itemId, itemName) {
            document.getElementById('expireItemName').textContent = itemName;
            document.getElementById('expireForm').action = '@Url.Action("ExpireAuction")/' + itemId;
            
            var expireModal = new bootstrap.Modal(document.getElementById('expireModal'));
            expireModal.show();
        }

        // Initialize timers
        updateTimers();
        setInterval(updateTimers, 60000); // Update every minute

        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
          return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
}
