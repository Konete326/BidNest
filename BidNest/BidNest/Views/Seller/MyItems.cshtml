@model BidNest.ViewModels.SellerItemsViewModel
@{
    ViewData["Title"] = "My Items";
}

<style>
    :root {
        --walnut-brown: #5C4033;
        --golden-oak: #C19A6B;
        --royal-gold: #D4AF37;
        --steel-mist: #A2B0BF;
        --matte-charcoal: #2B2B2B;
        --text-light: #f8f9fa;
        --text-muted: #A2B0BF;
        --bg-dark: #000000;
        --card-bg: #1a1a1a;
        --border-color: rgba(196, 154, 107, 0.2);
    }

    /* Global Styling */
    body {
        background-color: var(--bg-dark) !important;
        color: var(--text-light);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .luxury-container {
        width: 100%;
        max-width: 1400px;
        padding: 2rem 15px;
        margin: 0 auto;
        background-color: var(--bg-dark);
        min-height: 100vh;
    }

    /* Header Styling */
    .luxury-header {
        background: linear-gradient(135deg, var(--walnut-brown) 0%, var(--matte-charcoal) 35%, var(--golden-oak) 70%, var(--royal-gold) 100%);
        background-size: 400% 400%;
        animation: luxuryGradientShift 20s ease infinite;
        border-radius: 15px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.5);
        border: 1px solid var(--border-color);
        position: relative;
        overflow: hidden;
        padding: 2rem;
        margin-bottom: 2rem;
    }

    @@keyframes luxuryGradientShift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .luxury-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: url('data:image/svg+xml;utf8,<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="8" fill="%23D4AF37" opacity="0.1"/><circle cx="80" cy="40" r="12" fill="%23C19A6B" opacity="0.1"/><circle cx="50" cy="80" r="10" fill="%23D4AF37" opacity="0.1"/></svg>') repeat;
        background-size: 150px;
        opacity: 0.6;
        animation: moveBubbles 30s linear infinite;
        z-index: 0;
    }

    @@keyframes moveBubbles {
        from { background-position: 0 0; }
        to { background-position: 100% 100%; }
    }

    .luxury-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        z-index: 1;
    }

    .luxury-header h2 {
        font-weight: 700;
        font-size: 2.5rem;
        letter-spacing: -0.02rem;
        color: var(--text-light);
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        margin-bottom: 0.5rem;
    }

    .luxury-header p {
        font-size: 1.1rem;
        opacity: 0.9;
        color: var(--text-light);
        margin-bottom: 0;
    }

    /* Button Styling */
    .luxury-btn {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        border-radius: 25px;
        text-decoration: none;
        text-align: center;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: none;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.5px;
        position: relative;
        overflow: hidden;
        margin: 0.25rem;
    }

    .luxury-btn-primary {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        color: var(--matte-charcoal);
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    }

    .luxury-btn-primary::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.5s;
    }

    .luxury-btn-primary:hover::before {
        left: 100%;
    }

    .luxury-btn-primary:hover {
        background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
        color: var(--text-light);
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
        text-decoration: none;
    }

    .luxury-btn-lg {
        padding: 1rem 2rem;
        font-size: 1.1rem;
    }

    /* Filter Card */
    .luxury-filter-card {
        background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
        border: 1px solid var(--border-color);
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
        margin-bottom: 2rem;
        padding: 1.5rem;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .luxury-filter-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(212, 175, 55, 0.15);
        border-color: var(--golden-oak);
    }

    /* Filter Buttons */
    .luxury-filter-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .luxury-filter-btn {
        padding: 0.5rem 1.25rem;
        border-radius: 25px;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        border: 2px solid transparent;
        position: relative;
        overflow: hidden;
    }

    .luxury-filter-btn-outline {
        background: transparent;
        color: var(--royal-gold);
        border-color: var(--royal-gold);
    }

    .luxury-filter-btn-outline:hover {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        color: var(--matte-charcoal);
        text-decoration: none;
        transform: translateY(-1px);
    }

    .luxury-filter-btn-active {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        color: var(--matte-charcoal);
        border-color: var(--golden-oak);
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    }

    .luxury-badge-count {
        background: rgba(43, 43, 43, 0.9);
        color: var(--royal-gold);
        padding: 0.2rem 0.5rem;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-left: 0.5rem;
    }

    /* Form Select */
    .luxury-form-select {
        background-color: var(--matte-charcoal);
        border: 2px solid var(--border-color);
        border-radius: 8px;
        color: var(--text-light);
        padding: 0.5rem 2.5rem 0.5rem 1rem;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23C19A6B' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 0.75rem center;
        background-size: 16px 12px;
    }

    .luxury-form-select:focus {
        background-color: var(--matte-charcoal);
        border-color: var(--royal-gold);
        box-shadow: 0 0 0 0.2rem rgba(212, 175, 55, 0.25);
        color: var(--text-light);
        outline: none;
    }

    .luxury-form-label {
        color: var(--golden-oak);
        font-weight: 600;
        margin-right: 0.5rem;
        font-size: 0.9rem;
    }

    /* Empty State */
    .luxury-empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
        border: 2px dashed var(--border-color);
        margin-top: 2rem;
    }

    .luxury-empty-icon {
        font-size: 4rem;
        color: var(--steel-mist);
        opacity: 0.6;
        margin-bottom: 1.5rem;
    }

    .luxury-empty-title {
        color: var(--text-light);
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .luxury-empty-text {
        color: var(--steel-mist);
        font-size: 1.1rem;
        margin-bottom: 2rem;
    }

    /* Utility Classes */
    .luxury-d-flex { display: flex; }
    .luxury-justify-between { justify-content: space-between; }
    .luxury-justify-center { justify-content: center; }
    .luxury-align-center { align-items: center; }
    .luxury-flex-wrap { flex-wrap: wrap; }
    .luxury-text-center { text-align: center; }
    .luxury-mb-0 { margin-bottom: 0; }
    .luxury-mb-2 { margin-bottom: 0.5rem; }
    .luxury-me-2 { margin-right: 0.5rem; }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .luxury-header-content {
            flex-direction: column;
            text-align: center;
        }
        
        .luxury-header h2 {
            font-size: 2rem;
            margin-bottom: 1rem;
        }
        
        .luxury-btn {
            width: 100%;
            margin-bottom: 0.5rem;
        }
        
        .luxury-filter-card {
            padding: 1rem;
        }
        
        .luxury-filter-group {
            justify-content: center;
        }
    }

    @@media (max-width: 576px) {
        .luxury-container {
            padding: 1rem 10px;
        }
        
        .luxury-header {
            padding: 1.5rem 1rem;
        }
        
        .luxury-header h2 {
            font-size: 1.75rem;
        }
        
        .luxury-btn {
            font-size: 0.85rem;
            padding: 0.6rem 1rem;
        }
        
        .luxury-filter-btn {
            font-size: 0.8rem;
            padding: 0.4rem 1rem;
        }
    }
</style>

<div class="luxury-container">
    <!-- Header -->
    <div class="luxury-header">
        <div class="luxury-header-content">
            <div>
                <h2 class="luxury-mb-2">My Items</h2>
                <p class="luxury-mb-0">Manage your auction listings and track their performance</p>
            </div>
            <div>
                <a href="@Url.Action("Create")" class="luxury-btn luxury-btn-primary luxury-btn-lg">
                    <i class="fas fa-plus luxury-me-2"></i>Add New Item
                </a>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="luxury-filter-card">
        <div class="luxury-d-flex luxury-justify-between luxury-align-center luxury-flex-wrap">
            <div class="luxury-filter-group">
                <a href="@Url.Action("MyItems", new { status = "all" })" 
                   class="luxury-filter-btn @(Model.StatusFilter == "all" ? "luxury-filter-btn-active" : "luxury-filter-btn-outline")">
                    All Items <span class="luxury-badge-count">@Model.TotalItems</span>
                </a>
                <a href="@Url.Action("MyItems", new { status = "active" })" 
                   class="luxury-filter-btn @(Model.StatusFilter == "active" ? "luxury-filter-btn-active" : "luxury-filter-btn-outline")">
                    Active
                </a>
                <a href="@Url.Action("MyItems", new { status = "pending" })" 
                   class="luxury-filter-btn @(Model.StatusFilter == "pending" ? "luxury-filter-btn-active" : "luxury-filter-btn-outline")">
                    Pending
                </a>
                <a href="@Url.Action("MyItems", new { status = "sold" })" 
                   class="luxury-filter-btn @(Model.StatusFilter == "sold" ? "luxury-filter-btn-active" : "luxury-filter-btn-outline")">
                    Sold
                </a>
                <a href="@Url.Action("MyItems", new { status = "expired" })" 
                   class="luxury-filter-btn @(Model.StatusFilter == "expired" ? "luxury-filter-btn-active" : "luxury-filter-btn-outline")">
                    Expired
                </a>
            </div>
            <div class="luxury-d-flex luxury-align-center luxury-flex-wrap">
                <label for="sortSelect" class="luxury-form-label">Sort by:</label>
                <select id="sortSelect" class="luxury-form-select" onchange="location = this.value;">
                    <option value="@Url.Action("MyItems", new { status = Model.StatusFilter, sort = "newest" })">Newest First</option>
                    <option value="@Url.Action("MyItems", new { status = Model.StatusFilter, sort = "oldest" })">Oldest First</option>
                    <option value="@Url.Action("MyItems", new { status = Model.StatusFilter, sort = "price-high" })">Highest Price</option>
                    <option value="@Url.Action("MyItems", new { status = Model.StatusFilter, sort = "price-low" })">Lowest Price</option>
                    <option value="@Url.Action("MyItems", new { status = Model.StatusFilter, sort = "ending" })">Ending Soon</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Items Grid or Empty State -->
    @if (!Model.Items.Any())
    {
        <!-- Empty State -->
        <div class="luxury-empty-state">
            <i class="fas fa-box-open luxury-empty-icon"></i>
            <h4 class="luxury-empty-title">No Items Found</h4>
            @if (Model.StatusFilter == "all")
            {
                <p class="luxury-empty-text">You haven't created any listings yet. Let's get started!</p>
                <a href="@Url.Action("Create")" class="luxury-btn luxury-btn-primary luxury-btn-lg">
                    <i class="fas fa-plus luxury-me-2"></i>Create Your First Listing
                </a>
            }
            else
            {
                <p class="luxury-empty-text">No items found with status: <span style="color: var(--royal-gold); font-weight: 600;">@GetStatusText(Model.StatusFilter)</span></p>
                <a href="@Url.Action("MyItems", new { status = "all" })" class="luxury-btn luxury-btn-primary luxury-btn-lg">
                    <i class="fas fa-boxes luxury-me-2"></i>View All Items
                </a>
            }
        </div>
    }
</div>

@functions {
    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "A" => "bg-success",
            "P" => "bg-warning text-dark",
            "S" => "bg-info",
            "E" => "bg-secondary",
            _ => "bg-dark"
        };
    }

    private string GetStatusText(string status)
    {
        return status switch
        {
            "A" => "Active",
            "P" => "Pending",
            "S" => "Sold",
            "E" => "Expired",
            _ => "Unknown"
        };
    }
}

@section Scripts {
    <script>
        // Timer functionality for active items
        var activeItems = [
            @foreach (var item in Model.Items.Where(i => i.Status == "A"))
            {
                <text>{
                    itemId: '@item.ItemId',
                    endDate: '@item.EndDate.ToString("yyyy-MM-ddTHH:mm:ssZ")'
                }@(Model.Items.Where(i => i.Status == "A").Last() != item ? "," : "")</text>
            }
        ];

        function updateTimers() {
            activeItems.forEach(function(item) {
                var endTime = new Date(item.endDate);
                var now = new Date();
                var timeLeft = endTime - now;
                
                var timerElement = document.getElementById('timer-' + item.itemId);
                if (timerElement) {
                    if (timeLeft <= 0) {
                        timerElement.textContent = 'Ended';
                        timerElement.classList.remove('text-warning');
                        timerElement.classList.add('text-danger');
                    } else {
                        var days = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
                        var hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        var minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                        
                        var display = '';
                        if (days > 0) display += days + 'd ';
                        if (hours > 0) display += hours + 'h ';
                        display += minutes + 'm left';
                        
                        timerElement.textContent = display.trim();
                    }
                }
            });
        }

        // Delete item functionality
        function deleteItem(itemId, itemName) {
            document.getElementById('deleteItemName').textContent = itemName;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + itemId;
            
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModal.show();
        }

        // Initialize timers
        updateTimers();
        setInterval(updateTimers, 60000); // Update every minute

        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
          return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
}
