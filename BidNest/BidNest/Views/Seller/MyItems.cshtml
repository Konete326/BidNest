@model BidNest.ViewModels.SellerItemsViewModel
@{
    ViewData["Title"] = "My Items";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-1">My Items</h2>
                    <p class="text-muted">Manage your auction listings</p>
                </div>
                <div>
                    <a href="@Url.Action("Create")" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>Add New Item
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="btn-group" role="group">
                        <a href="@Url.Action("MyItems", new { status = "all" })" 
                           class="btn @(Model.StatusFilter == "all" ? "btn-primary" : "btn-outline-primary")">
                            All Items (@Model.TotalItems)
                        </a>
                        <a href="@Url.Action("MyItems", new { status = "active" })" 
                           class="btn @(Model.StatusFilter == "active" ? "btn-success" : "btn-outline-success")">
                            Active
                        </a>
                        <a href="@Url.Action("MyItems", new { status = "pending" })" 
                           class="btn @(Model.StatusFilter == "pending" ? "btn-warning" : "btn-outline-warning")">
                            Pending
                        </a>
                        <a href="@Url.Action("MyItems", new { status = "sold" })" 
                           class="btn @(Model.StatusFilter == "sold" ? "btn-info" : "btn-outline-info")">
                            Sold
                        </a>
                        <a href="@Url.Action("MyItems", new { status = "expired" })" 
                           class="btn @(Model.StatusFilter == "expired" ? "btn-secondary" : "btn-outline-secondary")">
                            Expired
                        </a>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <div class="d-flex justify-content-end align-items-center">
                        <label class="me-2">Sort by:</label>
                        <select class="form-select" style="width: auto;" onchange="location = this.value;">
                            <option value="@Url.Action("MyItems", new { status = Model.StatusFilter, sort = "newest" })">Newest First</option>
                            <option value="@Url.Action("MyItems", new { status = Model.StatusFilter, sort = "oldest" })">Oldest First</option>
                            <option value="@Url.Action("MyItems", new { status = Model.StatusFilter, sort = "price-high" })">Highest Price</option>
                            <option value="@Url.Action("MyItems", new { status = Model.StatusFilter, sort = "price-low" })">Lowest Price</option>
                            <option value="@Url.Action("MyItems", new { status = Model.StatusFilter, sort = "ending" })">Ending Soon</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Items Grid -->
    @if (Model.Items.Any())
    {
        <div class="row">
            @foreach (var item in Model.Items)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 item-card">
                        <!-- Image -->
                        <div class="position-relative">
                            @if (item.Images.Any())
                            {
                                <img src="@item.Images.First().ImagePath" alt="@item.Name" 
                                     class="card-img-top" style="height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" 
                                     style="height: 200px;">
                                    <i class="fas fa-image fa-3x text-muted"></i>
                                </div>
                            }
                            
                            <!-- Status Badge -->
                            <span class="position-absolute top-0 end-0 m-2 badge @GetStatusBadgeClass(item.Status)">
                                @GetStatusText(item.Status)
                            </span>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title">@item.Name</h6>
                            <p class="card-text text-muted small">@item.CategoryName</p>
                            
                            <!-- Pricing Info -->
                            <div class="mb-2">
                                @if (item.Status == "A") // Active
                                {
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted small">Current Bid:</span>
                                        <span class="fw-bold text-success">$@((item.CurrentBid ?? item.MinimumBid).ToString("N2"))</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted small">Bids:</span>
                                        <span class="badge bg-primary">@item.BidCount</span>
                                    </div>
                                }
                                else if (item.Status == "S") // Sold
                                {
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted small">Sold for:</span>
                                        <span class="fw-bold text-success">$@((item.CurrentBid ?? item.MinimumBid).ToString("N2"))</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted small">Starting Bid:</span>
                                        <span class="fw-bold">$@item.MinimumBid.ToString("N2")</span>
                                    </div>
                                }
                            </div>

                            <!-- Time Info -->
                            <div class="mb-3">
                                @if (item.Status == "A")
                                {
                                    <small class="text-warning">
                                        <i class="fas fa-clock me-1"></i>
                                        <span id="timer-@item.ItemId">Calculating...</span>
                                    </small>
                                }
                                else if (item.Status == "P")
                                {
                                    <small class="text-muted">
                                        <i class="fas fa-clock me-1"></i>
                                        Submitted @item.CreatedAt.ToString("MMM dd, yyyy")
                                    </small>
                                }
                                else if (item.Status == "S")
                                {
                                    <small class="text-success">
                                        <i class="fas fa-check me-1"></i>
                                        Sold @item.EndDate.ToString("MMM dd, yyyy")
                                    </small>
                                }
                                else
                                {
                                    <small class="text-muted">
                                        <i class="fas fa-calendar me-1"></i>
                                        Ended @item.EndDate.ToString("MMM dd, yyyy")
                                    </small>
                                }
                            </div>

                            <!-- Actions -->
                            <div class="mt-auto">
                                <div class="d-flex gap-2">
                                    <a href="@Url.Action("Details", "Auction", new { id = item.ItemId })" 
                                       class="btn btn-sm btn-outline-primary flex-fill">
                                        <i class="fas fa-eye me-1"></i>View
                                    </a>
                                    
                                    @if (item.Status == "P") // Pending - can edit
                                    {
                                        <a href="@Url.Action("Edit", new { id = item.ItemId })" 
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" 
                                                onclick="deleteItem(@item.ItemId, '@item.Name')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                    else if (item.Status == "A" && item.BidCount == 0) // Active with no bids - can delete
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" 
                                                onclick="deleteItem(@item.ItemId, '@item.Name')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                    else if (item.Status == "A") // Active with bids - show analytics
                                    {
                                        <a href="@Url.Action("Analytics", new { itemId = item.ItemId })" 
                                           class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-chart-line"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Items pagination">
                <ul class="pagination justify-content-center">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("MyItems", new { status = Model.StatusFilter, page = Model.CurrentPage - 1 })">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                    }

                    @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("MyItems", new { status = Model.StatusFilter, page = i })">@i</a>
                        </li>
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("MyItems", new { status = Model.StatusFilter, page = Model.CurrentPage + 1 })">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5">
            <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">No Items Found</h4>
            @if (Model.StatusFilter == "all")
            {
                <p class="text-muted">You haven't created any listings yet.</p>
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i>Create Your First Listing
                </a>
            }
            else
            {
                <p class="text-muted">No items found with status: @Model.StatusFilter</p>
                <a href="@Url.Action("MyItems", new { status = "all" })" class="btn btn-outline-primary">
                    View All Items
                </a>
            }
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete "<span id="deleteItemName"></span>"?</p>
                <p class="text-danger small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete Item</button>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "A" => "bg-success",
            "P" => "bg-warning",
            "S" => "bg-info",
            "E" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private string GetStatusText(string status)
    {
        return status switch
        {
            "A" => "Active",
            "P" => "Pending",
            "S" => "Sold",
            "E" => "Expired",
            _ => "Unknown"
        };
    }
}

@section Scripts {
    <script>
        // Timer functionality for active items
        var activeItems = [
            @foreach (var item in Model.Items.Where(i => i.Status == "A"))
            {
                <text>{
                    itemId: '@item.ItemId',
                    endDate: '@item.EndDate.ToString("yyyy-MM-ddTHH:mm:ssZ")'
                }@(Model.Items.Where(i => i.Status == "A").Last() != item ? "," : "")</text>
            }
        ];

        function updateTimers() {
            activeItems.forEach(function(item) {
                var endTime = new Date(item.endDate);
                var now = new Date();
                var timeLeft = endTime - now;
                
                var timerElement = document.getElementById('timer-' + item.itemId);
                if (timerElement) {
                    if (timeLeft <= 0) {
                        timerElement.textContent = 'Ended';
                        timerElement.className = 'text-danger';
                    } else {
                        var days = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
                        var hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        var minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                        
                        var display = '';
                        if (days > 0) display += days + 'd ';
                        if (hours > 0) display += hours + 'h ';
                        display += minutes + 'm left';
                        
                        timerElement.textContent = display;
                    }
                }
            });
        }

        // Delete item functionality
        function deleteItem(itemId, itemName) {
            document.getElementById('deleteItemName').textContent = itemName;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + itemId;
            
            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        // Initialize timers
        updateTimers();
        setInterval(updateTimers, 60000); // Update every minute
    </script>
}

@section Styles {
    <style>
        .item-card {
            transition: transform 0.2s, box-shadow 0.2s;
        }
        
        .item-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
    </style>
}
