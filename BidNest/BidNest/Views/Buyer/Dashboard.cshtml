@model BidNest.ViewModels.BuyerDashboardViewModel
@{
    ViewData["Title"] = "Buyer Dashboard";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-0">Welcome to Your Dashboard</h2>
            <p class="text-muted">Track your bids, watch auctions, and discover new items</p>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Active Bids</h5>
                    <h2 class="mb-0">@Model.MyActiveBids.Count</h2>
                    <small>Currently bidding on</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">Winning</h5>
                    <h2 class="mb-0">@Model.MyActiveBids.Count(b => b.IsWinning)</h2>
                    <small>Leading auctions</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h5 class="card-title">Watchlist</h5>
                    <h2 class="mb-0">@Model.WatchlistItems.Count</h2>
                    <small>Items watching</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5 class="card-title">Won Recently</h5>
                    <h2 class="mb-0">@Model.RecentlyWon.Count</h2>
                    <small>Auctions won</small>
                </div>
            </div>
        </div>
    </div>

    <!-- My Active Bids -->
    @if (Model.MyActiveBids.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">My Active Bids</h5>
                        <a href="@Url.Action("MyBids", "Buyer")" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th>Category</th>
                                        <th>My Bid</th>
                                        <th>Current Price</th>
                                        <th>Status</th>
                                        <th>Time Remaining</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var bid in Model.MyActiveBids)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="@bid.ImageUrl" alt="@bid.ItemName" class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                                    <div class="ms-3">
                                                        <a href="@Url.Action("ItemDetails", "Buyer", new { id = bid.ItemId })" class="text-decoration-none">
                                                            @bid.ItemName
                                                        </a>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@bid.CategoryName</td>
                                            <td>$@bid.MyBidAmount.ToString("N2")</td>
                                            <td>$@bid.CurrentPrice.ToString("N2")</td>
                                            <td>
                                                <span class="@bid.StatusClass">@bid.StatusDisplay</span>
                                            </td>
                                            <td>
                                                <span class="@(bid.TimeRemaining.TotalHours < 1 ? "text-danger" : "")">
                                                    @if (bid.TimeRemaining.TotalDays >= 1)
                                                    {
                                                        @($"{(int)bid.TimeRemaining.TotalDays}d {bid.TimeRemaining.Hours}h")
                                                    }
                                                    else if (bid.TimeRemaining.TotalHours >= 1)
                                                    {
                                                        @($"{(int)bid.TimeRemaining.TotalHours}h {bid.TimeRemaining.Minutes}m")
                                                    }
                                                    else
                                                    {
                                                        @($"{(int)bid.TimeRemaining.TotalMinutes}m")
                                                    }
                                                </span>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("ItemDetails", "Buyer", new { id = bid.ItemId })" class="btn btn-sm btn-primary">
                                                    @(bid.IsWinning ? "View" : "Bid Again")
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Featured Auctions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Featured Auctions</h5>
                    <a href="@Url.Action("Browse", "Buyer")" class="btn btn-sm btn-outline-primary">Browse All</a>
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var item in Model.FeaturedAuctions.Take(6))
                        {
                            <div class="col-md-4 col-lg-2 mb-3">
                                <div class="card h-100">
                                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 150px; object-fit: cover;">
                                    <div class="card-body">
                                        <h6 class="card-title text-truncate">
                                            <a href="@Url.Action("ItemDetails", "Buyer", new { id = item.ItemId })" class="text-decoration-none">
                                                @item.Title
                                            </a>
                                        </h6>
                                        <p class="mb-1">
                                            <strong>$@item.CurrentPrice.ToString("N2")</strong>
                                        </p>
                                        <p class="mb-1 small text-muted">@item.BidCount bids</p>
                                        <p class="mb-0 small @item.StatusClass">
                                            @item.TimeRemainingDisplay
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Watchlist Items -->
    @if (Model.WatchlistItems.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Your Watchlist</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var item in Model.WatchlistItems.Take(4))
                            {
                                <div class="col-md-3 mb-3">
                                    <div class="card h-100">
                                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 150px; object-fit: cover;">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <a href="@Url.Action("ItemDetails", "Buyer", new { id = item.ItemId })" class="text-decoration-none">
                                                    @item.Title
                                                </a>
                                            </h6>
                                            <p class="mb-1">
                                                <strong>$@item.CurrentPrice.ToString("N2")</strong>
                                            </p>
                                            <p class="mb-1 small text-muted">@item.BidCount bids</p>
                                            <p class="mb-2 small @item.StatusClass">
                                                @item.TimeRemainingDisplay
                                            </p>
                                            <a href="@Url.Action("ItemDetails", "Buyer", new { id = item.ItemId })" class="btn btn-sm btn-primary w-100">Place Bid</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Recently Won -->
    @if (Model.RecentlyWon.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Recently Won Auctions</h5>
                        <a href="@Url.Action("WonAuctions", "Buyer")" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th>Winning Bid</th>
                                        <th>Won Date</th>
                                        <th>Payment Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.RecentlyWon)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="@item.ImageUrl" alt="@item.ItemName" class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                                    <span class="ms-3">@item.ItemName</span>
                                                </div>
                                            </td>
                                            <td>$@item.WinningBid.ToString("N2")</td>
                                            <td>@item.EndDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <span class="@item.PaymentStatusClass">@item.PaymentStatus</span>
                                            </td>
                                            <td>
                                                @if (item.PaymentStatus == "Pending")
                                                {
                                                    <a href="@Url.Action("Payment", "Buyer", new { itemId = item.ItemId })" class="btn btn-sm btn-success">Pay Now</a>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-secondary" disabled>Paid</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    :root {
        --walnut-brown: #5C4033;
        --golden-oak: #C19A6B;
        --royal-gold: #D4AF37;
        --steel-mist: #A2B0BF;
        --matte-charcoal: #2B2B2B;
        --text-light: #f8f9fa;
        --text-muted: #A2B0BF;
        --bg-dark: #000000;
        --card-bg: #1a1a1a;
        --border-color: rgba(196, 154, 107, 0.2);
        --shadow-luxury: 0 15px 45px rgba(0, 0, 0, 0.5);
        --shadow-hover: 0 20px 60px rgba(212, 175, 55, 0.15);
    }

    /* Global Styling */
    body {
        background-color: var(--bg-dark) !important;
        color: var(--text-light);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        line-height: 1.6;
    }

    .container-fluid {
        background-color: var(--bg-dark);
        min-height: 100vh;
        padding-top: 2rem;
        padding-bottom: 2rem;
    }

    /* Header Styling */
    h2 {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: 700;
        font-size: 2.5rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        animation: fadeInDown 0.8s ease-out;
        margin-bottom: 1rem !important;
    }

    /* Text Colors */
    .text-muted {
        color: var(--steel-mist) !important;
        font-size: 1.1rem;
    }

    /* Card Styling */
    .card {
        background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: var(--shadow-luxury);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        position: relative;
        opacity: 0;
        transform: translateY(30px);
        animation: luxuryFadeInCard 0.8s ease-out forwards;
    }

    .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, var(--royal-gold), var(--golden-oak), var(--walnut-brown));
        z-index: 1;
    }

    .card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-hover);
        border-color: var(--golden-oak);
    }

    /* Staggered animations for cards */
    .row .col-md-3:nth-child(1) .card { animation-delay: 0.1s; }
    .row .col-md-3:nth-child(2) .card { animation-delay: 0.2s; }
    .row .col-md-3:nth-child(3) .card { animation-delay: 0.3s; }
    .row .col-md-3:nth-child(4) .card { animation-delay: 0.4s; }
    .row .col-12 .card { animation-delay: 0.5s; }

    /* Stats Cards Styling */
    .card.bg-primary {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak)) !important;
        color: var(--matte-charcoal) !important;
        border: none;
    }

    .card.bg-success {
        background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown)) !important;
        color: var(--text-light) !important;
        border: none;
    }

    .card.bg-warning {
        background: linear-gradient(135deg, var(--steel-mist), var(--golden-oak)) !important;
        color: var(--matte-charcoal) !important;
        border: none;
    }

    .card.bg-info {
        background: linear-gradient(135deg, var(--walnut-brown), var(--matte-charcoal)) !important;
        color: var(--text-light) !important;
        border: none;
    }

    .card-body {
        background-color: transparent;
        padding: 2rem;
        position: relative;
        z-index: 1;
    }

    .card-title {
        color: inherit;
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 1rem;
    }

    .card h2 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        text-shadow: none;
        background: none;
        -webkit-text-fill-color: inherit;
    }

    .card small {
        opacity: 0.9;
        font-size: 0.9rem;
    }

    /* Card Header Styling */
    .card-header {
        background: linear-gradient(135deg, var(--walnut-brown) 0%, var(--matte-charcoal) 35%, var(--golden-oak) 70%, var(--royal-gold) 100%);
        background-size: 400% 400%;
        animation: luxuryGradientShift 20s ease infinite;
        border: none;
        border-radius: 20px 20px 0 0 !important;
        padding: 1.5rem 2rem;
        position: relative;
        overflow: hidden;
    }

    .card-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: url('data:image/svg+xml;utf8,<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="4" fill="%23D4AF37" opacity="0.1"/><circle cx="80" cy="40" r="6" fill="%23C19A6B" opacity="0.1"/><circle cx="50" cy="80" r="5" fill="%23D4AF37" opacity="0.1"/></svg>') repeat;
        background-size: 120px;
        opacity: 0.4;
        animation: moveBubbles 25s linear infinite;
        z-index: 0;
    }

    .card-header h5 {
        color: var(--text-light);
        font-weight: 700;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        position: relative;
        z-index: 1;
        margin-bottom: 0;
    }

    /* Button Styling */
    .btn-primary {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        color: var(--matte-charcoal);
        border: none;
        border-radius: 25px;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    }

    .btn-primary::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.5s;
    }

    .btn-primary:hover::before {
        left: 100%;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
        color: var(--text-light);
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
    }

    .btn-outline-primary {
        background: transparent;
        color: var(--royal-gold);
        border: 2px solid var(--royal-gold);
        border-radius: 25px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .btn-outline-primary:hover {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        color: var(--matte-charcoal);
        border-color: var(--golden-oak);
        transform: translateY(-3px);
    }

    .btn-success {
        background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
        color: var(--text-light);
        border: none;
        border-radius: 25px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .btn-success:hover {
        background: linear-gradient(135deg, var(--walnut-brown), var(--matte-charcoal));
        transform: translateY(-3px);
    }

    .btn-secondary {
        background: linear-gradient(135deg, var(--steel-mist), var(--matte-charcoal));
        color: var(--text-light);
        border: none;
        border-radius: 25px;
        opacity: 0.7;
    }

    .btn-sm {
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
    }

    /* Table Styling */
    .table {
        color: var(--text-light);
        background-color: transparent;
    }

    .table th {
        color: var(--golden-oak);
        font-weight: 600;
        border-bottom: 2px solid var(--border-color);
        padding: 1rem;
        background: linear-gradient(135deg, var(--matte-charcoal), var(--card-bg));
    }

    .table td {
        border-bottom: 1px solid var(--border-color);
        padding: 1rem;
        vertical-align: middle;
    }

    .table-hover tbody tr:hover {
        background: linear-gradient(135deg, var(--matte-charcoal), var(--card-bg));
        transform: scale(1.01);
        transition: all 0.3s ease;
    }

    .table img {
        border-radius: 10px;
        transition: transform 0.3s ease;
    }

    .table img:hover {
        transform: scale(1.1);
    }

    .table a {
        color: var(--text-light);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s ease;
    }

    .table a:hover {
        color: var(--royal-gold);
    }

    /* Status Classes */
    .text-success {
        color: var(--royal-gold) !important;
        font-weight: 600;
    }

    .text-warning {
        color: var(--golden-oak) !important;
        font-weight: 600;
    }

    .text-danger {
        color: var(--walnut-brown) !important;
        font-weight: 600;
    }

    .text-info {
        color: var(--steel-mist) !important;
        font-weight: 600;
    }

    .text-primary {
        color: var(--royal-gold) !important;
        font-weight: 600;
    }

    /* Badge-like Status Spans */
    .badge, span[class*="badge"] {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        color: var(--matte-charcoal);
        padding: 0.4rem 0.8rem;
        border-radius: 15px;
        font-weight: 500;
        font-size: 0.85rem;
        letter-spacing: 0.3px;
    }

    /* Featured Auction Cards */
    .col-md-4 .card, .col-lg-2 .card, .col-md-3 .card {
        background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
        border: 1px solid var(--border-color);
        border-radius: 15px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
    }

    .col-md-4 .card:hover, .col-lg-2 .card:hover, .col-md-3 .card:hover {
        transform: translateY(-10px);
        box-shadow: var(--shadow-hover);
        border-color: var(--golden-oak);
    }

    .card-img-top {
        transition: transform 0.4s ease;
        border-radius: 15px 15px 0 0;
    }

    .card:hover .card-img-top {
        transform: scale(1.05);
    }

    .card h6 a {
        color: var(--text-light);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.3s ease;
    }

    .card:hover h6 a {
        color: var(--royal-gold);
    }

    .card strong {
        color: var(--royal-gold);
        font-size: 1.1rem;
    }

    /* Price Display */
    .card p strong {
        color: var(--royal-gold);
        font-size: 1.2rem;
        font-weight: 700;
    }

    /* Responsive Table */
    .table-responsive {
        border-radius: 15px;
        background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
        padding: 1rem;
        margin: -1rem;
    }

    /* Animations */
    @@keyframes luxuryFadeInCard {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes luxuryGradientShift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    @@keyframes moveBubbles {
        from { background-position: 0 0; }
        to { background-position: 100% 100%; }
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .container-fluid {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }
        
        h2 {
            font-size: 2rem;
        }
        
        .card-body {
            padding: 1.5rem;
        }
        
        .card-header {
            padding: 1rem 1.5rem;
        }
        
        .btn {
            width: 100%;
            margin-bottom: 0.5rem;
        }
        
        .table th, .table td {
            padding: 0.75rem 0.5rem;
            font-size: 0.9rem;
        }
    }

    @@media (max-width: 576px) {
        h2 {
            font-size: 1.5rem;
        }
        
        .card {
            border-radius: 15px;
            margin: 0 0.5rem;
        }
        
        .card-body {
            padding: 1rem;
        }
        
        .card-header {
            border-radius: 15px 15px 0 0 !important;
            padding: 1rem;
        }
        
        .btn-sm {
            font-size: 0.75rem;
            padding: 0.4rem 0.8rem;
        }
        
        .table-responsive {
            font-size: 0.85rem;
        }
    }
</style>
