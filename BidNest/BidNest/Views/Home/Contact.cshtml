@{
    ViewData["Title"] = "Contact Us";
}

<style>
    :root {
        --walnut-brown: #5C4033;
        --golden-oak: #C19A6B;
        --royal-gold: #D4AF37;
        --steel-mist: #A2B0BF;
        --matte-charcoal: #2B2B2B;
        --text-dark: #f8f9fa;
        --text-light: #f8f9fa;
        --text-muted: #A2B0BF;
        --bg-light: #000000;
        --bg-dark: #000000;
        --card-bg: #1a1a1a;
        --border-color: rgba(196, 154, 107, 0.2);
    }
    /* Custom styles for luxury look */
    body {
        font-family: 'Poppins', sans-serif;
        background-color: var(--bg-dark);
        color: var(--text-light);
    }

    /* Updated Hero Section for Contact Page */
    .hero-section {
        background: linear-gradient(135deg, var(--walnut-brown) 0%, var(--matte-charcoal) 35%, var(--golden-oak) 70%, var(--royal-gold) 100%);
        background-size: 400% 400%;
        animation: luxuryGradientShift 20s ease infinite;
        position: relative;
        overflow: hidden;
        color: var(--text-light);
        padding: 80px 0;
        text-align: center;
        border-bottom-left-radius: 30% 15%;
        border-bottom-right-radius: 30% 15%;
        z-index: 0;
        box-shadow: inset 0 0 100px rgba(0, 0, 0, 0.3);
    }

    @@keyframes luxuryGradientShift {
        0% { background-position: 0% 50%; }
        25% { background-position: 100% 25%; }
        50% { background-position: 100% 75%; }
        75% { background-position: 0% 100%; }
        100% { background-position: 0% 50%; }
    }

    .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: url('data:image/svg+xml;utf8,<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="8" fill="%23D4AF37" opacity="0.08"/><circle cx="80" cy="40" r="12" fill="%23C19A6B" opacity="0.06"/><circle cx="50" cy="80" r="10" fill="%23D4AF37" opacity="0.05"/><circle cx="30" cy="70" r="6" fill="%23C19A6B" opacity="0.07"/><circle cx="70" cy="10" r="9" fill="%23D4AF37" opacity="0.06"/></svg>') repeat;
        background-size: 200px;
        opacity: 0.3;
        animation: luxuryBubbles 45s linear infinite;
        z-index: -1;
    }

    @@keyframes luxuryBubbles {
        from { background-position: 0 0; }
        to { background-position: 150% 150%; }
    }


    .hero-section h1 {
        font-size: 3.5rem;
        font-weight: 700;
        margin-bottom: 15px;
        text-shadow: 2px 2px 8px rgba(0,0,0,0.3);
    }

    .hero-section p.lead {
        font-size: 1.25rem;
        max-width: 600px;
        margin: 0 auto;
        opacity: 0.9;
    }

    .contact-info-section {
        padding: 60px 0;
        background: linear-gradient(145deg, var(--matte-charcoal), var(--card-bg));
        border-bottom: 1px solid var(--border-color);
    }

    .info-card {
        background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
        padding: 30px;
        text-align: center;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border: 1px solid var(--border-color);
    }

        .info-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(212, 175, 55, 0.25);
            border-color: var(--golden-oak);
        }

    .info-card .feature-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, var(--walnut-brown), var(--royal-gold));
        color: var(--text-light);
        border-radius: 50%;
        margin: 0 auto 20px auto;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
        border: 2px solid var(--golden-oak);
    }

    .info-card h5 {
        font-weight: 600;
        color: var(--royal-gold);
        margin-bottom: 10px;
    }

    .info-card p {
        color: var(--text-light);
        margin-bottom: 5px;
    }

    .info-card small {
        color: var(--text-muted);
        font-size: 0.85rem;
    }

    .contact-form-section {
        padding: 60px 0;
    }

    .contact-form-card {
        border: 1px solid var(--border-color);
        border-radius: 15px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.5);
        overflow: hidden;
        background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
    }

    .contact-form-card .card-header {
        background: linear-gradient(135deg, var(--walnut-brown), var(--royal-gold));
        color: var(--text-light);
        padding: 25px 30px;
        border-bottom: 1px solid var(--border-color);
        font-size: 1.5rem;
        font-weight: 600;
    }

    .contact-form-card .card-body {
        padding: 30px;
    }

    .contact-form-card .form-label {
        font-weight: 600;
        color: var(--royal-gold);
    }

    .contact-form-card .form-control,
    .contact-form-card .form-select {
        border-radius: 8px;
        border: 1px solid var(--border-color);
        padding: 12px 15px;
        background-color: var(--matte-charcoal);
        color: var(--text-light);
        box-shadow: inset 0 1px 3px rgba(0,0,0,0.3);
    }

        .contact-form-card .form-control:focus,
        .contact-form-card .form-select:focus {
            border-color: var(--royal-gold);
            box-shadow: 0 0 0 0.25rem rgba(212, 175, 55, 0.25);
            background-color: var(--card-bg);
        }

    .contact-form-card .btn-primary {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        border: none;
        padding: 12px 25px;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--matte-charcoal);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
    }

        .contact-form-card .btn-primary:hover {
            background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(212, 175, 55, 0.4);
        }

    .faq-section {
        padding: 60px 0;
        background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
        border-top: 1px solid var(--border-color);
    }

    .faq-section h3 {
        font-weight: 700;
        color: var(--royal-gold);
        margin-bottom: 40px;
        text-align: center;
    }

    .accordion-item {
        margin-bottom: 15px;
        border: 1px solid var(--border-color);
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0,0,0,0.4);
        background: linear-gradient(145deg, var(--matte-charcoal), var(--card-bg));
    }

    .accordion-button {
        background-color: transparent;
        color: var(--text-light);
        font-weight: 600;
        padding: 18px 25px;
        border-radius: 10px;
        text-align: left;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: none;
    }

        .accordion-button:not(.collapsed) {
            color: var(--royal-gold);
            background-color: var(--walnut-brown);
            border-bottom: 1px solid var(--border-color);
            box-shadow: inset 0 -1px 0 var(--border-color);
        }

        .accordion-button:focus {
            box-shadow: none;
            border-color: var(--royal-gold);
        }

    .accordion-body {
        padding: 25px;
        color: var(--text-muted);
        line-height: 1.7;
        background-color: var(--card-bg);
        border-top: 1px solid var(--border-color);
    }

    .cta-section {
        background: linear-gradient(135deg, var(--walnut-brown), var(--royal-gold));
        color: var(--text-light);
        padding: 60px 0;
        text-align: center;
        border-radius: 15px;
        margin-top: 60px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.5);
        border: 1px solid var(--border-color);
    }

        .cta-section h3 {
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .cta-section p {
            font-size: 1.1rem;
            max-width: 700px;
            margin: 0 auto 30px auto;
            opacity: 0.9;
        }

        .cta-section .btn {
            padding: 12px 30px;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: 600;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .cta-section .btn-light {
            background-color: var(--text-light);
            color: var(--matte-charcoal);
            border: 1px solid var(--text-light);
            box-shadow: 0 8px 25px rgba(248, 249, 250, 0.3);
        }

            .cta-section .btn-light:hover {
                background-color: var(--golden-oak);
                color: var(--matte-charcoal);
                transform: translateY(-2px);
                box-shadow: 0 12px 30px rgba(193, 154, 107, 0.4);
            }

        .cta-section .btn-outline-light {
            color: var(--text-light);
            border-color: var(--text-light);
            box-shadow: 0 8px 25px rgba(248, 249, 250, 0.2);
        }

            .cta-section .btn-outline-light:hover {
                background-color: var(--text-light);
                color: var(--matte-charcoal);
                transform: translateY(-2px);
                box-shadow: 0 12px 30px rgba(248, 249, 250, 0.3);
            }

</style>

<div class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-10 mx-auto text-center">
                <h1 class="display-3 fw-bold">Reach Out to Us</h1>
                <p class="lead">
                    Whether you have a question, need support, or just want to give feedback,
                    our team is ready and eager to assist you.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="contact-info-section">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-lg-10">
                <div class="row">
                    <div class="col-md-4 mb-4 d-flex">
                        <div class="info-card">
                            <div class="feature-icon">
                                <i class="fas fa-envelope fa-lg"></i>
                            </div>
                            <div>
                                <h5>Email Support</h5>
                                <p class="text-muted">support@bidnest.com</p>
                                <small class="text-muted">Expect a reply within 24 hours</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4 d-flex">
                        <div class="info-card">
                            <div class="feature-icon">
                                <i class="fas fa-phone fa-lg"></i>
                            </div>
                            <div>
                                <h5>Phone Support</h5>
                                <p class="text-muted">1-800-BIDNEST</p>
                                <small class="text-muted">Mon-Fri 9AM-6PM EST</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4 d-flex">
                        <div class="info-card">
                            <div class="feature-icon">
                                <i class="fas fa-comments fa-lg"></i>
                            </div>
                            <div>
                                <h5>Live Chat</h5>
                                <p class="text-muted">Instant Assistance</p>
                                <small class="text-muted">Available 24/7 on our website</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="contact-form-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card contact-form-card">
                    <div class="card-header">
                        <h4 class="mb-0 text-center">Send Us a Message</h4>
                    </div>
                    <div class="card-body">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="alert alert-info mb-4 d-flex align-items-center rounded-pill px-4 py-2">
                                <i class="fas fa-info-circle me-3 fa-lg"></i>
                                <span>You are submitting this message as: <strong>@User.FindFirst("FullName")?.Value</strong> (<span class="fw-light">@User.Identity.Name</span>)</span>
                            </div>
                        }
                        <form method="post" action="@Url.Action("Contact", "Home")">
                            @Html.AntiForgeryToken()
                            <div class="mb-4">
                                <label for="subject" class="form-label">Subject <span class="text-danger">*</span></label>
                                <select class="form-select" id="subject" name="Subject" required>
                                    <option value="">Select a topic that best describes your inquiry...</option>
                                    <option value="General Inquiry">General Inquiry</option>
                                    <option value="Account Issues">Account Issues</option>
                                    <option value="Bidding Problems">Bidding Problems</option>
                                    <option value="Selling Issues">Selling Issues</option>
                                    <option value="Payment Problems">Payment Problems</option>
                                    <option value="Technical Support">Technical Support</option>
                                    <option value="Report Fraud">Report Fraud or Abuse</option>
                                    <option value="Feedback">Feedback & Suggestions</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="mb-4">
                                <label for="message" class="form-label">Your Message <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="message" name="Message" rows="7" placeholder="Please provide as much detail as possible so we can assist you efficiently..." required></textarea>
                            </div>
                            <div class="mb-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="newsletter" name="Newsletter">
                                    <label class="form-check-label" for="newsletter">
                                        Subscribe to our newsletter for exclusive auction updates and tips.
                                    </label>
                                </div>
                            </div>
                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-paper-plane me-2"></i>Send Message
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="faq-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <h3>Frequently Asked Questions</h3>
                <div class="accordion" id="faqAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading1">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1" aria-expanded="false" aria-controls="collapse1">
                                How do I place a bid on an item?
                            </button>
                        </h2>
                        <div id="collapse1" class="accordion-collapse collapse" aria-labelledby="faqHeading1" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                To place a bid, first ensure you are logged into your BidNest account. Navigate to the item you wish to bid on, enter your desired bid amount (which must be higher than the current bid), and click the "Place Bid" button. Confirm your bid, and you're all set!
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading2">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2" aria-expanded="false" aria-controls="collapse2">
                                What is the process for selling an item?
                            </button>
                        </h2>
                        <div id="collapse2" class="accordion-collapse collapse" aria-labelledby="faqHeading2" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Selling an item is easy! Log in, then click "Sell an Item" in the main navigation. You'll be guided through a form where you can provide detailed descriptions, upload high-quality photos, set your starting price, and choose the auction duration. Once submitted, your item will go through a quick approval process.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading3">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3" aria-expanded="false" aria-controls="collapse3">
                                Which payment methods are accepted on BidNest?
                            </button>
                        </h2>
                        <div id="collapse3" class="accordion-collapse collapse" aria-labelledby="faqHeading3" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                We accept a variety of secure payment methods, including all major credit cards (Visa, Mastercard, American Express, Discover), PayPal, and direct bank transfers. All transactions are processed through encrypted channels to ensure your financial security.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading4">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse4" aria-expanded="false" aria-controls="collapse4">
                                How can I monitor the status of my bids and auctions?
                            </button>
                        </h2>
                        <div id="collapse4" class="accordion-collapse collapse" aria-labelledby="faqHeading4" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                You can easily track all your activity from your personalized account dashboard. Simply navigate to "My Bids" to see active bids and their status, or "Bidding History" to review past auctions, including items you've won or lost.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faqHeading5">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse5" aria-expanded="false" aria-controls="collapse5">
                                What should I do if I encounter a dispute with another user?
                            </button>
                        </h2>
                        <div id="collapse5" class="accordion-collapse collapse" aria-labelledby="faqHeading5" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                If you experience any issues or disputes with a buyer or seller, please contact our support team immediately using the form above or via email/phone. We have a dedicated dispute resolution process to mediate and resolve conflicts fairly and efficiently.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="cta-section">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <h3>Still Can't Find What You're Looking For?</h3>
                <p>
                    Don't worry, our friendly and knowledgeable support team is always ready to lend a hand.
                    Reach out to us directly, and we'll ensure you get the assistance you need.
                </p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a href="mailto:support@bidnest.com" class="btn btn-light btn-lg">
                        <i class="fas fa-envelope me-2"></i>Email Support
                    </a>
                    <a href="tel:1-800-BIDNEST" class="btn btn-outline-light btn-lg">
                        <i class="fas fa-phone-alt me-2"></i>Call Us
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>