@{
    ViewData["Title"] = "Contact Us";
}

<div class="hero-section bg-primary text-white py-5 mb-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-4 fw-bold">Contact Us</h1>
                <p class="lead">We're here to help! Get in touch with our support team</p>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row mb-5">
        <div class="col-lg-8 mx-auto">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="text-center">
                        <div class="feature-icon bg-primary text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="fas fa-envelope fa-lg"></i>
                        </div>
                        <h5>Email Support</h5>
                        <p class="text-muted">support@bidnest.com</p>
                        <small class="text-muted">Response within 24 hours</small>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="text-center">
                        <div class="feature-icon bg-success text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="fas fa-phone fa-lg"></i>
                        </div>
                        <h5>Phone Support</h5>
                        <p class="text-muted">1-800-BIDNEST</p>
                        <small class="text-muted">Mon-Fri 9AM-6PM EST</small>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="text-center">
                        <div class="feature-icon bg-info text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="fas fa-comments fa-lg"></i>
                        </div>
                        <h5>Live Chat</h5>
                        <p class="text-muted">Available 24/7</p>
                        <small class="text-muted">Instant support</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Send us a Message</h4>
                </div>
                <div class="card-body">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="alert alert-info mb-3">
                            <i class="fas fa-info-circle me-2"></i>
                            You are submitting this message as: <strong>@User.FindFirst("FullName")?.Value</strong> (@User.Identity.Name)
                        </div>
                    }
                    <form method="post" action="@Url.Action("Contact", "Home")">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="subject" class="form-label">Subject <span class="text-danger">*</span></label>
                            <select class="form-select" id="subject" name="Subject" required>
                                <option value="">Select a topic...</option>
                                <option value="General Inquiry">General Inquiry</option>
                                <option value="Account Issues">Account Issues</option>
                                <option value="Bidding Problems">Bidding Problems</option>
                                <option value="Selling Issues">Selling Issues</option>
                                <option value="Payment Problems">Payment Problems</option>
                                <option value="Technical Support">Technical Support</option>
                                <option value="Report Fraud">Report Fraud</option>
                                <option value="Feedback">Feedback & Suggestions</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label">Message <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="message" name="Message" rows="6" placeholder="Please provide as much detail as possible..." required></textarea>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="newsletter" name="Newsletter">
                                <label class="form-check-label" for="newsletter">
                                    Subscribe to our newsletter for auction updates and tips
                                </label>
                            </div>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-paper-plane me-2"></i>Send Message
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-lg-10 mx-auto">
            <h3 class="mb-4">Frequently Asked Questions</h3>
            <div class="accordion" id="faqAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="faq1">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1">
                            How do I place a bid?
                        </button>
                    </h2>
                    <div id="collapse1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            To place a bid, simply navigate to the item you're interested in, enter your bid amount (must be higher than the current bid), and click "Place Bid". You'll need to be logged in to bid.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="faq2">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2">
                            How do I sell an item?
                        </button>
                    </h2>
                    <div id="collapse2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            Click on "Sell an Item" in the navigation menu, fill out the item details form, upload photos, set your starting price and auction duration, then submit for approval.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="faq3">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3">
                            What payment methods do you accept?
                        </button>
                    </h2>
                    <div id="collapse3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            We accept major credit cards, PayPal, and bank transfers. All payments are processed securely through our trusted payment partners.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="faq4">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse4">
                            How do I track my bids?
                        </button>
                    </h2>
                    <div id="collapse4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            You can view all your active bids, won auctions, and bidding history in your account dashboard under "My Bids" or "Bidding History".
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="faq5">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse5">
                            What if I have a dispute?
                        </button>
                    </h2>
                    <div id="collapse5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            Contact our support team immediately. We have a dedicated dispute resolution process to help resolve issues between buyers and sellers fairly and quickly.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-light rounded p-5 text-center mt-5">
        <h3 class="mb-3">Still Need Help?</h3>
        <p class="mb-4">Our support team is standing by to assist you with any questions or concerns.</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="mailto:support@bidnest.com" class="btn btn-primary">Email Support</a>
            <a href="tel:1-800-BIDNEST" class="btn btn-outline-primary">Call Us</a>
        </div>
    </div>
</div>
