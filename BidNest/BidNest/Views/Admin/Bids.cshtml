@model BidNest.ViewModels.AdminBidsViewModel
@{
    ViewData["Title"] = "Bids Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4">
        <span class="text-muted fw-light">Management /</span> Bids
    </h4>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 col-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <div class="card-title d-flex align-items-start justify-content-between">
                        <div class="avatar flex-shrink-0">
                            <img src="~/admin/img/icons/unicons/chart-success.png" alt="Total Bids" class="rounded" />
                        </div>
                    </div>
                    <span>Total Bids</span>
                    <h3 class="card-title text-nowrap mb-1">@Model.TotalBids</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <div class="card-title d-flex align-items-start justify-content-between">
                        <div class="avatar flex-shrink-0">
                            <img src="~/admin/img/icons/unicons/wallet-info.png" alt="Total Value" class="rounded" />
                        </div>
                    </div>
                    <span>Total Bid Value</span>
                    <h3 class="card-title text-nowrap mb-1">$@Model.TotalBidValue.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <div class="card-title d-flex align-items-start justify-content-between">
                        <div class="avatar flex-shrink-0">
                            <img src="~/admin/img/icons/unicons/cc-success.png" alt="Winning Bids" class="rounded" />
                        </div>
                    </div>
                    <span>Winning Bids</span>
                    <h3 class="card-title text-nowrap mb-1">@Model.WinningBidsCount</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <div class="card-title d-flex align-items-start justify-content-between">
                        <div class="avatar flex-shrink-0">
                            <img src="~/admin/img/icons/unicons/cc-primary.png" alt="Unique Bidders" class="rounded" />
                        </div>
                    </div>
                    <span>Unique Bidders</span>
                    <h3 class="card-title text-nowrap mb-1">@Model.UniqueBidders</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Bids Table -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">All Bids</h5>
        </div>

        <div class="card-body">
            <!-- Search Form -->
            <form method="get" class="row mb-4">
                <div class="col-md-4">
                    <input type="text" name="search" class="form-control" placeholder="Search by item, bidder name or email..." value="@Model.SearchTerm">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bx bx-search"></i> Search
                    </button>
                </div>
                <div class="col-md-2">
                    <a href="@Url.Action("Bids")" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>

            @if (Model.Bids.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Bid ID</th>
                                <th>Item</th>
                                <th>Bidder</th>
                                <th>Amount</th>
                                <th>Bid Time</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bid in Model.Bids)
                            {
                                <tr class="@(bid.IsWinning ? "table-success" : "")">
                                    <td>
                                        <span class="badge @(bid.IsWinning ? "bg-success" : "bg-secondary")">
                                            #@bid.BidId
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-primary rounded me-2 d-flex align-items-center justify-content-center">
                                                <i class="bx bx-package text-white"></i>
                                            </div>
                                            <div>
                                                <div class="fw-medium">@bid.ItemName</div>
                                                <small class="text-muted">Item #@bid.ItemId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-info rounded-circle me-2 d-flex align-items-center justify-content-center">
                                                <span class="text-white fw-bold">
                                                    @(bid.BidderName?.Substring(0, 1).ToUpper() ?? "?")
                                                </span>
                                            </div>
                                            <div>
                                                <div class="fw-medium">@bid.BidderName</div>
                                                <small class="text-muted">ID: @bid.BidderId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fs-5 fw-bold @(bid.IsWinning ? "text-success" : "")">
                                            $@bid.Amount.ToString("N2")
                                        </span>
                                    </td>
                                    <td>
                                        <div>@bid.BidTime.ToString("MMM dd, yyyy")</div>
                                        <small class="text-muted">@bid.BidTime.ToString("HH:mm:ss")</small>
                                        <div><small class="text-info">@bid.TimeAgo</small></div>
                                    </td>
                                    <td>
                                        @if (bid.IsWinning)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bx bx-trophy"></i> Winning
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Outbid</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="dropdown">
                                            <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                                <i class="bx bx-dots-vertical-rounded"></i>
                                            </button>
                                            <div class="dropdown-menu">
                                                <a class="dropdown-item" href="@Url.Action("ItemDetails", new { id = bid.ItemId })">
                                                    <i class="bx bx-show me-1"></i> View Item
                                                </a>
                                                <a class="dropdown-item" href="@Url.Action("Details", "Auction", new { id = bid.ItemId })">
                                                    <i class="bx bx-link-external me-1"></i> View Auction
                                                </a>
                                                <a class="dropdown-item" href="@Url.Action("UserDetails", new { id = bid.BidderId })">
                                                    <i class="bx bx-user me-1"></i> View Bidder
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Bids pagination" class="mt-4">
                        <ul class="pagination justify-content-center">
                            @if (Model.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Bids", new { search = Model.SearchTerm, page = Model.CurrentPage - 1 })">
                                        Previous
                                    </a>
                                </li>
                            }

                            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Bids", new { search = Model.SearchTerm, page = i })">
                                        @i
                                    </a>
                                </li>
                            }

                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Bids", new { search = Model.SearchTerm, page = Model.CurrentPage + 1 })">
                                        Next
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>

                    <div class="text-center text-muted">
                        Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) to @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalBids) 
                        of @Model.TotalBids bids
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bx bx-money display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No Bids Found</h5>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <p class="text-muted">No bids match your search criteria.</p>
                        <a href="@Url.Action("Bids")" class="btn btn-outline-primary">Clear Search</a>
                    }
                    else
                    {
                        <p class="text-muted">No bids have been placed yet.</p>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .avatar-sm {
        width: 32px;
        height: 32px;
        font-size: 14px;
    }
    
    .table-success {
        --bs-table-bg: rgba(25, 135, 84, 0.1);
    }
</style>
