@model BidNest.Models.ContactMessage
@{
    ViewData["Title"] = "Message Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fas fa-envelope-open me-2"></i>Message Details
            </h1>
        </div>
        <div class="col-auto">
            <a href="@Url.Action("Messages")" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Messages
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Message Details Card -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Message Information</h6>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">From:</label>
                            <p class="mb-0"><strong>@Model.Name</strong></p>
                            <p class="text-muted">@Model.Email</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Date:</label>
                            <p class="mb-0">@Model.CreatedAt.ToString("MMMM dd, yyyy HH:mm")</p>
                            @if (Model.ReadAt.HasValue)
                            {
                                <p class="text-muted small">Read: @Model.ReadAt.Value.ToString("MMM dd, yyyy HH:mm")</p>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Subject:</label>
                            <p class="mb-0"><strong>@Model.Subject</strong></p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Status:</label>
                            <p class="mb-0">
                                @switch (Model.Status)
                                {
                                    case "New":
                                        <span class="badge bg-danger">New</span>
                                        break;
                                    case "Read":
                                        <span class="badge bg-primary">Read</span>
                                        break;
                                    case "Replied":
                                        <span class="badge bg-success">Replied</span>
                                        break;
                                    case "Archived":
                                        <span class="badge bg-secondary">Archived</span>
                                        break;
                                }
                                @if (Model.NewsletterSubscription)
                                {
                                    <span class="badge bg-info ms-2">Newsletter Subscriber</span>
                                }
                            </p>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small">Message:</label>
                        <div class="border rounded p-3 bg-light">
                            <p class="mb-0" style="white-space: pre-wrap;">@Model.Message</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.AdminReply))
                    {
                        <div class="mb-3">
                            <label class="text-muted small">Admin Reply:</label>
                            <div class="border rounded p-3 bg-success bg-opacity-10">
                                <p class="mb-0" style="white-space: pre-wrap;">@Model.AdminReply</p>
                                @if (Model.RepliedAt.HasValue && Model.RepliedByUser != null)
                                {
                                    <small class="text-muted">
                                        Replied by @Model.RepliedByUser.FullName on @Model.RepliedAt.Value.ToString("MMM dd, yyyy HH:mm")
                                    </small>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Reply Form -->
            @if (Model.Status != "Replied")
            {
                <div class="card shadow">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Reply to Message</h6>
                    </div>
                    <div class="card-body">
                        <form id="replyForm">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="replyContent" class="form-label">Your Reply:</label>
                                <textarea class="form-control" id="replyContent" rows="5" 
                                          placeholder="Type your reply here..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane me-2"></i>Send Reply
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <!-- Quick Actions Card -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (Model.Status == "New")
                        {
                            <button class="btn btn-primary" onclick="updateStatus('Read')">
                                <i class="fas fa-check me-2"></i>Mark as Read
                            </button>
                        }
                        @if (Model.Status != "Archived")
                        {
                            <button class="btn btn-info" onclick="updateStatus('Archived')">
                                <i class="fas fa-archive me-2"></i>Archive Message
                            </button>
                        }
                        <button class="btn btn-danger" onclick="deleteMessage()">
                            <i class="fas fa-trash me-2"></i>Delete Message
                        </button>
                    </div>
                </div>
            </div>

            <!-- Contact History Card -->
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Contact Information</h6>
                </div>
                <div class="card-body">
                    <p class="mb-2">
                        <i class="fas fa-user me-2 text-muted"></i>
                        <strong>@Model.Name</strong>
                    </p>
                    <p class="mb-2">
                        <i class="fas fa-envelope me-2 text-muted"></i>
                        <a href="mailto:@Model.Email">@Model.Email</a>
                    </p>
                    @if (Model.NewsletterSubscription)
                    {
                        <p class="mb-0">
                            <i class="fas fa-newspaper me-2 text-muted"></i>
                            <span class="text-success">Newsletter Subscriber</span>
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#replyForm').submit(function(e) {
                e.preventDefault();
                
                var replyContent = $('#replyContent').val().trim();
                if (!replyContent) {
                    alert('Please enter a reply message.');
                    return;
                }

                $.post('@Url.Action("ReplyMessage")', {
                    messageId: @Model.MessageId,
                    replyContent: replyContent,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                }).done(function(response) {
                    if (response.success) {
                        alert('Reply sent successfully!');
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                }).fail(function() {
                    alert('An error occurred while sending the reply.');
                });
            });
        });

        function updateStatus(status) {
            $.post('@Url.Action("UpdateMessageStatus")', {
                messageId: @Model.MessageId,
                status: status,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            }).done(function(response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert('Error: ' + response.message);
                }
            });
        }

        function deleteMessage() {
            if (confirm('Are you sure you want to delete this message? This action cannot be undone.')) {
                $.post('@Url.Action("DeleteMessage")', {
                    messageId: @Model.MessageId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                }).done(function(response) {
                    if (response.success) {
                        window.location.href = '@Url.Action("Messages")';
                    } else {
                        alert('Error: ' + response.message);
                    }
                });
            }
        }
    </script>
}
