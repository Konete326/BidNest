    <link rel="icon" type="image/png" href="~/user/images/favicon.png" />
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/user/css/home.css" />
    <link rel="stylesheet" href="~/user/css/menu.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <style>
        /* Light Theme Overhaul */

        /* General Body and Footer adjustments for light theme */
        body {
            background-color: #f8f9fa; /* Very light grey background */
            color: #343a40; /* Darker text for contrast */
        }
        
        /* OVERHAULED FOOTER STYLES */
        .footer {
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #e0e9f4 0%, #ffffff 100%); /* Subtle blue-white gradient */
            color: #343a40; /* Darker text for readability */
            padding: 50px 0 20px 0; /* More padding top/bottom */
            border-top: none; /* Remove default border */
            box-shadow: 0 -5px 30px rgba(0, 0, 0, 0.05); /* Soft shadow on top */
            z-index: 1;
        }

        .footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, rgba(0, 123, 255, 0.05), rgba(255, 255, 255, 0.3)); /* Very subtle overlay */
            background-size: 200% 200%;
            animation: gradientMove 15s ease infinite;
            z-index: -1;
        }

        @@keyframes gradientMove {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .footer-logo {
            margin-bottom: 20px;
            text-align: center; /* Center logo */
        }
        .footer-logo img {
            height: 50px; /* Larger logo */
            filter: drop-shadow(0 5px 10px rgba(0,0,0,0.1)); /* Soft shadow for logo */
        }
        .footer-title {
            font-family: 'Segoe UI', sans-serif; /* Modern font */
            font-weight: 700;
            color: #007bff; /* Primary blue for title */
            margin-bottom: 10px;
            font-size: 1.8rem;
            text-align: center;
        }
        .footer-tagline {
            color: #6c757d;
            font-size: 1rem;
            line-height: 1.6;
            text-align: center;
            margin-bottom: 25px;
        }

        .footer h5 {
            color: #007bff; /* Blue accent for titles */
            font-weight: 600;
            margin-bottom: 20px;
            font-size: 1.25rem;
            position: relative;
            padding-bottom: 10px;
        }
        .footer h5::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 40px;
            height: 3px;
            background-color: #007bff; /* Blue underline */
            border-radius: 2px;
        }

        .footer .list-unstyled a {
            color: #555; /* Slightly darker link color */
            text-decoration: none;
            transition: color 0.3s ease, transform 0.2s ease;
            display: inline-block; /* For transform effect */
            padding: 5px 0;
            position: relative;
        }
        .footer .list-unstyled a:hover {
            color: #007bff; /* Blue on hover */
            transform: translateX(5px); /* Gentle slide effect */
        }
        .footer .list-unstyled a::before {
            content: "\f054"; /* FontAwesome angle-right icon */
            font-family: "Font Awesome 6 Free";
            font-weight: 900;
            margin-right: 10px;
            color: #007bff;
            opacity: 0;
            transform: translateX(-10px);
            transition: opacity 0.3s ease, transform 0.3s ease;
            position: absolute;
            left: -20px;
            top: 50%;
            transform: translateY(-50%) translateX(-10px);
            font-size: 0.8em;
        }
        .footer .list-unstyled a:hover::before {
            opacity: 1;
            transform: translateY(-50%) translateX(0);
        }

        .footer-bottom {
            border-top: 1px solid rgba(0, 123, 255, 0.1); /* Lighter, blue-tinted divider */
            padding-top: 25px;
            margin-top: 40px;
            color: #6c757d;
            font-size: 0.9em;
        }
        .footer-bottom .text-md-end {
            text-align: right;
        }

        .social-icons a {
            color: #007bff; /* Blue icon color */
            font-size: 1.5rem;
            margin-right: 15px;
            transition: color 0.3s ease, transform 0.3s ease;
            display: inline-block;
        }
        .social-icons a:hover {
            color: #0056b3; /* Darker blue on hover */
            transform: translateY(-3px) scale(1.1); /* Lift and slightly enlarge */
        }

        /* Custom logout button styling (adapted for light theme) */
        .dropdown-item.border-0.bg-transparent {
            width: 100%;
            text-align: left;
            padding: 0.375rem 1rem;
            color: #212529;
            text-decoration: none;
            background-color: transparent;
            border: none;
            cursor: pointer;
        }
        
        .dropdown-item.border-0.bg-transparent:hover,
        .dropdown-item.border-0.bg-transparent:focus {
            color: #007bff; /* Blue on hover */
            background-color: #e9ecef;
        }

        /* OVERHAULED NAVBAR STYLES - LIGHT THEME WITH BLUE ACCENTS */
        .navbar {
            background-color: #ffffff !important; /* White background */
            transition: background-color 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08); /* Lighter shadow */
            padding: 0.8rem 1rem; /* Slightly more padding */
        }

        .navbar-brand img {
            transition: transform 0.3s ease-in-out;
        }
        .navbar-brand img:hover {
            transform: scale(1.05) rotate(-3deg); /* Less aggressive hover */
        }

        .navbar-nav .nav-item .nav-link {
            position: relative;
            color: #555 !important; /* Darker text for visibility */
            padding: 10px 18px; /* Adjusted padding */
            transition: color 0.3s ease-in-out, transform 0.2s ease-out, background-color 0.3s ease-in-out;
            border-radius: 8px; /* Slightly rounded corners */
            margin: 0 5px; /* Spacing between links */
            font-weight: 500;
        }

        .navbar-nav .nav-item .nav-link.active {
            color: #007bff !important; /* Active link blue */
            background-color: rgba(0, 123, 255, 0.1); /* Light blue background for active */
            font-weight: bold;
        }

        /* New Nav Link Hover Animation: Subtle Background Fill & Scale */
        .navbar-nav .nav-item .nav-link:hover {
            color: #007bff !important; /* Blue on hover */
            background-color: rgba(0, 123, 255, 0.05); /* Very light blue background on hover */
            transform: translateY(-2px); /* Subtle lift effect */
        }
        /* No ::before and ::after for line animations */


        /* Dropdown Menu Animations (adapted for light theme) */
        .dropdown-menu {
            border: none;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15); /* Lighter shadow */
            border-radius: 10px; /* More rounded */
            background-color: #ffffff; /* White dropdown background */
            padding: 10px 0;
            opacity: 0;
            transform: translateY(15px); /* Slightly less translation */
            transition: opacity 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
            display: block; 
            pointer-events: none;
            min-width: 200px; /* Ensure sufficient width */
        }

        .dropdown-menu.show {
            opacity: 1;
            transform: translateY(0);
            pointer-events: all;
        }

        .dropdown-item {
            color: #343a40; /* Dark text for items */
            padding: 10px 20px;
            transition: background-color 0.2s ease-in-out, color 0.2s ease-in-out, transform 0.2s ease-in-out;
            white-space: nowrap;
        }

        .dropdown-item:hover {
            background-color: #e6f2ff; /* Light blue hover */
            color: #0056b3; /* Darker blue text on hover */
            transform: translateX(3px); /* Gentle slide */
        }

        .dropdown-divider {
            border-color: #e0e0e0; /* Light divider */
            margin: 8px 0;
        }
        
        .dropdown-header {
            color: #888; /* Slightly darker header */
            padding: 8px 20px;
            font-size: 0.9em;
            font-weight: 600;
        }

        /* Search Bar Animations (adapted for light theme) */
        #navbar-search-input {
            width: 200px; /* Initial width */
            transition: width 0.4s cubic-bezier(0.25, 0.8, 0.25, 1), background-color 0.3s ease-in-out, border-color 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
            background-color: #f8f9fa; /* Light background */
            border: 1px solid #ced4da; /* Light border */
            color: #343a40;
            border-radius: 25px; /* More rounded pill shape */
            padding: 8px 18px; /* Adjusted padding */
        }

        #navbar-search-input::placeholder {
            color: #a0aec0;
            opacity: 0.8;
        }

        #navbar-search-input:focus {
            width: 280px; /* Expanded width on focus */
            background-color: #ffffff;
            border-color: #007bff; /* Blue border on focus */
            box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.25); /* Blue glow */
            outline: none; /* Remove default outline */
        }

        .btn-outline-light { /* Re-purposing this for light theme button */
            border-color: #007bff; /* Blue border */
            color: #007bff; /* Blue text */
            transition: all 0.3s ease-in-out;
            border-radius: 25px; /* Pill shape */
            padding: 8px 15px;
            background-color: transparent;
        }

        .btn-outline-light:hover {
            background-color: #007bff; /* Blue fill on hover */
            border-color: #007bff;
            color: #ffffff; /* White text on hover */
            transform: scale(1.05);
            box-shadow: 0 4px 10px rgba(0, 123, 255, 0.3); /* Subtle shadow on hover */
        }

        /* Search Suggestions (adapted for light theme) */
        #search-suggestions {
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
            background-color: #ffffff;
            border: 1px solid #e0e0e0;
        }

        .search-suggestion-item {
            padding: 10px 15px !important;
            border-bottom: 1px solid #f0f0f0 !important; /* Lighter border */
            transition: background-color 0.2s ease-in-out;
        }

        .search-suggestion-item:hover {
            background-color: #e6f2ff !important; /* Light blue hover */
        }

        .search-suggestion-item .fw-bold {
            color: #343a40; /* Dark text */
        }
        .search-suggestion-item .text-muted {
            color: #6c757d !important; /* Muted grey */
        }
        .search-suggestion-item .text-success {
            color: #28a745 !important; /* Standard success green */
        }

        /* Active Link Indicator (no lines, just background) */
        .navbar-nav .nav-link.active::before,
        .navbar-nav .nav-link.active::after {
           /* Remove line animations */
           content: none; 
        }

        /* Toggle Button for Mobile (light theme adjustment) */
        .navbar-toggler {
            border-color: rgba(0, 0, 0, 0.1);
        }
        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%280, 0, 0, 0.5%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }
        /* End of Light Theme Overhaul */

    </style>
    <link rel="stylesheet" href="~/user/css/scrollbar.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
   <header>
