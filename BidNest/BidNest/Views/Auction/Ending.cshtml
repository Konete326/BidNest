@model List<BidNest.ViewModels.AuctionStatusViewModel>
@{
    ViewData["Title"] = "Auctions Ending Soon";
}

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="bx bx-alarm text-warning"></i> Auctions Ending Soon
                    </h4>
                    <div>
                        <a href="@Url.Action("Active")" class="btn btn-primary btn-sm">
                            <i class="bx bx-time"></i> Active Auctions
                        </a>
                        <a href="@Url.Action("Completed")" class="btn btn-outline-secondary btn-sm">
                            <i class="bx bx-history"></i> Completed
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="alert alert-warning mb-4">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Hurry!</strong> These auctions are ending within the next 24 hours!
                        </div>

                        <div class="row">
                            @foreach (var auction in Model)
                            {
                                <div class="col-lg-4 col-md-6 mb-4">
                                    <div class="card h-100 auction-card border-warning">
                                        <div class="position-relative">
                                            @if (!string.IsNullOrEmpty(auction.ItemImageUrl))
                                            {
                                                <img src="@auction.ItemImageUrl" class="card-img-top auction-image" alt="@auction.ItemName">
                                            }
                                            else
                                            {
                                                <div class="card-img-top auction-image bg-light d-flex align-items-center justify-content-center">
                                                    <i class="bx bx-image text-muted" style="font-size: 3rem;"></i>
                                                </div>
                                            }
                                            @if (User.Identity?.IsAuthenticated == true)
                                            {
                                                <button class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 watchlist-btn" 
                                                        data-item-id="@auction.ItemId" title="Add to Watchlist">
                                                    <i class="fas fa-heart"></i>
                                                </button>
                                            }
                                            <div class="position-absolute top-0 start-0 m-2">
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bx bx-alarm"></i> Ending Soon
                                                </span>
                                            </div>
                                        </div>

                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">@auction.ItemName</h5>
                                            
                                            <!-- Auction Status -->
                                            <div class="mb-3">
                                                <span class="badge @auction.StatusBadgeClass">@auction.StatusDisplay</span>
                                                @if (auction.TimeRemaining.TotalHours < 1)
                                                {
                                                    <span class="badge bg-danger ms-1">
                                                        <i class="bx bx-time-five"></i> Final Hour!
                                                    </span>
                                                }
                                            </div>

                                            <!-- Current Bid -->
                                            <div class="row mb-3">
                                                <div class="col-6">
                                                    <small class="text-muted">Current Bid</small>
                                                    <div class="fw-bold text-success">
                                                        $@((auction.CurrentHighestBid ?? auction.MinimumBid).ToString("N2"))
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <small class="text-muted">Bids</small>
                                                    <div class="fw-bold">@auction.TotalBids</div>
                                                </div>
                                            </div>

                                            <!-- Time Remaining (Prominent) -->
                                            <div class="mb-3 text-center bg-warning bg-opacity-10 rounded p-2">
                                                <small class="text-muted">Ending In</small>
                                                <div class="fw-bold text-danger fs-5 auction-timer" data-end-time="@auction.EndTime.ToString("yyyy-MM-ddTHH:mm:ssZ")">
                                                    @auction.TimeRemainingDisplay
                                                </div>
                                            </div>

                                            <!-- Current Winner -->
                                            @if (!string.IsNullOrEmpty(auction.CurrentWinnerName))
                                            {
                                                <div class="mb-3">
                                                    <small class="text-muted">Current Leader</small>
                                                    <div class="fw-medium">
                                                        <i class="bx bx-crown text-warning"></i> @auction.CurrentWinnerName
                                                    </div>
                                                </div>
                                            }

                                            <!-- Action Buttons -->
                                            <div class="mt-auto">
                                                <div class="d-grid gap-2">
                                                    <a href="@Url.Action("Details", new { id = auction.ItemId })" class="btn btn-warning">
                                                        <i class="bx bx-show"></i> View & Bid Now
                                                    </a>
                                                    @if (User.Identity?.IsAuthenticated == true)
                                                    {
                                                        <a href="@Url.Action("Bid", new { id = auction.ItemId })" class="btn btn-danger">
                                                            <i class="bx bx-gavel"></i> Quick Bid
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-danger">
                                                            <i class="bx bx-user"></i> Login to Bid
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bx bx-alarm text-muted" style="font-size: 4rem;"></i>
                            <h5 class="mt-3">No Auctions Ending Soon</h5>
                            <p class="text-muted">There are currently no auctions ending within the next 24 hours.</p>
                            <a href="@Url.Action("Active")" class="btn btn-primary mt-3">
                                <i class="bx bx-search"></i> Browse Active Auctions
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --walnut-brown: #5C4033;
        --golden-oak: #C19A6B;
        --royal-gold: #D4AF37;
        --steel-mist: #A2B0BF;
        --matte-charcoal: #2B2B2B;
        --text-light: #f8f9fa;
        --text-muted: #A2B0BF;
        --bg-dark: #000000;
        --card-bg: #1a1a1a;
        --border-color: rgba(196, 154, 107, 0.2);
        --shadow-luxury: 0 15px 45px rgba(0, 0, 0, 0.5);
        --shadow-hover: 0 20px 60px rgba(212, 175, 55, 0.15);
    }

    /* Global Styling */
    body {
        background-color: var(--bg-dark) !important;
        color: var(--text-light);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        line-height: 1.6;
    }

    .container {
        background-color: var(--bg-dark);
        min-height: 100vh;
        padding-top: 2rem;
        padding-bottom: 2rem;
    }

    /* Main Card Styling */
    .card {
        background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: var(--shadow-luxury);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        position: relative;
        opacity: 0;
        transform: translateY(30px);
        animation: luxuryFadeInCard 0.8s ease-out forwards;
    }

    .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, var(--royal-gold), var(--golden-oak), var(--walnut-brown));
        z-index: 1;
    }

    .card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-hover);
        border-color: var(--golden-oak);
    }

    /* Card Header Styling */
    .card-header {
        background: linear-gradient(135deg, var(--walnut-brown) 0%, var(--matte-charcoal) 35%, var(--golden-oak) 70%, var(--royal-gold) 100%);
        background-size: 400% 400%;
        animation: luxuryGradientShift 20s ease infinite;
        border: none;
        border-radius: 20px 20px 0 0 !important;
        padding: 1.5rem 2rem;
        position: relative;
        overflow: hidden;
    }

    .card-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: url('data:image/svg+xml;utf8,<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="4" fill="%23D4AF37" opacity="0.1"/><circle cx="80" cy="40" r="6" fill="%23C19A6B" opacity="0.1"/><circle cx="50" cy="80" r="5" fill="%23D4AF37" opacity="0.1"/></svg>') repeat;
        background-size: 120px;
        opacity: 0.4;
        animation: moveBubbles 25s linear infinite;
        z-index: 0;
    }

    .card-header h4 {
        color: var(--text-light);
        font-weight: 700;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        position: relative;
        z-index: 1;
        margin-bottom: 0;
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .card-body {
        background-color: transparent;
        padding: 2rem;
        position: relative;
        z-index: 1;
    }

    /* Auction Card Styling */
    .auction-card {
        background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
        border: 2px solid var(--golden-oak) !important;
        border-radius: 15px;
        box-shadow: var(--shadow-luxury);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        position: relative;
        height: 100%;
        opacity: 0;
        transform: translateY(30px);
        animation: luxuryFadeInCard 0.8s ease-out forwards;
    }

    .auction-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, var(--royal-gold), var(--golden-oak));
        z-index: 1;
    }

    .auction-card:hover {
        transform: translateY(-12px);
        box-shadow: var(--shadow-hover);
        border-color: var(--royal-gold);
    }

    /* Staggered animations for auction cards */
    .col-lg-4:nth-child(1) .auction-card { animation-delay: 0.1s; }
    .col-lg-4:nth-child(2) .auction-card { animation-delay: 0.2s; }
    .col-lg-4:nth-child(3) .auction-card { animation-delay: 0.3s; }
    .col-lg-4:nth-child(4) .auction-card { animation-delay: 0.4s; }
    .col-lg-4:nth-child(5) .auction-card { animation-delay: 0.5s; }
    .col-lg-4:nth-child(6) .auction-card { animation-delay: 0.6s; }

    /* Image Styling */
    .auction-image {
        height: 200px;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .auction-card:hover .auction-image {
        transform: scale(1.05);
    }

    .auction-image.bg-light {
        background: linear-gradient(135deg, var(--matte-charcoal), var(--card-bg)) !important;
    }

    .auction-image i.text-muted {
        color: var(--steel-mist) !important;
    }

    /* Watchlist Button */
    .watchlist-btn {
        background: linear-gradient(135deg, var(--walnut-brown), var(--matte-charcoal));
        border: none;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(92, 64, 51, 0.3);
        transition: all 0.3s ease;
        color: var(--text-light);
    }

    .watchlist-btn:hover {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        transform: scale(1.1);
        box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
        color: var(--matte-charcoal);
    }

    .watchlist-btn i {
        font-size: 1.2rem;
        transition: transform 0.3s ease;
    }

    .watchlist-btn:hover i {
        transform: scale(1.1);
    }

    /* Badge Styling */
    .badge {
        border-radius: 15px;
        font-weight: 500;
        letter-spacing: 0.3px;
        padding: 0.5rem 1rem;
    }

    .bg-warning {
        background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown)) !important;
        color: var(--text-light) !important;
    }

    .bg-danger {
        background: linear-gradient(135deg, var(--walnut-brown), var(--matte-charcoal)) !important;
        color: var(--text-light) !important;
    }

    .bg-success {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak)) !important;
        color: var(--matte-charcoal) !important;
    }

    .bg-secondary {
        background: linear-gradient(135deg, var(--steel-mist), var(--matte-charcoal)) !important;
        color: var(--text-light) !important;
    }

    /* Text Colors */
    .text-warning {
        color: var(--golden-oak) !important;
        font-weight: 700;
    }

    .text-success {
        color: var(--royal-gold) !important;
        font-weight: 700;
    }

    .text-danger {
        color: var(--walnut-brown) !important;
        font-weight: 700;
    }

    .text-muted {
        color: var(--steel-mist) !important;
    }

    /* Card Title */
    .card-title {
        color: var(--text-light);
        font-weight: 600;
        transition: color 0.3s ease;
    }

    .auction-card:hover .card-title {
        color: var(--royal-gold);
    }

    /* Button Styling */
    .btn {
        border-radius: 25px;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: none;
        position: relative;
        overflow: hidden;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        color: var(--matte-charcoal);
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    }

    .btn-primary::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.5s;
    }

    .btn-primary:hover::before {
        left: 100%;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
        color: var(--text-light);
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
    }

    .btn-warning {
        background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
        color: var(--text-light);
        box-shadow: 0 4px 15px rgba(196, 154, 107, 0.3);
    }

    .btn-warning:hover {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        color: var(--matte-charcoal);
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
    }

    .btn-danger {
        background: linear-gradient(135deg, var(--walnut-brown), var(--matte-charcoal));
        color: var(--text-light);
        box-shadow: 0 4px 15px rgba(92, 64, 51, 0.3);
    }

    .btn-danger:hover {
        background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
        color: var(--matte-charcoal);
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
    }

    .btn-outline-secondary {
        background: transparent;
        color: var(--steel-mist);
        border: 2px solid var(--steel-mist);
    }

    .btn-outline-secondary:hover {
        background: linear-gradient(135deg, var(--steel-mist), var(--golden-oak));
        color: var(--matte-charcoal);
        border-color: var(--golden-oak);
        transform: translateY(-3px);
    }

    .btn-outline-danger {
        background: transparent;
        color: var(--walnut-brown);
        border: 2px solid var(--walnut-brown);
    }

    .btn-outline-danger:hover {
        background: linear-gradient(135deg, var(--walnut-brown), var(--matte-charcoal));
        color: var(--text-light);
        border-color: var(--walnut-brown);
        transform: translateY(-3px);
    }

    .btn i {
        transition: transform 0.3s ease;
    }

    .btn:hover i {
        transform: scale(1.1);
    }

    /* Alert Styling */
    .alert {
        border: none;
        border-radius: 15px;
        padding: 1.5rem;
        font-weight: 500;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        margin-bottom: 1.5rem;
    }

    .alert-warning {
        background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
        color: var(--text-light);
    }

    /* Timer Display */
    .bg-warning.bg-opacity-10 {
        background: linear-gradient(135deg, var(--matte-charcoal), var(--card-bg)) !important;
        border: 2px solid var(--golden-oak);
        border-radius: 15px;
        padding: 1rem;
    }

    .auction-timer {
        font-weight: 700;
        font-size: 1.25rem;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
        color: var(--golden-oak) !important;
    }

    .auction-timer.text-danger {
        color: var(--walnut-brown) !important;
        animation: pulseUrgent 1s infinite;
    }

    /* Crown Icon */
    .bx-crown {
        color: var(--royal-gold) !important;
    }

    /* Strong Text */
    .fw-bold {
        color: var(--text-light);
        font-weight: 700;
    }

    .fw-medium {
        color: var(--text-light);
        font-weight: 600;
    }

    /* Small Text */
    small {
        color: var(--steel-mist);
        font-size: 0.85rem;
    }

    /* Empty State */
    .text-center.py-5 {
        background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
        border-radius: 20px;
        box-shadow: var(--shadow-luxury);
        border: 2px dashed var(--border-color);
        margin-top: 2rem;
    }

    .text-center.py-5 i {
        color: var(--steel-mist) !important;
    }

    .text-center.py-5 h5 {
        color: var(--royal-gold) !important;
    }

    .text-center.py-5 p {
        color: var(--steel-mist) !important;
    }

    /* Icons */
    .bx {
        transition: all 0.3s ease;
    }

    .btn:hover .bx {
        transform: scale(1.1);
    }

    /* Font Sizes */
    .fs-5 {
        font-size: 1.25rem !important;
        font-weight: 600;
    }

    /* Animations */
    @@keyframes luxuryFadeInCard {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes luxuryGradientShift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    @@keyframes moveBubbles {
        from { background-position: 0 0; }
        to { background-position: 100% 100%; }
    }

    @@keyframes pulseUrgent {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .container {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }
        
        .card-body {
            padding: 1.5rem;
        }
        
        .card-header {
            padding: 1rem 1.5rem;
        }
        
        .btn {
            width: 100%;
            margin-bottom: 0.5rem;
        }
        
        .auction-card {
            margin-bottom: 1rem;
        }
    }

    @@media (max-width: 576px) {
        .card {
            border-radius: 15px;
            margin: 0 0.5rem;
        }
        
        .card-body {
            padding: 1rem;
        }
        
        .card-header {
            border-radius: 15px 15px 0 0 !important;
            padding: 1rem;
        }
        
        .auction-card {
            border-radius: 12px;
        }
        
        .btn-sm {
            font-size: 0.75rem;
            padding: 0.4rem 0.8rem;
        }
    }
</style>

@section Scripts {
    <script>
        // Watchlist functionality
        $(document).ready(function() {
            $('.watchlist-btn').click(function() {
                var button = $(this);
                var itemId = button.data('item-id');
                var icon = button.find('i');
                
                button.prop('disabled', true);
                
                $.post('@Url.Action("ToggleWatchlist", "Buyer")', {
                    itemId: itemId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                }).done(function(response) {
                    if (response.success) {
                        if (response.isInWatchlist) {
                            icon.removeClass('far').addClass('fas');
                            button.attr('title', 'Remove from Watchlist');
                            showNotification('Item added to your watchlist!', 'success');
                        } else {
                            icon.removeClass('fas').addClass('far');
                            button.attr('title', 'Add to Watchlist');
                            showNotification('Item removed from your watchlist!', 'info');
                        }
                    } else {
                        showNotification(response.message || 'An error occurred', 'error');
                    }
                }).fail(function() {
                    showNotification('An error occurred. Please try again.', 'error');
                }).always(function() {
                    button.prop('disabled', false);
                });
            });
            
            // Check which items are already in watchlist
            $('.watchlist-btn').each(function() {
                var button = $(this);
                var itemId = button.data('item-id');
                
                $.get('@Url.Action("IsInWatchlist", "Buyer")', {
                    itemId: itemId
                }).done(function(response) {
                    if (response.isInWatchlist) {
                        button.find('i').removeClass('far').addClass('fas');
                        button.attr('title', 'Remove from Watchlist');
                    } else {
                        button.find('i').removeClass('fas').addClass('far');
                    }
                });
            });
        });
        
        // Show notification
        function showNotification(message, type) {
            var alertClass = 'alert-info';
            if (type === 'success') alertClass = 'alert-success';
            else if (type === 'error') alertClass = 'alert-danger';
            
            var notification = $('<div class="alert ' + alertClass + ' alert-dismissible fade show position-fixed top-0 end-0 m-3" style="z-index: 9999;">' +
                '<i class="fas fa-info-circle me-2"></i>' + message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                '</div>');
            
            $('body').append(notification);
            
            setTimeout(function() {
                notification.fadeOut(function() {
                    notification.remove();
                });
            }, 3000);
        }
        
        // Update all auction timers
        function updateAllTimers() {
            document.querySelectorAll('.auction-timer').forEach(timer => {
                const endTime = new Date(timer.getAttribute('data-end-time'));
                const now = new Date();
                const timeLeft = endTime - now;
                
                if (timeLeft <= 0) {
                    timer.innerHTML = '<span class="text-danger">Ended</span>';
                    timer.closest('.auction-card').classList.add('opacity-75');
                } else {
                    const hours = Math.floor(timeLeft / (1000 * 60 * 60));
                    const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                    const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);
                    
                    let display = '';
                    if (hours > 0) {
                        display = `${hours}h ${minutes}m`;
                    } else if (minutes > 0) {
                        display = `${minutes}m ${seconds}s`;
                    } else {
                        display = `${seconds}s`;
                    }
                    
                    timer.innerHTML = display;
                    
                    // Add urgency styling
                    if (hours === 0 && minutes < 30) {
                        timer.classList.add('text-danger', 'fw-bold');
                    }
                }
            });
        }
        
        // Update timers every second
        setInterval(updateAllTimers, 1000);
        updateAllTimers(); // Initial call
    </script>
}
