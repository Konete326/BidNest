@model List<BidNest.ViewModels.AuctionStatusViewModel>
@{
    ViewData["Title"] = "Active Auctions";
}

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0 animated fadeIn">
                <div class="card-header bg-white d-flex justify-content-between align-items-center border-bottom-0 pb-0">
                    <h4 class="mb-0 text-primary">
                        <i class="bx bx-time animate__animated animate__pulse animate__infinite"></i> Active Auctions
                    </h4>
                    <div class="d-flex align-items-center">
                        <a href="@Url.Action("Ending")" class="btn btn-outline-warning btn-sm me-2 animate__animated animate__bounceIn">
                            <i class="bx bx-alarm"></i> Ending Soon
                        </a>
                        <a href="@Url.Action("Completed")" class="btn btn-outline-secondary btn-sm animate__animated animate__bounceIn">
                            <i class="bx bx-history"></i> Completed
                        </a>
                    </div>
                </div>

                <div class="card-body pt-0">
                    @if (Model.Any())
                    {
                        <div class="row mt-4">
                            @foreach (var auction in Model)
                            {
                                <div class="col-lg-4 col-md-6 mb-4 animate__animated animate__fadeInUp">
                                    <div class="card h-100 auction-card shadow-sm border-0 rounded-3 overflow-hidden">
                                        <div class="position-relative auction-image-container">
                                            @if (!string.IsNullOrEmpty(auction.ItemImageUrl))
                                            {
                                                <img src="@auction.ItemImageUrl" class="card-img-top auction-image" alt="@auction.ItemName">
                                            }
                                            else
                                            {
                                                <div class="card-img-top auction-image bg-light d-flex align-items-center justify-content-center">
                                                    <i class="bx bx-image text-muted display-4 animate__animated animate__zoomIn"></i>
                                                </div>
                                            }
                                            @if (User.Identity?.IsAuthenticated == true)
                                            {
                                                <button class="btn btn-light btn-sm position-absolute top-0 end-0 m-2 watchlist-btn animate__animated animate__fadeInRight" 
                                                        data-item-id="@auction.ItemId" title="Add to Watchlist"
                                                        data-bs-toggle="tooltip" data-bs-placement="left">
                                                    <i class="far fa-heart text-danger"></i>
                                                </button>
                                            }
                                        </div>

                                        <div class="card-body d-flex flex-column p-4">
                                            <h5 class="card-title text-primary fw-bold mb-2">@auction.ItemName</h5>
                                            
                                            <!-- Auction Status -->
                                            <div class="mb-3 d-flex align-items-center">
                                                <span class="badge @auction.StatusBadgeClass me-2 animate__animated animate__fadeInLeft">@auction.StatusDisplay</span>
                                                @if (auction.TimeRemaining.TotalHours < 24)
                                                {
                                                    <span class="badge bg-warning text-dark animate__animated animate__flash animate__infinite">
                                                        <i class="bx bx-alarm"></i> Ending Soon
                                                    </span>
                                                }
                                            </div>

                                            <!-- Current Bid Info -->
                                            <div class="row mb-3 gx-2">
                                                <div class="col-6">
                                                    <small class="text-muted d-block">Current Bid</small>
                                                    <div class="fw-bold text-success fs-5 animate__animated animate__fadeInDown">
                                                        @if (auction.CurrentHighestBid.HasValue)
                                                        {
                                                            <span>$@auction.CurrentHighestBid.Value.ToString("N2")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">$@auction.MinimumBid.ToString("N2")</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <small class="text-muted d-block">Total Bids</small>
                                                    <div class="fw-bold fs-5 animate__animated animate__fadeInDown">@auction.TotalBids</div>
                                                </div>
                                            </div>

                                            <!-- Time Remaining -->
                                            <div class="mb-3">
                                                <small class="text-muted d-block">Time Remaining</small>
                                                <div class="fw-bold text-primary fs-5 auction-timer animate__animated animate__fadeIn" data-end-time="@auction.EndTime.ToString("yyyy-MM-ddTHH:mm:ssZ")">
                                                    @auction.TimeRemainingDisplay
                                                </div>
                                            </div>

                                            <!-- Current Winner -->
                                            @if (!string.IsNullOrEmpty(auction.CurrentWinnerName))
                                            {
                                                <div class="mb-3">
                                                    <small class="text-muted d-block">Current Leader</small>
                                                    <div class="fw-medium text-info animate__animated animate__fadeInUp">
                                                        <i class="bx bx-crown text-warning"></i> @auction.CurrentWinnerName
                                                    </div>
                                                </div>
                                            }

                                            <!-- Action Buttons -->
                                            <div class="mt-auto pt-3 border-top">
                                                <div class="d-grid gap-2">
                                                    <a href="@Url.Action("Details", new { id = auction.ItemId })" class="btn btn-primary btn-lg rounded-pill animate__animated animate__zoomIn">
                                                        <i class="bx bx-show me-2"></i> View Details
                                                    </a>
                                                    @if (User.Identity?.IsAuthenticated == true)
                                                    {
                                                        <a href="@Url.Action("Bid", new { id = auction.ItemId })" class="btn btn-success btn-lg rounded-pill animate__animated animate__zoomIn">
                                                            <i class="bx bx-gavel me-2"></i> Place Bid
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-success btn-lg rounded-pill animate__animated animate__zoomIn">
                                                            <i class="bx bx-user me-2"></i> Login to Bid
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 animate__animated animate__fadeIn">
                            <i class="bx bx-time display-1 text-primary animate__animated animate__bounceIn"></i>
                            <h5 class="mt-3 text-primary animate__animated animate__fadeInUp">No Active Auctions</h5>
                            <p class="text-muted animate__animated animate__fadeInUp animate__delay-1s">There are currently no active auctions. Check back later!</p>
                            <a href="@Url.Action("Completed")" class="btn btn-outline-primary mt-3 animate__animated animate__zoomIn">
                                <i class="bx bx-history me-2"></i> View Completed Auctions
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize tooltips
        $(function () {
            $('[data-bs-toggle="tooltip"]').tooltip()
        });

        // Watchlist functionality
        $(document).ready(function() {
            $('.watchlist-btn').click(function(e) {
                e.preventDefault(); // Prevent default button action
                var button = $(this);
                var itemId = button.data('item-id');
                var icon = button.find('i');
                
                button.prop('disabled', true);
                button.tooltip('hide'); // Hide tooltip when clicked
                
                $.post('@Url.Action("ToggleWatchlist", "Buyer")', {
                    itemId: itemId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                }).done(function(response) {
                    if (response.success) {
                        if (response.isInWatchlist) {
                            icon.removeClass('far fa-heart').addClass('fas fa-heart text-danger animate__animated animate__heartBeat');
                            button.attr('title', 'Remove from Watchlist');
                            showNotification('Item added to your watchlist!', 'success');
                        } else {
                            icon.removeClass('fas fa-heart text-danger').addClass('far fa-heart animate__animated animate__bounceOut');
                            button.attr('title', 'Add to Watchlist');
                            showNotification('Item removed from your watchlist!', 'info');
                        }
                        setTimeout(() => icon.removeClass('animate__animated animate__heartBeat animate__bounceOut'), 1000); // Remove animation class after it plays
                    } else {
                        showNotification(response.message || 'An error occurred', 'error');
                    }
                }).fail(function() {
                    showNotification('An error occurred. Please try again.', 'error');
                }).always(function() {
                    button.prop('disabled', false);
                    button.tooltip('enable'); // Re-enable tooltip
                });
            });
            
            // Check which items are already in watchlist on load
            $('.watchlist-btn').each(function() {
                var button = $(this);
                var itemId = button.data('item-id');
                
                $.get('@Url.Action("IsInWatchlist", "Buyer")', {
                    itemId: itemId
                }).done(function(response) {
                    if (response.isInWatchlist) {
                        button.find('i').removeClass('far fa-heart').addClass('fas fa-heart text-danger');
                        button.attr('title', 'Remove from Watchlist');
                    } else {
                        button.find('i').removeClass('fas fa-heart text-danger').addClass('far fa-heart');
                    }
                });
            });
        });
        
        // Show notification with custom animation
        function showNotification(message, type) {
            var alertClass = 'alert-info';
            var iconClass = 'bx bx-info-circle';
            if (type === 'success') { alertClass = 'alert-success'; iconClass = 'bx bx-check-circle'; }
            else if (type === 'error') { alertClass = 'alert-danger'; iconClass = 'bx bx-error-circle'; }
            
            var notification = $('<div class="alert ' + alertClass + ' alert-dismissible fade show position-fixed top-0 end-0 m-4 shadow animated slideInRight" style="z-index: 9999; min-width: 250px;">' +
                '<i class="' + iconClass + ' me-2"></i>' + message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                '</div>');
            
            $('body').append(notification);
            
            setTimeout(function() {
                notification.removeClass('slideInRight').addClass('slideOutRight');
                notification.one('animationend', function() {
                    notification.remove();
                });
            }, 3000);
        }
        
        // Update all auction timers
        function updateAllTimers() {
            document.querySelectorAll('.auction-timer').forEach(timer => {
                const endTime = new Date(timer.getAttribute('data-end-time'));
                const now = new Date();
                const timeLeft = endTime - now;
                
                timer.classList.remove('text-danger', 'text-warning', 'animate__flash'); // Reset classes

                if (timeLeft <= 0) {
                    timer.innerHTML = '<span class="text-danger fw-bold animate__animated animate__tada">Ended</span>';
                    timer.closest('.auction-card').classList.add('opacity-75', 'bg-light');
                    timer.closest('.auction-card').querySelector('.btn-success')?.classList.add('disabled'); // Disable bid button
                    return;
                }

                const days = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
                const hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

                let display = '';
                if (days > 0) display += `${days}d `;
                display += `${String(hours).padStart(2, '0')}h ${String(minutes).padStart(2, '0')}m ${String(seconds).padStart(2, '0')}s`;

                timer.textContent = display;
                
                // Add urgency styling for auctions ending soon
                if (timeLeft < 3600000) { // Less than 1 hour
                    timer.classList.add('text-danger', 'animate__animated', 'animate__flash', 'animate__infinite');
                } else if (timeLeft < 86400000) { // Less than 24 hours
                    timer.classList.add('text-warning');
                } else {
                    timer.classList.add('text-primary'); // Default blue for active
                }
            });
        }

        // Update timers every second
        setInterval(updateAllTimers, 1000);
        
        // Initial update
        updateAllTimers();
    </script>
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <style>
        body {
            background-color: #f8f9fa; /* Light grey background */
            font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }

        .card {
            border-radius: 1rem;
            transition: all 0.3s ease-in-out;
            background-color: #fff;
        }
        
        .auction-card {
            border: 1px solid #e0e0e0;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.05);
        }

        .auction-card:hover {
            transform: translateY(-5px) scale(1.01);
            box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.1);
        }
        
        .auction-image-container {
            height: 220px; /* Slightly taller images */
            overflow: hidden;
            border-bottom: 1px solid #eee;
        }

        .auction-image {
            height: 100%;
            width: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .auction-card:hover .auction-image {
            transform: scale(1.05);
        }
        
        .card-header {
            background-color: #ffffff;
            border-bottom: none;
            padding-bottom: 0;
        }

        .text-primary {
            color: #007bff !important; /* Bootstrap primary blue */
        }
        
        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
            transition: background-color 0.3s, border-color 0.3s, transform 0.2s;
        }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #0056b3;
            transform: translateY(-2px);
        }

        .btn-success {
            background-color: #28a745;
            border-color: #28a745;
            transition: background-color 0.3s, border-color 0.3s, transform 0.2s;
        }

        .btn-success:hover {
            background-color: #218838;
            border-color: #218838;
            transform: translateY(-2px);
        }

        .btn-outline-success {
            color: #28a745;
            border-color: #28a745;
            transition: all 0.3s;
        }

        .btn-outline-success:hover {
            background-color: #28a745;
            color: #fff;
            transform: translateY(-2px);
        }

        .watchlist-btn {
            background-color: rgba(255, 255, 255, 0.8);
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }

        .watchlist-btn:hover {
            background-color: #fff;
            transform: scale(1.1);
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }
        
        .watchlist-btn i {
            font-size: 1.2rem;
        }

        .badge {
            padding: 0.5em 0.8em;
            border-radius: 0.375rem;
            font-weight: 600;
        }

        .badge-active {
            background-color: #e6f7ff; /* Light blue */
            color: #007bff;
            border: 1px solid #007bff;
        }
        
        .badge-upcoming {
            background-color: #fff3e0; /* Light orange */
            color: #ff9800;
            border: 1px solid #ff9800;
        }
        
        .badge-completed {
            background-color: #e0e0e0; /* Light grey */
            color: #6c757d;
            border: 1px solid #6c757d;
        }

        .auction-timer.text-danger {
            color: #dc3545 !important;
            animation-duration: 1s;
        }
        .auction-timer.text-warning {
            color: #ffc107 !important;
        }

        /* Animate.css overrides for better fit */
        .animated.fadeIn {
            animation-duration: 0.8s;
        }
        .animated.fadeInUp {
            animation-duration: 0.6s;
        }
        .animated.bounceIn {
            animation-duration: 0.7s;
        }
        .animated.slideInRight {
            animation-duration: 0.5s;
        }
        .animated.slideOutRight {
            animation-duration: 0.5s;
        }
        .animated.flash {
            animation-duration: 1.5s; /* Slower flash for less distraction */
        }
    </style>
}