@model List<BidNest.ViewModels.AuctionStatusViewModel>
@{
    ViewData["Title"] = "Active Auctions";
}

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0 animated fadeIn">
                <div class="card-header bg-white d-flex justify-content-between align-items-center border-bottom-0 pb-0">
                    <h4 class="mb-0 text-primary">
                        <i class="bx bx-time animate__animated animate__pulse animate__infinite"></i> Active Auctions
                    </h4>
                    <div class="d-flex align-items-center">
                        <a href="@Url.Action("Ending")" class="btn btn-outline-warning btn-sm me-2 animate__animated animate__bounceIn">
                            <i class="bx bx-alarm"></i> Ending Soon
                        </a>
                        <a href="@Url.Action("Completed")" class="btn btn-outline-secondary btn-sm animate__animated animate__bounceIn">
                            <i class="bx bx-history"></i> Completed
                        </a>
                    </div>
                </div>

                <div class="card-body pt-0">
                    @if (Model.Any())
                    {
                        <div class="row mt-4">
                            @foreach (var auction in Model)
                            {
                                <div class="col-lg-4 col-md-6 mb-4 animate__animated animate__fadeInUp">
                                    <div class="card h-100 auction-card shadow-sm border-0 rounded-3 overflow-hidden">
                                        <div class="position-relative auction-image-container">
                                            @if (!string.IsNullOrEmpty(auction.ItemImageUrl))
                                            {
                                                <img src="@auction.ItemImageUrl" class="card-img-top auction-image" alt="@auction.ItemName">
                                            }
                                            else
                                            {
                                                <div class="card-img-top auction-image bg-light d-flex align-items-center justify-content-center">
                                                    <i class="bx bx-image text-muted display-4 animate__animated animate__zoomIn"></i>
                                                </div>
                                            }
                                            @if (User.Identity?.IsAuthenticated == true)
                                            {
                                                <button class="btn btn-light btn-sm position-absolute top-0 end-0 m-2 watchlist-btn animate__animated animate__fadeInRight" 
                                                        data-item-id="@auction.ItemId" title="Add to Watchlist"
                                                        data-bs-toggle="tooltip" data-bs-placement="left">
                                                    <i class="far fa-heart text-danger"></i>
                                                </button>
                                            }
                                        </div>

                                        <div class="card-body d-flex flex-column p-4">
                                            <h5 class="card-title text-primary fw-bold mb-2">@auction.ItemName</h5>
                                            
                                            <!-- Auction Status -->
                                            <div class="mb-3 d-flex align-items-center">
                                                <span class="badge @auction.StatusBadgeClass me-2 animate__animated animate__fadeInLeft">@auction.StatusDisplay</span>
                                                @if (auction.TimeRemaining.TotalHours < 24)
                                                {
                                                    <span class="badge bg-warning text-dark animate__animated animate__flash animate__infinite">
                                                        <i class="bx bx-alarm"></i> Ending Soon
                                                    </span>
                                                }
                                            </div>

                                            <!-- Current Bid Info -->
                                            <div class="row mb-3 gx-2">
                                                <div class="col-6">
                                                    <small class="text-muted d-block">Current Bid</small>
                                                    <div class="fw-bold text-success fs-5 animate__animated animate__fadeInDown">
                                                        @if (auction.CurrentHighestBid.HasValue)
                                                        {
                                                            <span>$@auction.CurrentHighestBid.Value.ToString("N2")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">$@auction.MinimumBid.ToString("N2")</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <small class="text-muted d-block">Total Bids</small>
                                                    <div class="fw-bold fs-5 animate__animated animate__fadeInDown">@auction.TotalBids</div>
                                                </div>
                                            </div>

                                            <!-- Time Remaining -->
                                            <div class="mb-3">
                                                <small class="text-muted d-block">Time Remaining</small>
                                                <div class="fw-bold text-primary fs-5 auction-timer animate__animated animate__fadeIn" data-end-time="@auction.EndTime.ToString("yyyy-MM-ddTHH:mm:ssZ")">
                                                    @auction.TimeRemainingDisplay
                                                </div>
                                            </div>

                                            <!-- Current Winner -->
                                            @if (!string.IsNullOrEmpty(auction.CurrentWinnerName))
                                            {
                                                <div class="mb-3">
                                                    <small class="text-muted d-block">Current Leader</small>
                                                    <div class="fw-medium text-info animate__animated animate__fadeInUp">
                                                        <i class="bx bx-crown text-warning"></i> @auction.CurrentWinnerName
                                                    </div>
                                                </div>
                                            }

                                            <!-- Action Buttons -->
                                            <div class="mt-auto pt-3 border-top">
                                                <div class="d-grid gap-2">
                                                    <a href="@Url.Action("Details", new { id = auction.ItemId })" class="btn btn-primary btn-lg rounded-pill animate__animated animate__zoomIn">
                                                        <i class="bx bx-show me-2"></i> View Details
                                                    </a>
                                                    @if (User.Identity?.IsAuthenticated == true)
                                                    {
                                                        <a href="@Url.Action("Bid", new { id = auction.ItemId })" class="btn btn-success btn-lg rounded-pill animate__animated animate__zoomIn">
                                                            <i class="bx bx-gavel me-2"></i> Place Bid
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-success btn-lg rounded-pill animate__animated animate__zoomIn">
                                                            <i class="bx bx-user me-2"></i> Login to Bid
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 animate__animated animate__fadeIn">
                            <i class="bx bx-time display-1 text-primary animate__animated animate__bounceIn"></i>
                            <h5 class="mt-3 text-primary animate__animated animate__fadeInUp">No Active Auctions</h5>
                            <p class="text-muted animate__animated animate__fadeInUp animate__delay-1s">There are currently no active auctions. Check back later!</p>
                            <a href="@Url.Action("Completed")" class="btn btn-outline-primary mt-3 animate__animated animate__zoomIn">
                                <i class="bx bx-history me-2"></i> View Completed Auctions
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize tooltips
        $(function () {
            $('[data-bs-toggle="tooltip"]').tooltip()
        });

        // Watchlist functionality
        $(document).ready(function() {
            $('.watchlist-btn').click(function(e) {
                e.preventDefault(); // Prevent default button action
                var button = $(this);
                var itemId = button.data('item-id');
                var icon = button.find('i');
                
                button.prop('disabled', true);
                button.tooltip('hide'); // Hide tooltip when clicked
                
                $.post('@Url.Action("ToggleWatchlist", "Buyer")', {
                    itemId: itemId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                }).done(function(response) {
                    if (response.success) {
                        if (response.isInWatchlist) {
                            icon.removeClass('far fa-heart').addClass('fas fa-heart text-danger animate__animated animate__heartBeat');
                            button.attr('title', 'Remove from Watchlist');
                            showNotification('Item added to your watchlist!', 'success');
                        } else {
                            icon.removeClass('fas fa-heart text-danger').addClass('far fa-heart animate__animated animate__bounceOut');
                            button.attr('title', 'Add to Watchlist');
                            showNotification('Item removed from your watchlist!', 'info');
                        }
                        setTimeout(() => icon.removeClass('animate__animated animate__heartBeat animate__bounceOut'), 1000); // Remove animation class after it plays
                    } else {
                        showNotification(response.message || 'An error occurred', 'error');
                    }
                }).fail(function() {
                    showNotification('An error occurred. Please try again.', 'error');
                }).always(function() {
                    button.prop('disabled', false);
                    button.tooltip('enable'); // Re-enable tooltip
                });
            });
            
            // Check which items are already in watchlist on load
            $('.watchlist-btn').each(function() {
                var button = $(this);
                var itemId = button.data('item-id');
                
                $.get('@Url.Action("IsInWatchlist", "Buyer")', {
                    itemId: itemId
                }).done(function(response) {
                    if (response.isInWatchlist) {
                        button.find('i').removeClass('far fa-heart').addClass('fas fa-heart text-danger');
                        button.attr('title', 'Remove from Watchlist');
                    } else {
                        button.find('i').removeClass('fas fa-heart text-danger').addClass('far fa-heart');
                    }
                });
            });
        });
        
        // Show notification with custom animation
        function showNotification(message, type) {
            var alertClass = 'alert-info';
            var iconClass = 'bx bx-info-circle';
            if (type === 'success') { alertClass = 'alert-success'; iconClass = 'bx bx-check-circle'; }
            else if (type === 'error') { alertClass = 'alert-danger'; iconClass = 'bx bx-error-circle'; }
            
            var notification = $('<div class="alert ' + alertClass + ' alert-dismissible fade show position-fixed top-0 end-0 m-4 shadow animated slideInRight" style="z-index: 9999; min-width: 250px;">' +
                '<i class="' + iconClass + ' me-2"></i>' + message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                '</div>');
            
            $('body').append(notification);
            
            setTimeout(function() {
                notification.removeClass('slideInRight').addClass('slideOutRight');
                notification.one('animationend', function() {
                    notification.remove();
                });
            }, 3000);
        }
        
        // Update all auction timers
        function updateAllTimers() {
            document.querySelectorAll('.auction-timer').forEach(timer => {
                const endTime = new Date(timer.getAttribute('data-end-time'));
                const now = new Date();
                const timeLeft = endTime - now;
                
                timer.classList.remove('text-danger', 'text-warning', 'animate__flash'); // Reset classes

                if (timeLeft <= 0) {
                    timer.innerHTML = '<span class="text-danger fw-bold animate__animated animate__tada">Ended</span>';
                    timer.closest('.auction-card').classList.add('opacity-75', 'bg-light');
                    timer.closest('.auction-card').querySelector('.btn-success')?.classList.add('disabled'); // Disable bid button
                    return;
                }

                const days = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
                const hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

                let display = '';
                if (days > 0) display += `${days}d `;
                display += `${String(hours).padStart(2, '0')}h ${String(minutes).padStart(2, '0')}m ${String(seconds).padStart(2, '0')}s`;

                timer.textContent = display;
                
                // Add urgency styling for auctions ending soon
                if (timeLeft < 3600000) { // Less than 1 hour
                    timer.classList.add('text-danger', 'animate__animated', 'animate__flash', 'animate__infinite');
                } else if (timeLeft < 86400000) { // Less than 24 hours
                    timer.classList.add('text-warning');
                } else {
                    timer.classList.add('text-primary'); // Default blue for active
                }
            });
        }

        // Update timers every second
        setInterval(updateAllTimers, 1000);
        
        // Initial update
        updateAllTimers();
    </script>
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <style>
       
:root {
    --walnut-brown: #5C4033;
    --golden-oak: #C19A6B;
    --royal-gold: #D4AF37;
    --steel-mist: #A2B0BF;
    --matte-charcoal: #2B2B2B;
    --text-light: #f8f9fa;
    --text-muted: #A2B0BF;
    --bg-dark: #000000;
    --card-bg: #1a1a1a;
    --border-color: rgba(196, 154, 107, 0.2);
    --shadow-luxury: 0 15px 45px rgba(0, 0, 0, 0.5);
    --shadow-hover: 0 20px 60px rgba(212, 175, 55, 0.15);
}

/* Global Styling */
body {
    background-color: var(--bg-dark) !important;
    color: var(--text-light);
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    line-height: 1.6;
}

.container {
    background-color: var(--bg-dark);
    min-height: 100vh;
    padding-top: 2rem;
    padding-bottom: 2rem;
}

/* Main Card Styling */
.card {
    background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
    border: 1px solid var(--border-color);
    border-radius: 20px;
    box-shadow: var(--shadow-luxury);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    position: relative;
}

.card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--royal-gold), var(--golden-oak), var(--walnut-brown));
    z-index: 1;
}

.card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-hover);
    border-color: var(--golden-oak);
}

/* Card Header Styling */
.card-header {
    background: linear-gradient(135deg, var(--walnut-brown) 0%, var(--matte-charcoal) 35%, var(--golden-oak) 70%, var(--royal-gold) 100%);
    background-size: 400% 400%;
    animation: luxuryGradientShift 20s ease infinite;
    border: none;
    border-radius: 20px 20px 0 0 !important;
    padding: 1.5rem 2rem;
    position: relative;
    overflow: hidden;
}

.card-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: url('data:image/svg+xml;utf8,<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="4" fill="%23D4AF37" opacity="0.1"/><circle cx="80" cy="40" r="6" fill="%23C19A6B" opacity="0.1"/><circle cx="50" cy="80" r="5" fill="%23D4AF37" opacity="0.1"/></svg>') repeat;
    background-size: 120px;
    opacity: 0.4;
    animation: moveBubbles 25s linear infinite;
    z-index: 0;
}

.card-header h4 {
    color: var(--text-light);
    font-weight: 700;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    position: relative;
    z-index: 1;
    margin-bottom: 0;
    background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.card-body {
    background-color: transparent;
    padding: 2rem;
    position: relative;
    z-index: 1;
}

/* Auction Card Styling */
.auction-card {
    background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
    border: 1px solid var(--border-color);
    border-radius: 15px;
    box-shadow: var(--shadow-luxury);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    position: relative;
    height: 100%;
    opacity: 0;
    transform: translateY(30px);
    animation: luxuryFadeInCard 0.8s ease-out forwards;
}

.auction-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--royal-gold), var(--golden-oak));
    z-index: 1;
}

.auction-card:hover {
    transform: translateY(-12px);
    box-shadow: var(--shadow-hover);
    border-color: var(--golden-oak);
}

/* Staggered animations for auction cards */
.col-lg-4:nth-child(1) .auction-card { animation-delay: 0.1s; }
.col-lg-4:nth-child(2) .auction-card { animation-delay: 0.2s; }
.col-lg-4:nth-child(3) .auction-card { animation-delay: 0.3s; }
.col-lg-4:nth-child(4) .auction-card { animation-delay: 0.4s; }
.col-lg-4:nth-child(5) .auction-card { animation-delay: 0.5s; }
.col-lg-4:nth-child(6) .auction-card { animation-delay: 0.6s; }

/* Image Container */
.auction-image-container {
    height: 220px;
    overflow: hidden;
    border-bottom: 1px solid var(--border-color);
    position: relative;
}

.auction-image {
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.auction-card:hover .auction-image {
    transform: scale(1.05);
}

.auction-image.bg-light {
    background: linear-gradient(135deg, var(--matte-charcoal), var(--card-bg)) !important;
}

.auction-image i.text-muted {
    color: var(--steel-mist) !important;
}

/* Watchlist Button */
.watchlist-btn {
    background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    transition: all 0.3s ease;
    color: var(--matte-charcoal);
}

.watchlist-btn:hover {
    background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
    transform: scale(1.1);
    box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
    color: var(--text-light);
}

.watchlist-btn i {
    font-size: 1.2rem;
    transition: transform 0.3s ease;
}

.watchlist-btn:hover i {
    transform: scale(1.1);
}

/* Text Colors */
.text-primary {
    color: var(--royal-gold) !important;
    font-weight: 700;
}

.text-success {
    color: var(--royal-gold) !important;
    font-weight: 700;
}

.text-warning {
    color: var(--golden-oak) !important;
    font-weight: 700;
}

.text-danger {
    color: var(--walnut-brown) !important;
    font-weight: 700;
}

.text-info {
    color: var(--steel-mist) !important;
    font-weight: 600;
}

.text-muted {
    color: var(--steel-mist) !important;
}

/* Card Title */
.card-title {
    color: var(--text-light);
    font-weight: 600;
    transition: color 0.3s ease;
}

.auction-card:hover .card-title {
    color: var(--royal-gold);
}

/* Button Styling */
.btn {
    border-radius: 25px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: none;
    position: relative;
    overflow: hidden;
}

.btn-primary {
    background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
    color: var(--matte-charcoal);
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
}

.btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s;
}

.btn-primary:hover::before {
    left: 100%;
}

.btn-primary:hover {
    background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
    color: var(--text-light);
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
}

.btn-success {
    background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
    color: var(--text-light);
    box-shadow: 0 4px 15px rgba(92, 64, 51, 0.3);
}

.btn-success:hover {
    background: linear-gradient(135deg, var(--walnut-brown), var(--matte-charcoal));
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(92, 64, 51, 0.4);
}

.btn-outline-warning {
    background: transparent;
    color: var(--golden-oak);
    border: 2px solid var(--golden-oak);
}

.btn-outline-warning:hover {
    background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
    color: var(--text-light);
    border-color: var(--walnut-brown);
    transform: translateY(-3px);
}

.btn-outline-secondary {
    background: transparent;
    color: var(--steel-mist);
    border: 2px solid var(--steel-mist);
}

.btn-outline-secondary:hover {
    background: linear-gradient(135deg, var(--steel-mist), var(--golden-oak));
    color: var(--matte-charcoal);
    border-color: var(--golden-oak);
    transform: translateY(-3px);
}

.btn-outline-success {
    background: transparent;
    color: var(--royal-gold);
    border: 2px solid var(--royal-gold);
}

.btn-outline-success:hover {
    background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
    color: var(--matte-charcoal);
    border-color: var(--golden-oak);
    transform: translateY(-3px);
}

.btn-outline-primary {
    background: transparent;
    color: var(--royal-gold);
    border: 2px solid var(--royal-gold);
}

.btn-outline-primary:hover {
    background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
    color: var(--matte-charcoal);
    border-color: var(--golden-oak);
    transform: translateY(-3px);
}

.btn i {
    transition: transform 0.3s ease;
}

.btn:hover i {
    transform: scale(1.1);
}

/* Badge Styling */
.badge {
    border-radius: 15px;
    font-weight: 500;
    letter-spacing: 0.3px;
    padding: 0.5rem 1rem;
}

.badge-active, .bg-success {
    background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak)) !important;
    color: var(--matte-charcoal);
}

.badge-upcoming, .bg-warning {
    background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown)) !important;
    color: var(--text-light);
}

.badge-completed, .bg-secondary {
    background: linear-gradient(135deg, var(--steel-mist), var(--matte-charcoal)) !important;
    color: var(--text-light);
}

.bg-warning.text-dark {
    background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown)) !important;
    color: var(--text-light) !important;
}

/* Timer Styling */
.auction-timer {
    font-weight: 700;
    font-size: 1.1rem;
}

.auction-timer.text-danger {
    color: var(--walnut-brown) !important;
    animation-duration: 1s;
}

.auction-timer.text-warning {
    color: var(--golden-oak) !important;
}

.auction-timer.text-primary {
    color: var(--royal-gold) !important;
}

/* Border Top */
.border-top {
    border-top: 2px solid var(--border-color) !important;
}

/* Empty State */
.text-center.py-5 {
    background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
    border-radius: 20px;
    box-shadow: var(--shadow-luxury);
    border: 2px dashed var(--border-color);
    margin-top: 2rem;
}

.text-center.py-5 i {
    color: var(--royal-gold) !important;
}

.text-center.py-5 h5 {
    color: var(--royal-gold) !important;
}

.text-center.py-5 p {
    color: var(--steel-mist) !important;
}

/* Icons */
.bx {
    transition: all 0.3s ease;
