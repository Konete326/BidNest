@model BidNest.ViewModels.MyBidsViewModel
@{
    ViewData["Title"] = "My Bids";
}

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="bx bx-user"></i> My Bids
                    </h4>
                </div>

                <div class="card-body">
                    <!-- Summary Stats -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="fs-4 fw-bold text-primary">@Model.TotalBids</div>
                                <small class="text-muted">Total Bids</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="fs-4 fw-bold text-success">@Model.WinningCount</div>
                                <small class="text-muted">Currently Winning</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="fs-4 fw-bold text-warning">@Model.OutbidBids.Count</div>
                                <small class="text-muted">Outbid</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="fs-5 fw-bold text-info">$@Model.TotalBidAmount.ToString("N2")</div>
                                <small class="text-muted">Total Bid Amount</small>
                            </div>
                        </div>
                    </div>

                    <!-- Tabs for different bid categories -->
                    <ul class="nav nav-tabs" id="bidTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="all-bids-tab" data-bs-toggle="tab" data-bs-target="#all-bids" type="button" role="tab">
                                All Bids (@Model.TotalBids)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="winning-bids-tab" data-bs-toggle="tab" data-bs-target="#winning-bids" type="button" role="tab">
                                Winning (@Model.WinningCount)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="outbid-bids-tab" data-bs-toggle="tab" data-bs-target="#outbid-bids" type="button" role="tab">
                                Outbid (@Model.OutbidBids.Count)
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content mt-3" id="bidTabsContent">
                        <!-- All Bids Tab -->
                        <div class="tab-pane fade show active" id="all-bids" role="tabpanel">
                            @await Html.PartialAsync("_BidListPartial", Model.MyBids)
                        </div>

                        <!-- Winning Bids Tab -->
                        <div class="tab-pane fade" id="winning-bids" role="tabpanel">
                            @if (Model.WinningBids.Any())
                            {
                                @await Html.PartialAsync("_BidListPartial", Model.WinningBids)
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="bx bx-trophy display-1 text-muted"></i>
                                    <h5 class="mt-3 text-muted">No Winning Bids</h5>
                                    <p class="text-muted">You're not currently winning any auctions.</p>
                                    <a href="@Url.Action("Active")" class="btn btn-primary">
                                        <i class="bx bx-search"></i> Browse Active Auctions
                                    </a>
                                </div>
                            }
                        </div>

                        <!-- Outbid Bids Tab -->
                        <div class="tab-pane fade" id="outbid-bids" role="tabpanel">
                            @if (Model.OutbidBids.Any())
                            {
                                @await Html.PartialAsync("_BidListPartial", Model.OutbidBids)
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="bx bx-check-circle display-1 text-success"></i>
                                    <h5 class="mt-3 text-success">Great Job!</h5>
                                    <p class="text-muted">You haven't been outbid on any auctions yet.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="My bids pagination" class="mt-4">
                            <ul class="pagination justify-content-center">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("MyBids", new { page = Model.CurrentPage - 1 })">
                                            Previous
                                        </a>
                                    </li>
                                }

                                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("MyBids", new { page = i })">
                                            @i
                                        </a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("MyBids", new { page = Model.CurrentPage + 1 })">
                                            Next
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --walnut-brown: #5C4033;
            --golden-oak: #C19A6B;
            --royal-gold: #D4AF37;
            --steel-mist: #A2B0BF;
            --matte-charcoal: #2B2B2B;
            --text-light: #f8f9fa;
            --text-muted: #A2B0BF;
            --bg-dark: #000000;
            --card-bg: #1a1a1a;
            --border-color: rgba(196, 154, 107, 0.2);
            --shadow-luxury: 0 15px 45px rgba(0, 0, 0, 0.5);
            --shadow-hover: 0 20px 60px rgba(212, 175, 55, 0.15);
        }

        /* Global Styling */
        body {
            background-color: var(--bg-dark) !important;
            color: var(--text-light);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
        }

        .container {
            background-color: var(--bg-dark);
            min-height: 100vh;
            padding-top: 2rem;
            padding-bottom: 2rem;
        }

        /* Card Styling */
        .card {
            background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
            border: 1px solid var(--border-color);
            border-radius: 20px;
            box-shadow: var(--shadow-luxury);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
            position: relative;
            opacity: 0;
            transform: translateY(30px);
            animation: luxuryFadeInCard 0.8s ease-out forwards;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, var(--royal-gold), var(--golden-oak), var(--walnut-brown));
            z-index: 1;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-hover);
            border-color: var(--golden-oak);
        }

        /* Card Header Styling */
        .card-header {
            background: linear-gradient(135deg, var(--walnut-brown) 0%, var(--matte-charcoal) 35%, var(--golden-oak) 70%, var(--royal-gold) 100%);
            background-size: 400% 400%;
            animation: luxuryGradientShift 20s ease infinite;
            border: none;
            border-radius: 20px 20px 0 0 !important;
            padding: 1.5rem 2rem;
            position: relative;
            overflow: hidden;
        }

        .card-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('data:image/svg+xml;utf8,<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="4" fill="%23D4AF37" opacity="0.1"/><circle cx="80" cy="40" r="6" fill="%23C19A6B" opacity="0.1"/><circle cx="50" cy="80" r="5" fill="%23D4AF37" opacity="0.1"/></svg>') repeat;
            background-size: 120px;
            opacity: 0.4;
            animation: moveBubbles 25s linear infinite;
            z-index: 0;
        }

        .card-header h4 {
            color: var(--text-light);
            font-weight: 700;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
            position: relative;
            z-index: 1;
            margin-bottom: 0;
            background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .card-body {
            background-color: transparent;
            padding: 2rem;
            position: relative;
            z-index: 1;
        }

        /* Summary Stats Styling */
        .bg-light {
            background: linear-gradient(135deg, var(--matte-charcoal), var(--card-bg)) !important;
            border: 2px solid var(--border-color);
            border-radius: 15px;
            transition: all 0.3s ease;
            opacity: 0;
            transform: translateY(20px);
            animation: luxuryFadeInStats 0.6s ease-out forwards;
        }

        .bg-light:hover {
            border-color: var(--golden-oak);
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.2);
        }

        /* Staggered animations for stats */
        .col-md-3:nth-child(1) .bg-light { animation-delay: 0.1s; }
        .col-md-3:nth-child(2) .bg-light { animation-delay: 0.2s; }
        .col-md-3:nth-child(3) .bg-light { animation-delay: 0.3s; }
        .col-md-3:nth-child(4) .bg-light { animation-delay: 0.4s; }

        /* Text Colors */
        .text-primary {
            color: var(--royal-gold) !important;
            font-weight: 700;
        }

        .text-success {
            color: var(--royal-gold) !important;
            font-weight: 700;
        }

        .text-warning {
            color: var(--golden-oak) !important;
            font-weight: 700;
        }

        .text-danger {
            color: var(--walnut-brown) !important;
            font-weight: 700;
        }

        .text-info {
            color: var(--steel-mist) !important;
            font-weight: 600;
        }

        .text-muted {
            color: var(--steel-mist) !important;
        }

        /* Tab Navigation Styling */
        .nav-tabs {
            border-bottom: 2px solid var(--border-color);
            margin-bottom: 2rem;
        }

        .nav-tabs .nav-link {
            background: linear-gradient(135deg, var(--matte-charcoal), var(--card-bg));
            border: 2px solid var(--border-color);
            color: var(--text-light);
            border-radius: 15px 15px 0 0;
            margin-right: 0.5rem;
            padding: 1rem 1.5rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .nav-tabs .nav-link::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.1), transparent);
            transition: left 0.5s;
        }

        .nav-tabs .nav-link:hover::before {
            left: 100%;
        }

        .nav-tabs .nav-link:hover {
            background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
            color: var(--text-light);
            border-color: var(--golden-oak);
            transform: translateY(-3px);
        }

        .nav-tabs .nav-link.active {
            background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
            color: var(--matte-charcoal);
            border-color: var(--royal-gold);
            border-bottom-color: transparent;
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
        }

        .nav-tabs .nav-link.active:hover {
            background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
            color: var(--matte-charcoal);
            transform: translateY(-3px);
        }

        /* Tab Content Styling */
        .tab-content {
            background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
            border-radius: 0 15px 15px 15px;
            padding: 2rem;
            border: 2px solid var(--border-color);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .tab-pane {
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.4s ease;
        }

        .tab-pane.show.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* Button Styling */
        .btn {
            border-radius: 25px;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
            position: relative;
            overflow: hidden;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
            color: var(--matte-charcoal);
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
        }

        .btn-primary::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .btn-primary:hover::before {
            left: 100%;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, var(--golden-oak), var(--walnut-brown));
            color: var(--text-light);
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
        }

        .btn i {
            transition: transform 0.3s ease;
        }

        .btn:hover i {
            transform: scale(1.1);
        }

        /* Pagination Styling */
        .pagination {
            margin-bottom: 0;
        }

        .page-link {
            background: linear-gradient(135deg, var(--matte-charcoal), var(--card-bg));
            border: 1px solid var(--border-color);
            color: var(--text-light);
            padding: 0.75rem 1rem;
            margin: 0 0.25rem;
            border-radius: 10px;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .page-link:hover {
            background: linear-gradient(135deg, var(--golden-oak), var(--royal-gold));
            color: var(--matte-charcoal);
            border-color: var(--golden-oak);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
        }

        .page-item.active .page-link {
            background: linear-gradient(135deg, var(--royal-gold), var(--golden-oak));
            color: var(--matte-charcoal);
            border-color: var(--royal-gold);
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
        }

        /* Font Sizes */
        .fs-4 {
            font-size: 1.5rem !important;
            font-weight: 700;
        }

        .fs-5 {
            font-size: 1.25rem !important;
            font-weight: 600;
        }

        /* Strong Text */
        .fw-bold {
            color: var(--text-light);
            font-weight: 700;
        }

        /* Small Text */
        small {
            color: var(--steel-mist);
            font-size: 0.85rem;
        }

        /* Empty State */
        .text-center.py-5 {
            background: linear-gradient(145deg, var(--card-bg), var(--matte-charcoal));
            border-radius: 20px;
            box-shadow: var(--shadow-luxury);
            border: 2px dashed var(--border-color);
            margin-top: 2rem;
        }

        .text-center.py-5 i {
            color: var(--steel-mist) !important;
        }

        .text-center.py-5 h5 {
            color: var(--royal-gold) !important;
        }

        .text-center.py-5 p {
            color: var(--steel-mist) !important;
        }

        .text-center.py-5 h5.text-success {
            color: var(--royal-gold) !important;
        }

        .text-center.py-5 i.text-success {
            color: var(--royal-gold) !important;
        }

        /* Icons */
        .bx {
            transition: all 0.3s ease;
        }

        .btn:hover .bx {
            transform: scale(1.1);
        }

        /* Display Icons */
        .display-1 {
            font-size: 4rem;
            opacity: 0.7;
        }

        /* Animations */
        @@keyframes luxuryFadeInCard {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes luxuryFadeInStats {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes luxuryGradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        @@keyframes moveBubbles {
            from { background-position: 0 0; }
            to { background-position: 100% 100%; }
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .container {
                padding-top: 1rem;
                padding-bottom: 1rem;
            }
            
            .card-body {
                padding: 1.5rem;
            }
            
            .card-header {
                padding: 1rem 1.5rem;
            }
            
            .btn {
                width: 100%;
                margin-bottom: 0.5rem;
            }
            
            .nav-tabs .nav-link {
                padding: 0.75rem 1rem;
                margin-right: 0.25rem;
                font-size: 0.85rem;
            }
            
            .tab-content {
                padding: 1.5rem;
            }
        }

        @@media (max-width: 576px) {
            .card {
                border-radius: 15px;
                margin: 0 0.5rem;
            }
            
            .card-body {
                padding: 1rem;
            }
            
            .card-header {
                border-radius: 15px 15px 0 0 !important;
                padding: 1rem;
            }
            
            .nav-tabs .nav-link {
                padding: 0.5rem 0.75rem;
                font-size: 0.8rem;
                margin-right: 0.1rem;
            }
            
            .tab-content {
                padding: 1rem;
                border-radius: 0 10px 10px 10px;
            }
            
            .fs-4 {
                font-size: 1.2rem !important;
            }
            
            .fs-5 {
                font-size: 1rem !important;
            }
        }
    </style>
}
