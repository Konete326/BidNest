@model BidNest.ViewModels.MyBidsViewModel
@{
    ViewData["Title"] = "My Bids";
}

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="bx bx-user"></i> My Bids
                    </h4>
                </div>

                <div class="card-body">
                    <!-- Summary Stats -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="fs-4 fw-bold text-primary">@Model.TotalBids</div>
                                <small class="text-muted">Total Bids</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="fs-4 fw-bold text-success">@Model.WinningCount</div>
                                <small class="text-muted">Currently Winning</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="fs-4 fw-bold text-warning">@Model.OutbidBids.Count</div>
                                <small class="text-muted">Outbid</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="fs-5 fw-bold text-info">$@Model.TotalBidAmount.ToString("N2")</div>
                                <small class="text-muted">Total Bid Amount</small>
                            </div>
                        </div>
                    </div>

                    <!-- Tabs for different bid categories -->
                    <ul class="nav nav-tabs" id="bidTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="all-bids-tab" data-bs-toggle="tab" data-bs-target="#all-bids" type="button" role="tab">
                                All Bids (@Model.TotalBids)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="winning-bids-tab" data-bs-toggle="tab" data-bs-target="#winning-bids" type="button" role="tab">
                                Winning (@Model.WinningCount)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="outbid-bids-tab" data-bs-toggle="tab" data-bs-target="#outbid-bids" type="button" role="tab">
                                Outbid (@Model.OutbidBids.Count)
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content mt-3" id="bidTabsContent">
                        <!-- All Bids Tab -->
                        <div class="tab-pane fade show active" id="all-bids" role="tabpanel">
                            @await Html.PartialAsync("_BidListPartial", Model.MyBids)
                        </div>

                        <!-- Winning Bids Tab -->
                        <div class="tab-pane fade" id="winning-bids" role="tabpanel">
                            @if (Model.WinningBids.Any())
                            {
                                @await Html.PartialAsync("_BidListPartial", Model.WinningBids)
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="bx bx-trophy display-1 text-muted"></i>
                                    <h5 class="mt-3 text-muted">No Winning Bids</h5>
                                    <p class="text-muted">You're not currently winning any auctions.</p>
                                    <a href="@Url.Action("Active")" class="btn btn-primary">
                                        <i class="bx bx-search"></i> Browse Active Auctions
                                    </a>
                                </div>
                            }
                        </div>

                        <!-- Outbid Bids Tab -->
                        <div class="tab-pane fade" id="outbid-bids" role="tabpanel">
                            @if (Model.OutbidBids.Any())
                            {
                                @await Html.PartialAsync("_BidListPartial", Model.OutbidBids)
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="bx bx-check-circle display-1 text-success"></i>
                                    <h5 class="mt-3 text-success">Great Job!</h5>
                                    <p class="text-muted">You haven't been outbid on any auctions yet.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="My bids pagination" class="mt-4">
                            <ul class="pagination justify-content-center">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("MyBids", new { page = Model.CurrentPage - 1 })">
                                            Previous
                                        </a>
                                    </li>
                                }

                                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("MyBids", new { page = i })">
                                            @i
                                        </a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("MyBids", new { page = Model.CurrentPage + 1 })">
                                            Next
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
