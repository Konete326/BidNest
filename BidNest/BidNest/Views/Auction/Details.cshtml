@model BidNest.ViewModels.ItemViewModel
@{
    ViewData["Title"] = Model.Name;
    var auctionStatus = ViewBag.AuctionStatus as BidNest.ViewModels.AuctionStatusViewModel;
    var bidHistory = ViewBag.BidHistory as BidNest.ViewModels.BidHistoryViewModel;
}

<div class="container-fluid py-4">
    <div class="row">
        
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body p-0">
                    @if (Model.Images.Any())
                    {
                        <div id="itemCarousel" class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                @for (int i = 0; i < Model.Images.Count; i++)
                                {
                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <img src="@Model.Images[i].ImagePath" class="d-block w-100" 
                                             style="height: 400px; object-fit: cover;" alt="@Model.Name">
                                    </div>
                                }
                            </div>
                            @if (Model.Images.Count > 1)
                            {
                                <button class="carousel-control-prev" type="button" data-bs-target="#itemCarousel" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon"></span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#itemCarousel" data-bs-slide="next">
                                    <span class="carousel-control-next-icon"></span>
                                </button>
                            }
                        </div>
                        
                        
                        @if (Model.Images.Count > 1)
                        {
                            <div class="p-3">
                                <div class="row g-2">
                                    @for (int i = 0; i < Model.Images.Count; i++)
                                    {
                                        <div class="col-2">
                                            <img src="@Model.Images[i].ImagePath" class="img-fluid rounded cursor-pointer thumbnail-img" 
                                                 data-bs-target="#itemCarousel" data-bs-slide-to="@i" 
                                                 style="height: 60px; object-fit: cover;" alt="Thumbnail">
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-light" style="height: 400px;">
                            <i class="fas fa-image fa-5x text-muted"></i>
                        </div>
                    }
                </div>
            </div>
        </div>

       
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="card-title mb-0 d-inline">@Model.Name</h3>
                            <span class="badge @(auctionStatus?.StatusBadgeClass ?? "bg-secondary") fs-6 ms-2">
                                @(auctionStatus?.StatusDisplay ?? "Unknown")
                            </span>
                        </div>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button class="btn btn-outline-danger" id="watchlist-btn" data-item-id="@Model.ItemId" title="Add to Watchlist">
                                <i class="fas fa-heart" id="watchlist-icon"></i>
                                <span id="watchlist-text">Add to Watchlist</span>
                            </button>
                        }
                    </div>
                </div>
                <div class="card-body">
                    
                    @if (auctionStatus?.IsActive == true)
                    {
                        <div class="alert alert-info mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-clock"></i> Time Remaining:</span>
                                <span class="fw-bold fs-5" id="auction-timer">@auctionStatus.TimeRemainingDisplay</span>
                            </div>
                        </div>
                    }
                    else if (auctionStatus?.IsEnded == true)
                    {
                        <div class="alert alert-warning mb-4">
                            <i class="fas fa-flag-checkered"></i> This auction has ended
                        </div>
                    }


                    <!-- Seller Actions -->
                    @if (User.Identity?.IsAuthenticated == true && Model.SellerId.ToString() == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                    {
                        <div class="alert alert-secondary mb-4">
                            <h6><i class="fas fa-user-tie"></i> Seller Actions</h6>
                            <div class="btn-group">
                                <a href="@Url.Action("Edit", "Seller", new { id = Model.ItemId })" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-edit"></i> Edit Item
                                </a>
                                @if (auctionStatus?.IsEnded == true || auctionStatus?.IsActive == false)
                                {
                                    <form method="post" action="@Url.Action("ExtendAuction", "Seller", new { id = Model.ItemId })" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="hours" value="24" />
                                        <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('Extend this auction by 24 hours?')">
                                            <i class="fas fa-clock"></i> Extend 24h
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }

                   
                    <div class="row mb-4">
                        <div class="col-6">
                            <div class="text-center p-3 bg-light rounded">
                                <small class="text-muted">Current Bid</small>
                                <div class="fs-4 fw-bold text-success" id="current-bid">
                                    @if (auctionStatus?.CurrentHighestBid.HasValue == true)
                                    {
                                        <span>$@auctionStatus.CurrentHighestBid.Value.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No bids yet</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(auctionStatus?.CurrentWinnerName))
                                {
                                    <small class="text-muted">by @auctionStatus.CurrentWinnerName</small>
                                }
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center p-3 bg-light rounded">
                                <small class="text-muted">Total Bids</small>
                                <div class="fs-4 fw-bold" id="total-bids">@(auctionStatus?.TotalBids ?? 0)</div>
                            </div>
                        </div>
                    </div>

                    <!-- Bidding Section -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @Html.AntiForgeryToken()
                        @if (auctionStatus?.IsActive == true)
                        {
                            <div class="card bg-primary bg-opacity-10 mb-4">
                                <div class="card-body">
                                    <h5 class="card-title">Place Your Bid</h5>
                                    <div class="mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input type="number" id="quick-bid-amount" class="form-control" 
                                                   step="0.01" min="0" placeholder="Enter bid amount">
                                        </div>
                                        <div class="form-text">
                                            Minimum bid: $<span id="next-minimum">@((auctionStatus?.CurrentHighestBid ?? Model.MinimumBid) + 1)</span>
                                        </div>
                                    </div>

                                    <!-- Quick Bid Buttons -->
                                    <div class="mb-3">
                                        <small class="text-muted">Quick bids:</small>
                                        <div class="btn-group-sm d-block" id="quick-bids">
                                            <!-- Will be populated by JavaScript -->
                                        </div>
                                    </div>

                                    <button type="button" class="btn btn-primary btn-lg w-100" id="open-bid-modal-btn">
                                        <i class="fas fa-gavel"></i> Place Bid
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <h6>Auction Status</h6>
                                @if (auctionStatus == null)
                                {
                                    <p>Unable to load auction status.</p>
                                }
                                else if (auctionStatus.IsActive == false)
                                {
                                    <p>This auction has ended.</p>
                                }
                                else
                                {
                                    <p>Auction is not currently active.</p>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <h6>Login Required</h6>
                            <p>You must be logged in to place bids on this auction.</p>
                            <a href="@Url.Action("Login", "Account")" class="btn btn-primary">Login to Bid</a>
                        </div>
                    }

                    <!-- Item Details -->
                    <div class="mb-4">
                        <h5>Description</h5>
                        <p>@Model.Description</p>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <strong>Category:</strong><br>
                            <span class="badge bg-info">@(Model.CategoryName ?? "Uncategorized")</span>
                        </div>
                        <div class="col-6">
                            <strong>Seller:</strong><br>
                            @Model.SellerName
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bid History -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Bid History</h5>
                    <a href="@Url.Action("History", new { id = Model.ItemId })" class="btn btn-outline-primary btn-sm">
                        View All
                    </a>
                </div>
                <div class="card-body">
                    <div id="bid-history">
                        @if (bidHistory?.Bids.Any() == true)
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Bidder</th>
                                            <th>Amount</th>
                                            <th>Time</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var bid in bidHistory.Bids.Take(10))
                                        {
                                            <tr class="@(bid.IsWinning ? "table-success" : "")">
                                                <td>@bid.BidderName</td>
                                                <td class="fw-bold">$@bid.Amount.ToString("N2")</td>
                                                <td>@bid.TimeAgo</td>
                                                <td>
                                                    @if (bid.IsWinning)
                                                    {
                                                        <span class="badge bg-success">Winning</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Outbid</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-gavel fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No bids yet. Be the first to bid!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bid Confirmation Modal -->
<div class="modal fade" id="bidModal" tabindex="-1" aria-labelledby="bidModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="bidModalLabel">
                    <i class="fas fa-gavel me-2"></i>Confirm Your Bid
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-4">
                    <div class="auction-item-info">
                        <h6 class="fw-bold">@Model.Name</h6>
                        <small class="text-muted">Item #@Model.ItemId</small>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <div class="text-center p-2 bg-light rounded">
                            <small class="text-muted">Current Bid</small>
                            <div class="fw-bold text-success" id="modal-current-bid">
                                @if (auctionStatus?.CurrentHighestBid.HasValue == true)
                                {
                                    <span>$@auctionStatus.CurrentHighestBid.Value.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted">No bids yet</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-center p-2 bg-light rounded">
                            <small class="text-muted">Your Bid</small>
                            <div class="fw-bold text-primary fs-5" id="modal-your-bid">$0.00</div>
                        </div>
                    </div>
                </div>

                <form id="modal-bid-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="itemId" value="@Model.ItemId">
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Bid Amount</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text">$</span>
                            <input type="number" name="bidAmount" id="modal-bid-amount" class="form-control" 
                                   step="0.01" min="0" required>
                        </div>
                        <div class="form-text">
                            Minimum bid: $<span id="modal-next-minimum">@((auctionStatus?.CurrentHighestBid ?? Model.MinimumBid) + 1)</span>
                        </div>
                        <div id="bid-validation-message" class="text-danger mt-1" style="display: none;"></div>
                    </div>

                    <!-- Quick Bid Suggestions in Modal -->
                    <div class="mb-3">
                        <label class="form-label">Quick Suggestions:</label>
                        <div class="d-flex flex-wrap gap-1" id="modal-quick-bids">
                            <!-- Will be populated by JavaScript -->
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <small>
                            <i class="fas fa-info-circle me-1"></i>
                            Your bid is binding and cannot be retracted once placed.
                        </small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-lg" id="confirm-bid-btn">
                    <i class="fas fa-gavel me-1"></i>
                    <span id="confirm-bid-text">Place Bid</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="successModalLabel">
                    <i class="fas fa-check-circle me-2"></i>Bid Successful!
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-3">
                    <i class="fas fa-trophy text-warning" style="font-size: 3rem;"></i>
                </div>
                <h6 class="fw-bold">Congratulations!</h6>
                <p id="success-message" class="mb-3">Your bid has been placed successfully!</p>
                <div class="alert alert-success">
                    <div class="row">
                        <div class="col-6">
                            <small class="text-muted">Your Bid</small>
                            <div class="fw-bold" id="success-bid-amount">$0.00</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Status</small>
                            <div class="fw-bold text-success">
                                <i class="fas fa-crown me-1"></i>Winning
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">Great!</button>
            </div>
        </div>
    </div>
</div>

<!-- Error Modal -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="errorModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Bid Error
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-3">
                    <i class="fas fa-times-circle text-danger" style="font-size: 3rem;"></i>
                </div>
                <h6 class="fw-bold">Bid Not Placed</h6>
                <p id="error-message" class="mb-3 text-danger">There was an error with your bid.</p>
                <div class="alert alert-warning">
                    <small>
                        <i class="fas fa-lightbulb me-1"></i>
                        Please check the minimum bid amount and try again.
                    </small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" onclick="$('#bidModal').modal('show')">Try Again</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM Content Loaded - Initializing auction page...');
            
            // SignalR connection for real-time updates
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/auctionHub")
                .build();

            const itemId = @Model.ItemId;
            let auctionEndTime = new Date('@auctionStatus?.EndTime.ToString("yyyy-MM-ddTHH:mm:ssZ")');

        // Start SignalR connection
        connection.start().then(function () {
            // Join this auction's group
            connection.invoke("JoinAuction", itemId);
        }).catch(function (err) {
            console.error("SignalR connection error:", err);
        });

        // Handle real-time bid updates
        connection.on("BidPlaced", function (bid) {
            updateBidDisplay(bid);
            addBidToHistory(bid);
            updateQuickBids();
        });

        // Update bid display
        function updateBidDisplay(bid) {
            $('#current-bid').html('$' + bid.amount.toFixed(2));
            $('#total-bids').text(bid.totalBids || '1');
            currentMinimumBid = bid.amount + 1;
            $('#next-minimum').text(currentMinimumBid.toFixed(2));
        }

        // Add bid to history
        function addBidToHistory(bid) {
            // Implementation for bid history if needed
        }

        // Update quick bid buttons
        function updateQuickBids() {
            const container = document.getElementById('quick-bids');
            if (container) {
                container.innerHTML = '';
                const increments = [5, 10, 25, 50];
                increments.forEach(inc => {
                    const amount = currentMinimumBid + inc;
                    const btn = document.createElement('button');
                    btn.className = 'btn btn-outline-primary btn-sm me-2 mb-2 quick-bid-btn';
                    btn.setAttribute('data-amount', amount);
                    btn.textContent = '$' + amount.toFixed(2);
                    container.appendChild(btn);
                });
            }
        }

        // Initialize quick bids on page load
        updateQuickBids();

        // Show notification function
        function showNotification(message, type) {
            var alertClass = 'alert-info';
            if (type === 'success') alertClass = 'alert-success';
            else if (type === 'error') alertClass = 'alert-danger';
            
            var notification = $('<div class="alert ' + alertClass + ' alert-dismissible fade show position-fixed top-0 end-0 m-3" style="z-index: 9999;">' +
                '<i class="fas fa-info-circle me-2"></i>' + message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                '</div>');
            
            $('body').append(notification);
            
            setTimeout(function() {
                notification.fadeOut(function() {
                    notification.remove();
                });
            }, 3000);
        }

        // Watchlist functionality
        $('#watchlist-btn').click(function() {
            var button = $(this);
            var itemId = button.data('item-id');
            var icon = $('#watchlist-icon');
            var text = $('#watchlist-text');
            
            button.prop('disabled', true);
            
            $.post('@Url.Action("ToggleWatchlist", "Buyer")', {
                itemId: itemId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            }).done(function(response) {
                if (response.success) {
                    if (response.isInWatchlist) {
                        icon.removeClass('far').addClass('fas');
                        text.text('Remove from Watchlist');
                        button.removeClass('btn-outline-danger').addClass('btn-danger');
                        showNotification('Item added to your watchlist!', 'success');
                    } else {
                        icon.removeClass('fas').addClass('far');
                        text.text('Add to Watchlist');
                        button.removeClass('btn-danger').addClass('btn-outline-danger');
                        showNotification('Item removed from your watchlist!', 'info');
                    }
                } else {
                    showNotification(response.message || 'An error occurred', 'error');
                }
            }).fail(function() {
                showNotification('An error occurred. Please try again.', 'error');
            }).always(function() {
                button.prop('disabled', false);
            });
        });
        
        // Check if item is already in watchlist on page load
        $.get('@Url.Action("IsInWatchlist", "Buyer")', {
            itemId: @Model.ItemId
        }).done(function(response) {
            if (response.isInWatchlist) {
                $('#watchlist-icon').removeClass('far').addClass('fas');
                $('#watchlist-text').text('Remove from Watchlist');
                $('#watchlist-btn').removeClass('btn-outline-danger').addClass('btn-danger');
            }
        });

        connection.on("AuctionEnding", function (data) {
            showAuctionEndingAlert(data.TimeRemaining);
        });

        connection.on("AuctionEnded", function (data) {
            showAuctionEndedAlert(data.WinningBid);
        });

        // Show auction ending alert
        function showAuctionEndingAlert(timeRemaining) {
            showNotification('Auction ending soon! ' + timeRemaining + ' remaining', 'warning');
        }

        // Show auction ended alert
        function showAuctionEndedAlert(winningBid) {
            if (winningBid) {
                showNotification('Auction ended! Winning bid: $' + winningBid.toFixed(2), 'info');
            } else {
                showNotification('Auction ended!', 'info');
            }
            // Disable bidding
            $('#open-bid-modal-btn').prop('disabled', true);
            $('#quick-bid-amount').prop('disabled', true);
        }

        // Auction timer
        function updateTimer() {
            const now = new Date();
            const timeLeft = auctionEndTime - now;
            
            if (timeLeft <= 0) {
                document.getElementById('auction-timer').textContent = 'Auction Ended';
                return;
            }

            const days = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
            const hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

            let display = '';
            if (days > 0) display += `${days}d `;
            if (hours > 0) display += `${hours}h `;
            display += `${minutes}m ${seconds}s`;

            document.getElementById('auction-timer').textContent = display;
        }

       
        @if (auctionStatus?.IsActive == true)
        {
            <text>setInterval(updateTimer, 1000);</text>
        }

        // Modal functionality
        let currentMinimumBid = @((auctionStatus?.CurrentHighestBid ?? Model.MinimumBid) + 1);
        
        console.log('JavaScript loaded, looking for bid button...');
        const bidButton = document.getElementById('open-bid-modal-btn');
        console.log('Bid button element:', bidButton);
        
        // Open bid modal
        if (bidButton) {
            console.log('Adding click event listener to bid button');
            bidButton.addEventListener('click', function() {
            console.log('Place Bid button clicked!');
            
            const quickBidAmount = document.getElementById('quick-bid-amount').value;
            console.log('Quick bid amount:', quickBidAmount);
            
            if (quickBidAmount) {
                document.getElementById('modal-bid-amount').value = quickBidAmount;
                updateModalYourBid(parseFloat(quickBidAmount));
            }
            
            // Check if modal exists
            const modal = document.getElementById('bidModal');
            console.log('Modal element:', modal);
            
            if (modal) {
                // Try Bootstrap 5 syntax first
                if (typeof bootstrap !== 'undefined') {
                    console.log('Using Bootstrap 5');
                    const bsModal = new bootstrap.Modal(modal);
                    bsModal.show();
                } else if (typeof $ !== 'undefined' && $.fn.modal) {
                    console.log('Using Bootstrap 4/jQuery');
                    $('#bidModal').modal('show');
                } else {
                    console.error('Bootstrap modal not available');
                    alert('Modal system not loaded. Please refresh the page.');
                }
            } else {
                console.error('Modal element not found');
                alert('Modal not found. Please refresh the page.');
            }
            });
        } else {
            console.error('Bid button not found!');
        }

        // Quick bid buttons functionality
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('quick-bid-btn')) {
                const amount = parseFloat(e.target.getAttribute('data-amount'));
                document.getElementById('quick-bid-amount').value = amount.toFixed(2);
                document.getElementById('modal-bid-amount').value = amount.toFixed(2);
                updateModalYourBid(amount);
            }
        });

        // Modal quick bid buttons
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('modal-quick-bid-btn')) {
                const amount = parseFloat(e.target.getAttribute('data-amount'));
                document.getElementById('modal-bid-amount').value = amount.toFixed(2);
                updateModalYourBid(amount);
            }
        });

        // Update modal your bid display
        function updateModalYourBid(amount) {
            document.getElementById('modal-your-bid').textContent = `$${amount.toFixed(2)}`;
        }

        // Modal bid amount input change
        document.getElementById('modal-bid-amount')?.addEventListener('input', function() {
            const amount = parseFloat(this.value) || 0;
            updateModalYourBid(amount);
            
            // Validate bid amount
            const validationMsg = document.getElementById('bid-validation-message');
            if (amount < currentMinimumBid) {
                validationMsg.textContent = `Bid must be at least $${currentMinimumBid.toFixed(2)}`;
                validationMsg.style.display = 'block';
                document.getElementById('confirm-bid-btn').disabled = true;
            } else {
                validationMsg.style.display = 'none';
                document.getElementById('confirm-bid-btn').disabled = false;
            }
        });

        // Confirm bid button
        document.getElementById('confirm-bid-btn')?.addEventListener('click', function() {
            const bidAmount = parseFloat(document.getElementById('modal-bid-amount').value);
            
            if (bidAmount < currentMinimumBid) {
                return;
            }

            // Disable button and show loading
            this.disabled = true;
            document.getElementById('confirm-bid-text').innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Placing...';
            
            // Prepare form data
            const formData = new FormData();
            formData.append('itemId', @Model.ItemId);
            formData.append('bidAmount', bidAmount);
            
            // Add anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            formData.append('__RequestVerificationToken', token);
            
            // Place bid via AJAX
            fetch('/Auction/PlaceBidAjax', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                $('#bidModal').modal('hide');
                
                if (data.success) {
                    // Show success modal
                    document.getElementById('success-message').textContent = data.message;
                    document.getElementById('success-bid-amount').textContent = `$${data.bid.amount.toFixed(2)}`;
                    $('#successModal').modal('show');
                    
                    // Clear input fields
                    document.getElementById('quick-bid-amount').value = '';
                    document.getElementById('modal-bid-amount').value = '';
                    
                    // Update page data (will be handled by SignalR too)
                    updateBidDisplay(data.bid);
                } else {
                    // Show error modal
                    document.getElementById('error-message').textContent = data.message;
                    $('#errorModal').modal('show');
                }
            })
            .catch(error => {
                $('#bidModal').modal('hide');
                document.getElementById('error-message').textContent = 'An error occurred while placing your bid. Please try again.';
                $('#errorModal').modal('show');
                console.error('Error:', error);
            })
            .finally(() => {
                // Reset button
                document.getElementById('confirm-bid-btn').disabled = false;
                document.getElementById('confirm-bid-text').innerHTML = 'Place Bid';
            });
        });

        // Helper functions
        function updateBidDisplay(bid) {
            const newAmount = bid.amount.toFixed(2);
            const nextMinimum = (bid.amount + 1).toFixed(2);
            
            // Update main display
            document.getElementById('current-bid').innerHTML = `$${newAmount}`;
            document.getElementById('total-bids').textContent = parseInt(document.getElementById('total-bids').textContent) + 1;
            document.getElementById('next-minimum').textContent = nextMinimum;
            
            // Update modal display
            document.getElementById('modal-current-bid').innerHTML = `$${newAmount}`;
            document.getElementById('modal-next-minimum').textContent = nextMinimum;
            
            // Update current minimum bid variable
            currentMinimumBid = bid.amount + 1;
        }

        function addBidToHistory(bid) {
            // Add new bid to history table (implementation depends on current structure)
        }

        function updateQuickBids() {
            // Update quick bid buttons with new amounts
        }

        function showAlert(type, message) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.querySelector('.container-fluid').insertBefore(alertDiv, document.querySelector('.row'));
        }

        function showAuctionEndingAlert(timeRemaining) {
            showAlert('warning', `Auction ending soon! Only ${timeRemaining} remaining.`);
        }

        function showAuctionEndedAlert(winningBid) {
            const message = winningBid 
                ? `Auction ended! Winning bid: $${winningBid.amount.toFixed(2)} by ${winningBid.bidderName}`
                : 'Auction ended with no bids.';
            showAlert('info', message);
        }

        // Load quick bids on page load
        fetch(`/Auction/GetQuickBids?itemId=${itemId}`)
            .then(response => response.json())
            .then(data => {
                if (data.suggestions) {
                    // Main section quick bids
                    const quickBidsContainer = document.getElementById('quick-bids');
                    quickBidsContainer.innerHTML = '';
                    
                    // Modal quick bids
                    const modalQuickBidsContainer = document.getElementById('modal-quick-bids');
                    modalQuickBidsContainer.innerHTML = '';
                    
                    data.suggestions.forEach(amount => {
                        // Main section button
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'btn btn-outline-primary btn-sm me-1 mb-1 quick-bid-btn';
                        btn.textContent = `$${amount.toFixed(2)}`;
                        btn.setAttribute('data-amount', amount);
                        quickBidsContainer.appendChild(btn);
                        
                        // Modal button
                        const modalBtn = document.createElement('button');
                        modalBtn.type = 'button';
                        modalBtn.className = 'btn btn-outline-secondary btn-sm modal-quick-bid-btn';
                        modalBtn.textContent = `$${amount.toFixed(2)}`;
                        modalBtn.setAttribute('data-amount', amount);
                        modalQuickBidsContainer.appendChild(modalBtn);
                    });
                    
                    // Update current minimum bid
                    currentMinimumBid = data.nextMinimum || currentMinimumBid;
                    document.getElementById('next-minimum').textContent = currentMinimumBid.toFixed(2);
                    document.getElementById('modal-next-minimum').textContent = currentMinimumBid.toFixed(2);
                }
            });
        }); // End DOMContentLoaded
    </script>
}

